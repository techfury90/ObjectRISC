#!/usr/bin/env python3
"""oriscrun — launch a multi-process Object RISC system.

Spawns:
    1. one oriscbar (the crossbar process)
    2. zero or more device processes (currently: oriscterm)
    3. one or more simorisc CPU processes connected to the crossbar

Waits for the "leader" CPU (default: pid 0) to exit, then signals every
other process to shut down. Forwards each process's stdout/stderr to
this script's stdout/stderr with a small per-source prefix so it's
clear what came from where.

Typical usage (the hello-world-on-terminal demo):

    tools/oriscrun \\
        --terminal pid=16 \\
        --cpu pid=0:program=examples/hello_terminal.orx,service=16=1@9

The --cpu spec is `pid=N:program=PATH[,service=SPEC[,service=SPEC...]][,serve]`
where each `service=` becomes a `--service PID=INDEX@CAPS` argument
passed through to simorisc, installing a synthesized remote reference
into the next available `O5..O15` slot.
"""

import argparse
import os
import select
import signal
import subprocess
import sys
import tempfile
import threading
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
ORISCBAR  = ROOT / "tools" / "sim"     / "oriscbar"
SIMORISC  = ROOT / "tools" / "sim"     / "simorisc"
ORISCTERM = ROOT / "tools" / "devices" / "oriscterm"
HOSTFSD   = ROOT / "tools" / "devices" / "hostfsd"
LINKBOOTD = ROOT / "tools" / "devices" / "linkbootd"
ORISCDIR  = ROOT / "tools" / "devices" / "oriscdir"


def parse_cpu_spec(spec: str) -> dict:
    """Parse 'pid=N:program=PATH[,service=SPEC...][,serve][,reset]' into a dict.
    `reset` adds --reset-on-exit; useful for spare-CPU pool slots that
    re-run their loader after each guest exits."""
    if ":" not in spec:
        raise SystemExit(f"oriscrun: bad --cpu spec: {spec!r} (missing ':')")
    head, rest = spec.split(":", 1)
    if not head.startswith("pid="):
        raise SystemExit(f"oriscrun: --cpu must start with pid=N, got {spec!r}")
    out = {"pid": int(head[len("pid="):]), "program": None,
           "services": [], "serve": False, "reset": False,
           "init_r4": 0, "display": "none"}
    for part in rest.split(","):
        part = part.strip()
        if not part:
            continue
        if part.startswith("program="):
            out["program"] = part[len("program="):]
        elif part.startswith("service="):
            out["services"].append(part[len("service="):])
        elif part.startswith("init-r4="):
            out["init_r4"] = int(part[len("init-r4="):])
        elif part.startswith("display="):
            v = part[len("display="):]
            if v not in ("none", "tk"):
                raise SystemExit(f"oriscrun: bad display value {v!r} "
                                 f"(want none|tk)")
            out["display"] = v
        elif part == "serve":
            out["serve"] = True
        elif part == "reset":
            out["reset"] = True
        else:
            raise SystemExit(f"oriscrun: unknown --cpu field {part!r}")
    if out["program"] is None:
        raise SystemExit(f"oriscrun: --cpu spec missing program=PATH: {spec!r}")
    return out


def parse_terminal_spec(spec: str) -> dict:
    """Parse 'pid=N[,instance=I][,verbose]' into a dict. `verbose` opts
    the device into its `-v` flag; without it the launcher's combined
    log stays quiet during normal use. `instance` is the per-terminal
    index used for /sys/term/<instance>/{console,keyboard,grid} self-
    registration (Phase 47); defaults to 0 for the first terminal."""
    out = {"pid": None, "instance": 0, "verbose": False}
    for part in spec.split(","):
        part = part.strip()
        if not part:
            continue
        if part.startswith("pid="):
            out["pid"] = int(part[len("pid="):])
        elif part.startswith("instance="):
            out["instance"] = int(part[len("instance="):])
        elif part == "verbose":
            out["verbose"] = True
        else:
            raise SystemExit(f"oriscrun: unknown --terminal field {part!r}")
    if out["pid"] is None:
        raise SystemExit(f"oriscrun: --terminal spec missing pid=N: {spec!r}")
    return out


def parse_directory_spec(spec: str) -> dict:
    """Parse 'pid=N[,config=PATH][,verbose]' into a dict. Phase 45f /
    Phase 55.

    `config` defaults to tools/devices/oriscdir.default.conf — the
    canonical mount layout (/programs → /sys/hostfsd/0).  Without it
    the directory comes up empty, vfs_open("/programs/...") returns
    -1, and the supervisor's sysinit / login spawns fail with
    `failed to spawn ... -1`.  Pass `config=none` to launch a
    configless oriscdir explicitly (test harnesses that prefer to
    inject mounts at runtime tend to invoke oriscdir directly rather
    than going through oriscrun, but the field is here for symmetry)."""
    out = {"pid": None, "config": None, "verbose": False}
    for part in spec.split(","):
        part = part.strip()
        if not part:
            continue
        if part.startswith("pid="):
            out["pid"] = int(part[len("pid="):])
        elif part.startswith("config="):
            out["config"] = part[len("config="):]
        elif part == "verbose":
            out["verbose"] = True
        else:
            raise SystemExit(f"oriscrun: unknown --directory field {part!r}")
    if out["pid"] is None:
        raise SystemExit(f"oriscrun: --directory spec missing pid=N: {spec!r}")
    if out["config"] is None:
        # Default: the canonical mount file ships in-tree.  Resolve
        # relative to the repo root so callers don't have to.
        default_cfg = ROOT / "tools" / "devices" / "oriscdir.default.conf"
        out["config"] = str(default_cfg) if default_cfg.exists() else "none"
    return out


def parse_hostfsd_spec(spec: str) -> dict:
    """Parse 'pid=N[,root=PATH][,instance=I][,verbose]' into a dict.
    `instance` is the per-hostfsd index used for /sys/hostfsd/<instance>
    self-registration (Phase 47); defaults to 0."""
    out = {"pid": None, "root": None, "instance": 0, "verbose": False}
    for part in spec.split(","):
        part = part.strip()
        if not part:
            continue
        if part.startswith("pid="):
            out["pid"] = int(part[len("pid="):])
        elif part.startswith("root="):
            out["root"] = part[len("root="):]
        elif part.startswith("instance="):
            out["instance"] = int(part[len("instance="):])
        elif part == "verbose":
            out["verbose"] = True
        else:
            raise SystemExit(f"oriscrun: unknown --hostfsd field {part!r}")
    if out["pid"] is None:
        raise SystemExit(f"oriscrun: --hostfsd spec missing pid=N: {spec!r}")
    return out


def parse_linkbootd_spec(spec: str) -> dict:
    """Parse 'pid=N[,shells=PIDS][,loaders=PIDS][,image=PATH][,root=PATH]
       [,verbose]'."""
    out = {"pid": None, "shells": "", "loaders": "",
           "image": None, "root": None, "verbose": False}
    for part in spec.split(","):
        part = part.strip()
        if not part:
            continue
        if part.startswith("pid="):
            out["pid"] = int(part[len("pid="):])
        elif part.startswith("shells="):
            # Use ';' as separator inside the spec since ',' is the
            # outer field separator. e.g. 'shells=0;2'.
            out["shells"] = part[len("shells="):].replace(";", ",")
        elif part.startswith("loaders="):
            out["loaders"] = part[len("loaders="):].replace(";", ",")
        elif part.startswith("image="):
            out["image"] = part[len("image="):]
        elif part.startswith("root="):
            out["root"] = part[len("root="):]
        elif part == "verbose":
            out["verbose"] = True
        else:
            raise SystemExit(f"oriscrun: unknown --linkbootd field {part!r}")
    if out["pid"] is None:
        raise SystemExit(f"oriscrun: --linkbootd spec missing pid=N: {spec!r}")
    return out


# ---------------------------------------------------------------------------
# Pipe-line forwarder: tag each child's output with a [name] prefix.
# ---------------------------------------------------------------------------

def _forward(name: str, stream, target):
    try:
        for line in iter(stream.readline, b''):
            try:
                text = line.decode("utf-8", errors="replace")
            except Exception:
                text = repr(line)
            target.write(f"[{name}] {text}")
            target.flush()
    except Exception:
        pass


def _attach_forwarders(name: str, proc: subprocess.Popen):
    threading.Thread(target=_forward,
                     args=(name, proc.stdout, sys.stdout),
                     daemon=True).start()
    threading.Thread(target=_forward,
                     args=(name, proc.stderr, sys.stderr),
                     daemon=True).start()


def main(argv) -> int:
    ap = argparse.ArgumentParser(prog="oriscrun",
        description="Launch a multi-process Object RISC system "
                    "(crossbar + devices + CPUs)")
    ap.add_argument("--socket", default=None,
                    help="UNIX socket path the crossbar listens on. "
                         "Default: a tempfile-based path.")
    ap.add_argument("--terminal", action="append", default=[],
                    metavar="pid=N",
                    help="spawn an oriscterm at the given pid")
    ap.add_argument("--hostfsd", action="append", default=[],
                    metavar="pid=N[,root=PATH]",
                    help="spawn a hostfsd at the given pid; "
                         "optional root=PATH jails the service")
    ap.add_argument("--linkbootd", action="append", default=[],
                    metavar="pid=N[,shells=A;B][,loaders=C;D][,image=PATH]",
                    help="spawn a linkbootd at the given pid. shells= "
                         "and loaders= take semicolon-separated PID lists "
                         "(PIDs that may issue spawn requests, and PIDs "
                         "in the chunkboot loader pool, respectively). "
                         "image=PATH preloads a single boot image (legacy)")
    ap.add_argument("--directory", action="append", default=[],
                    metavar="pid=N[,config=PATH]",
                    help="spawn an oriscdir at the given pid (Phase 45f). "
                         "The directory daemon hosts a hierarchical "
                         "name → ref tree; CPUs find it via boot O8 "
                         "wired to its primary mailbox at idx=1.  By "
                         "default oriscdir loads the canonical mount "
                         "config from tools/devices/oriscdir.default.conf "
                         "(/programs → /sys/hostfsd/0); pass "
                         "config=PATH to use a different file or "
                         "config=none to launch without one (Phase 55).")
    ap.add_argument("--cpu", action="append", default=[], required=True,
                    metavar="SPEC",
                    help="spawn a simorisc CPU; SPEC is "
                         "pid=N:program=PATH[,service=SPEC...][,serve]")
    ap.add_argument("--leader", type=int, default=0,
                    help="when this CPU exits, all other processes are "
                         "shut down (default: pid 0)")
    ap.add_argument("--leader-timeout", type=float, default=30.0,
                    help="kill everything if the leader hasn't exited "
                         "after this many seconds (default 30)")
    ap.add_argument("--linger", type=float, default=0.4,
                    help="seconds to wait after the leader exits before "
                         "shutting devices/crossbar down (default 0.4); "
                         "useful with GUI devices so you can see the "
                         "result before the window closes")
    args = ap.parse_args(argv)

    cpu_specs = [parse_cpu_spec(s) for s in args.cpu]
    term_specs = [parse_terminal_spec(s) for s in args.terminal]
    hf_specs   = [parse_hostfsd_spec(s) for s in args.hostfsd]
    lb_specs   = [parse_linkbootd_spec(s) for s in args.linkbootd]
    dir_specs  = [parse_directory_spec(s) for s in args.directory]
    if not any(c["pid"] == args.leader for c in cpu_specs):
        sys.exit(f"oriscrun: --leader pid {args.leader} has no matching --cpu")

    if args.socket is None:
        args.socket = tempfile.mktemp(prefix="oriscbar-", suffix=".sock")
    sock_path = args.socket

    procs = []   # list of (name, Popen)

    def cleanup_and_exit(rc: int) -> int:
        # Tear down: SIGTERM everything in parallel, give the whole
        # group ~2s to exit, then SIGKILL stragglers in parallel.
        # Parallel rather than per-process serial — under Phase 60
        # we have multiple long-running display CPUs (oriscwm with
        # --display tk) that don't always respond instantly to
        # SIGTERM (Tcl/Tk's runloop on macOS can sit on signals
        # briefly), and per-process 2s timeouts compound to >10s
        # total when the user just wants `exit` to mean exit.
        for name, p in reversed(procs):
            if p.poll() is None:
                try:
                    p.terminate()
                except ProcessLookupError:
                    pass
        deadline = time.time() + 2.0
        for name, p in reversed(procs):
            remaining = max(0.0, deadline - time.time())
            try:
                p.wait(timeout=remaining)
            except subprocess.TimeoutExpired:
                pass
        for name, p in reversed(procs):
            if p.poll() is None:
                try:
                    p.kill()
                except ProcessLookupError:
                    pass
        for name, p in reversed(procs):
            try:
                p.wait(timeout=1.0)
            except subprocess.TimeoutExpired:
                pass
        try:
            os.unlink(sock_path)
        except FileNotFoundError:
            pass
        return rc

    # ---- 1. Spawn the crossbar -------------------------------------------
    bar = subprocess.Popen(
        [sys.executable, str(ORISCBAR), "--socket", sock_path],
        stdout=subprocess.PIPE, stderr=subprocess.PIPE,
    )
    procs.append(("xbar", bar))
    # Wait for "READY" line on stdout (with timeout).
    deadline = time.time() + 5.0
    ready_line = b''
    while time.time() < deadline:
        rd, _, _ = select.select([bar.stdout], [], [], 0.1)
        if bar.stdout in rd:
            ready_line = bar.stdout.readline()
            if b"READY" in ready_line:
                break
    if b"READY" not in ready_line:
        sys.stderr.write("oriscrun: crossbar failed to start (no READY)\n")
        return cleanup_and_exit(1)
    sys.stdout.write(f"[xbar] {ready_line.decode('utf-8', errors='replace')}")
    _attach_forwarders("xbar", bar)

    # ---- 2. Spawn devices -------------------------------------------------
    #
    # Phase 47 launch ordering: oriscdir FIRST, then the other devices
    # with `--directory-pid` set. oriscterm and hostfsd self-register
    # at startup via the inline-register wire op (no ObjAlloc on a
    # CPU needed); if they came up before oriscdir, the registration
    # packets would land in oriscbar's queue with no destination and
    # get dropped, leaving the directory empty when supervisors
    # later walk for terminal/hostfsd refs. Single oriscdir per boot
    # is the convention; we grab its pid below as the canonical
    # directory pid for downstream devices.
    canonical_dir_pid = dir_specs[0]["pid"] if dir_specs else None

    for dspec in dir_specs:
        cmd = [sys.executable, str(ORISCDIR),
               "--socket", sock_path, "--pid", str(dspec["pid"])]
        if dspec["config"] and dspec["config"] != "none":
            cmd.extend(["--config", dspec["config"]])
        if dspec["verbose"]:
            cmd.append("-v")
        d = subprocess.Popen(
            cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        )
        procs.append((f"dir{dspec['pid']}", d))
        deadline = time.time() + 5.0
        line = b''
        while time.time() < deadline:
            rd, _, _ = select.select([d.stdout], [], [], 0.1)
            if d.stdout in rd:
                line = d.stdout.readline()
                if b"READY" in line:
                    break
        if b"READY" not in line:
            sys.stderr.write(f"oriscrun: oriscdir pid={dspec['pid']} "
                             f"failed to start\n")
            return cleanup_and_exit(1)
        sys.stdout.write(f"[dir{dspec['pid']}] "
                         f"{line.decode('utf-8', errors='replace')}")
        _attach_forwarders(f"dir{dspec['pid']}", d)

    for tspec in term_specs:
        cmd = [sys.executable, str(ORISCTERM),
               "--socket", sock_path, "--pid", str(tspec["pid"])]
        if canonical_dir_pid is not None:
            cmd.extend(["--directory-pid", str(canonical_dir_pid),
                        "--instance", str(tspec["instance"])])
        if tspec["verbose"]:
            cmd.append("-v")
        term = subprocess.Popen(
            cmd,
            stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        )
        procs.append((f"term{tspec['pid']}", term))
        # Wait for the device's READY line so the CPU doesn't SEND
        # before it's connected.
        deadline = time.time() + 5.0
        line = b''
        while time.time() < deadline:
            rd, _, _ = select.select([term.stdout], [], [], 0.1)
            if term.stdout in rd:
                line = term.stdout.readline()
                if b"READY" in line:
                    break
        if b"READY" not in line:
            sys.stderr.write(f"oriscrun: terminal pid={tspec['pid']} "
                             f"failed to start\n")
            return cleanup_and_exit(1)
        sys.stdout.write(f"[term{tspec['pid']}] "
                         f"{line.decode('utf-8', errors='replace')}")
        _attach_forwarders(f"term{tspec['pid']}", term)

    for hspec in hf_specs:
        cmd = [sys.executable, str(HOSTFSD),
               "--socket", sock_path, "--pid", str(hspec["pid"])]
        if canonical_dir_pid is not None:
            cmd.extend(["--directory-pid", str(canonical_dir_pid),
                        "--instance", str(hspec["instance"])])
        if hspec["verbose"]:
            cmd.append("-v")
        if hspec["root"] is not None:
            cmd.extend(["--root", hspec["root"]])
        hf = subprocess.Popen(
            cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        )
        procs.append((f"hf{hspec['pid']}", hf))
        deadline = time.time() + 5.0
        line = b''
        while time.time() < deadline:
            rd, _, _ = select.select([hf.stdout], [], [], 0.1)
            if hf.stdout in rd:
                line = hf.stdout.readline()
                if b"READY" in line:
                    break
        if b"READY" not in line:
            sys.stderr.write(f"oriscrun: hostfsd pid={hspec['pid']} "
                             f"failed to start\n")
            return cleanup_and_exit(1)
        sys.stdout.write(f"[hf{hspec['pid']}] "
                         f"{line.decode('utf-8', errors='replace')}")
        _attach_forwarders(f"hf{hspec['pid']}", hf)

    for lbspec in lb_specs:
        cmd = [sys.executable, str(LINKBOOTD),
               "--socket", sock_path, "--pid", str(lbspec["pid"])]
        if lbspec["verbose"]:
            cmd.append("-v")
        if lbspec["shells"]:
            cmd.extend(["--shell-pids", lbspec["shells"]])
        if lbspec["loaders"]:
            cmd.extend(["--loader-pids", lbspec["loaders"]])
        if lbspec["image"] is not None:
            cmd.extend(["--image", lbspec["image"]])
        if lbspec["root"] is not None:
            cmd.extend(["--root", lbspec["root"]])
        lb = subprocess.Popen(
            cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        )
        procs.append((f"lb{lbspec['pid']}", lb))
        deadline = time.time() + 5.0
        line = b''
        while time.time() < deadline:
            rd, _, _ = select.select([lb.stdout], [], [], 0.1)
            if lb.stdout in rd:
                line = lb.stdout.readline()
                if b"READY" in line:
                    break
        if b"READY" not in line:
            sys.stderr.write(f"oriscrun: linkbootd pid={lbspec['pid']} "
                             f"failed to start\n")
            return cleanup_and_exit(1)
        sys.stdout.write(f"[lb{lbspec['pid']}] "
                         f"{line.decode('utf-8', errors='replace')}")
        _attach_forwarders(f"lb{lbspec['pid']}", lb)

    # ---- 3. Spawn CPUs ----------------------------------------------------
    leader_proc = None
    for cspec in cpu_specs:
        cmd = [sys.executable, str(SIMORISC),
               "--connect", sock_path,
               "--pid", str(cspec["pid"])]
        for svc in cspec["services"]:
            cmd.extend(["--service", svc])
        if cspec["init_r4"]:
            cmd.extend(["--init-r4", str(cspec["init_r4"])])
        if cspec["display"] != "none":
            cmd.extend(["--display", cspec["display"]])
        if cspec["serve"]:
            cmd.append("--serve")
        if cspec["reset"]:
            cmd.append("--reset-on-exit")
        cmd.append(cspec["program"])
        cpu_proc = subprocess.Popen(
            cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        )
        procs.append((f"cpu{cspec['pid']}", cpu_proc))
        _attach_forwarders(f"cpu{cspec['pid']}", cpu_proc)
        if cspec["pid"] == args.leader:
            leader_proc = cpu_proc

    if leader_proc is None:
        sys.stderr.write("oriscrun: internal error: leader proc not found\n")
        return cleanup_and_exit(1)

    # ---- 4. Wait for the leader, then shut down ---------------------------
    try:
        leader_rc = leader_proc.wait(timeout=args.leader_timeout)
    except subprocess.TimeoutExpired:
        sys.stderr.write(f"oriscrun: leader timed out after "
                         f"{args.leader_timeout}s; tearing down\n")
        return cleanup_and_exit(2)
    # Give the rest a brief moment to flush remaining work; with a
    # GUI device this also leaves the window on screen long enough
    # for the human to read it before teardown.
    time.sleep(args.linger)
    return cleanup_and_exit(leader_rc)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
