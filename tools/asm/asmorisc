#!/usr/bin/env python3
"""
asmorisc — Assembler for the Object RISC architecture.

Reads an Object RISC assembly source file and produces an .orx binary
per CONTRACT.md Section 1. Also offers --disasm and --hex modes for
inspection and round-trip verification.

Implementation notes:
  * Two-pass: first pass enumerates labels with section offsets and
    expands pseudo-instructions to a fixed instruction count; second
    pass emits encoded words / data bytes with labels resolved.
  * Instruction encoders are kept in explicit dispatch tables so the
    correspondence with CONTRACT.md Section 5 is direct.
  * Big-endian throughout — header fields, instruction words, .word/.half.
"""

from __future__ import annotations

import argparse
import re
import struct
import sys
from dataclasses import dataclass, field
from pathlib import Path
from typing import Callable, Optional

# ---------------------------------------------------------------------------
# Binary header constants (CONTRACT.md Section 1)

MAGIC = b"ORISC\x00\x00\x00"
HEADER_SIZE = 0x20
FORMAT_VERSION = 1


# ---------------------------------------------------------------------------
# Register tables (CONTRACT.md Section 4.3)

GPR_ALIASES = {
    "zero": 0, "at": 1,
    "v0": 2, "v1": 3,
    "a0": 4, "a1": 5, "a2": 6, "a3": 7,
    "t0": 8, "t1": 9, "t2": 10, "t3": 11,
    "t4": 12, "t5": 13, "t6": 14, "t7": 15,
    "s0": 16, "s1": 17, "s2": 18, "s3": 19,
    "s4": 20, "s5": 21, "s6": 22, "s7": 23,
    "t8": 24, "t9": 25, "t10": 26, "t11": 27, "t12": 28,
    "sp": 29, "fp": 30, "ra": 31,
}

OBJ_ALIASES = {
    "null": 0,
}


def parse_register(tok: str, file: str, line: int, col: int) -> tuple[str, int]:
    """Parse a register token. Returns (kind, number) where kind is 'r' or 'o'."""
    name = tok.lower()
    if name in GPR_ALIASES:
        return ("r", GPR_ALIASES[name])
    if name in OBJ_ALIASES:
        return ("o", OBJ_ALIASES[name])
    m = re.fullmatch(r"r(\d+)", name)
    if m:
        n = int(m.group(1))
        if 0 <= n <= 31:
            return ("r", n)
    m = re.fullmatch(r"o(\d+)", name)
    if m:
        n = int(m.group(1))
        if 0 <= n <= 15:
            return ("o", n)
    raise AsmError(f"not a register: {tok!r}", file, line, col)


def parse_gpr(tok: str, file: str, line: int, col: int) -> int:
    kind, n = parse_register(tok, file, line, col)
    if kind != "r":
        raise AsmError(f"expected GPR, got object register {tok!r}", file, line, col)
    return n


def parse_obj(tok: str, file: str, line: int, col: int) -> int:
    kind, n = parse_register(tok, file, line, col)
    if kind != "o":
        raise AsmError(f"expected object register, got GPR {tok!r}", file, line, col)
    return n


# ---------------------------------------------------------------------------
# Errors

class AsmError(Exception):
    def __init__(self, msg: str, file: Optional[str] = None,
                 line: Optional[int] = None, col: Optional[int] = None):
        super().__init__(msg)
        self.msg = msg
        self.file = file
        self.line = line
        self.col = col

    def __str__(self) -> str:
        loc = ""
        if self.file is not None:
            loc = f"{self.file}"
            if self.line is not None:
                loc += f":{self.line}"
                if self.col is not None:
                    loc += f":{self.col}"
            loc += ": "
        return f"{loc}{self.msg}"


# ---------------------------------------------------------------------------
# Lexer / line splitter

@dataclass
class SourceLine:
    file: str
    line: int       # 1-based
    text: str       # original text without trailing newline
    payload: str    # text with comment stripped


def read_lines(paths: list[Path]) -> list[SourceLine]:
    out: list[SourceLine] = []
    for p in paths:
        text = p.read_text()
        for i, raw in enumerate(text.splitlines(), start=1):
            # Strip comment (everything from first ';' that isn't inside a string).
            payload = strip_comment(raw)
            out.append(SourceLine(file=str(p), line=i, text=raw, payload=payload))
    return out


def strip_comment(s: str) -> str:
    in_str = False
    esc = False
    for i, ch in enumerate(s):
        if esc:
            esc = False
            continue
        if ch == "\\" and in_str:
            esc = True
            continue
        if ch == '"':
            in_str = not in_str
            continue
        if ch == ';' and not in_str:
            return s[:i]
    return s


# ---------------------------------------------------------------------------
# Numeric and string literal parsers

def parse_int(tok: str, file: str, line: int, col: int) -> int:
    t = tok.strip()
    neg = False
    if t.startswith("+"):
        t = t[1:]
    elif t.startswith("-"):
        neg = True
        t = t[1:]
    try:
        if len(t) >= 3 and t[0] == "'" and t[-1] == "'":
            inner = t[1:-1]
            if inner.startswith("\\"):
                # use C escape rules
                b = decode_string('"' + inner + '"')
                if len(b) != 1:
                    raise ValueError
                v = b[0]
            else:
                if len(inner) != 1:
                    raise ValueError
                v = ord(inner)
        elif t.startswith(("0x", "0X")):
            v = int(t, 16)
        elif t.startswith(("0b", "0B")):
            v = int(t, 2)
        else:
            v = int(t, 10)
    except ValueError:
        raise AsmError(f"bad integer literal: {tok!r}", file, line, col)
    return -v if neg else v


# ---------------------------------------------------------------------------
# Expressions: late-bound numeric values built from numeric literals,
# identifier references (labels and `.set` constants), and `+`/`-` operators.
#
# An Expr is a flat list of (sign, kind, value) terms summed together.
# Unary minus on an identifier lowers to a negative-sign term.

@dataclass
class Expr:
    """A late-bound numeric expression evaluated at pass 2.

    `terms` is a list of (sign, kind, value):
       sign:  +1 or -1
       kind:  'num' (value is int) or 'sym' (value is identifier name)
    The expression's value is the sum of `sign * resolved(value)` over terms.
    """
    terms: list           # list[tuple[int, str, Any]]
    file: str
    line: int
    col: int


def parse_expression(toks: list["Token"], file: str, line: int) -> Expr:
    """Parse `expr := term (('+'|'-') term)*` from the supplied tokens, which
    must contain ONLY the expression (no trailing junk). Each `term` is a
    numeric literal or an identifier; numeric literals may carry their own
    leading minus sign in the token text, in addition to any binary operator
    sign in the surrounding context.
    """
    if not toks:
        raise AsmError("expected expression, got nothing", file, line, 1)
    terms: list = []
    sign = 1
    expect_term = True
    col = toks[0].col
    for t in toks:
        if expect_term:
            if t.kind == "num":
                v = parse_int(t.text, file, line, t.col)
                terms.append((sign, "num", v))
                expect_term = False
            elif t.kind == "char":
                v = parse_int(t.text, file, line, t.col)
                terms.append((sign, "num", v))
                expect_term = False
            elif t.kind == "sym":
                terms.append((sign, "sym", t.text))
                expect_term = False
            elif t.kind == "punct" and t.text in ("+", "-"):
                # Allow leading unary +/- (and chains thereof, harmlessly).
                if t.text == "-":
                    sign = -sign
                # else '+' is a no-op
            else:
                raise AsmError(f"expected term in expression, got {t.text!r}",
                               file, line, t.col)
        else:
            if t.kind == "punct" and t.text in ("+", "-"):
                sign = +1 if t.text == "+" else -1
                expect_term = True
            else:
                raise AsmError(f"expected '+' or '-' in expression, got {t.text!r}",
                               file, line, t.col)
    if expect_term:
        raise AsmError("expression ends with a dangling operator",
                       file, line, toks[-1].col)
    return Expr(terms=terms, file=file, line=line, col=col)


def expr_is_constant(expr: Expr) -> bool:
    """True if every term is a literal number — evaluable without symbols."""
    return all(kind == "num" for _, kind, _ in expr.terms)


def eval_expr(asm: "Assembler", expr: Expr) -> int:
    """Resolve all symbols and sum. Used at pass 2 (and at parse time when
    the expression is purely numeric)."""
    return _eval_expr_inner(asm, expr, set())


def _eval_expr_inner(asm: "Assembler", expr: Expr, in_progress: set) -> int:
    total = 0
    for sign, kind, value in expr.terms:
        if kind == "num":
            total += sign * value
        else:  # 'sym'
            total += sign * _resolve_symbol(asm, value, expr,
                                            in_progress=in_progress)
    # Keep the value as a Python int (no wrap). Range checks at use sites
    # handle bit-width validation; absolute label references need unsigned
    # 32-bit interpretation, which the caller can do via `& 0xFFFFFFFF`.
    return total


def _resolve_symbol(asm: "Assembler", name: str, ctx: Expr,
                    in_progress: set) -> int:
    """Resolve a symbol: first check `.set` constants (recursively), then
    labels (their absolute VA via section_base + offset)."""
    # `.set` constants take precedence over labels — and we look up
    # constants first because labels are populated in pass 1 while constant
    # values may transitively refer to other constants and labels.
    if name in asm.constants:
        if name in in_progress:
            raise AsmError(f"circular `.set` reference involving {name!r}",
                           ctx.file, ctx.line, ctx.col)
        in_progress = in_progress | {name}
        return _eval_expr_inner(asm, asm.constants[name], in_progress)
    if name in asm.labels:
        sec, off = asm.labels[name]
        return section_base(sec) + off
    raise AsmError(f"undefined symbol {name!r} in expression",
                   ctx.file, ctx.line, ctx.col)


_ESCAPES = {
    "n": 0x0A, "t": 0x09, "r": 0x0D,
    "\\": 0x5C, '"': 0x22, "'": 0x27,
    "0": 0x00,
}


def decode_string(tok: str) -> bytes:
    """Decode a double-quoted string literal with C-style escapes."""
    if not (tok.startswith('"') and tok.endswith('"')):
        raise ValueError(f"not a string literal: {tok!r}")
    out = bytearray()
    i = 1
    while i < len(tok) - 1:
        ch = tok[i]
        if ch == "\\":
            if i + 1 >= len(tok) - 1:
                raise ValueError("dangling escape in string literal")
            nxt = tok[i + 1]
            if nxt == "x":
                if i + 3 >= len(tok) - 1:
                    raise ValueError("incomplete \\x escape")
                hh = tok[i + 2:i + 4]
                out.append(int(hh, 16))
                i += 4
                continue
            if nxt in _ESCAPES:
                out.append(_ESCAPES[nxt])
                i += 2
                continue
            raise ValueError(f"unknown escape \\{nxt}")
        out.append(ord(ch))
        i += 1
    return bytes(out)


# ---------------------------------------------------------------------------
# Field-checking helpers

def check_unsigned(value: int, width: int, file: str, line: int, col: int,
                   what: str) -> int:
    lo, hi = 0, (1 << width) - 1
    if not (lo <= value <= hi):
        raise AsmError(
            f"{what} {value} out of range [0, {hi}] for {width}-bit unsigned field",
            file, line, col)
    return value & hi


def check_signed(value: int, width: int, file: str, line: int, col: int,
                 what: str) -> int:
    lo, hi = -(1 << (width - 1)), (1 << (width - 1)) - 1
    if not (lo <= value <= hi):
        raise AsmError(
            f"{what} {value} out of range [{lo}, {hi}] for {width}-bit signed field",
            file, line, col)
    return value & ((1 << width) - 1)


def check_simm_or_uimm(value: int, width: int, file: str, line: int, col: int,
                       what: str) -> int:
    """Accept either a signed or unsigned 16-bit pattern; a 16-bit immediate
    such as 0xFFFF means -1 here, and -1 means 0xFFFF — both encode the same."""
    lo = -(1 << (width - 1))
    hi = (1 << width) - 1
    if not (lo <= value <= hi):
        raise AsmError(
            f"{what} {value} out of range [{lo}, {hi}] for {width}-bit field",
            file, line, col)
    return value & ((1 << width) - 1)


