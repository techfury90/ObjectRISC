def sext16(v: int) -> int:
    v &= 0xFFFF
    return v - 0x10000 if v & 0x8000 else v

def sext32(v: int) -> int:
    v &= 0xFFFFFFFF
    return v - 0x100000000 if v & 0x80000000 else v

def to_u32(v: int) -> int:
    return v & 0xFFFFFFFF


# ---------------------------------------------------------------------------
# Phase 60 — host display worker (--display tk)
# ---------------------------------------------------------------------------
#
# When simorisc runs with --display tk, every TAG_FRAMEBUFFER object the
# CPU allocates (via primitive_ObjAllocFramebuffer) gets mirrored into a
# host Tk window.  Stores via ObjStoreBytes flag the descriptor dirty;
# the worker repaints on its next tick.  No wire round-trips — the
# pixel bytes live in the same Python process as the simulator.
#
# Headless (default `--display none`) keeps the firmware op working
# (TAG_FRAMEBUFFER is just a plain bytearray) but skips Tk; lets CI
# and smoke tests exercise the same firmware path without a display.

VEC_PALETTE_HEX = {
    0: "#0a0a14", 1: "#d8d8d8", 2: "#ff5555", 3: "#55ff55",
    4: "#5599ff", 5: "#ffd866", 6: "#66ddff", 7: "#ff66ff",
    8: "#ffffff",
}


def _build_palette_lut():
    """Per-index 3-byte RGB lookup, used by the b\"\".join repaint loop.
    Indices outside VEC_PALETTE_HEX fall through to bg (idx 0).  Same
    shape γ.10 used in oriscterm — repaints land in the tens of ms even
    at 1280×768 because the inner loop is C-level (`b\"\".join`)."""
    bg = VEC_PALETTE_HEX[0]
    bg_rgb = bytes((int(bg[1:3], 16), int(bg[3:5], 16), int(bg[5:7], 16)))
    lut = []
    for i in range(256):
        h = VEC_PALETTE_HEX.get(i)
        if h is None:
            lut.append(bg_rgb)
        else:
            lut.append(bytes((int(h[1:3], 16), int(h[3:5], 16),
                              int(h[5:7], 16))))
    return lut


class TkDisplayWorker:
    """Bind host Tk windows to TAG_FRAMEBUFFER objects.  Lifetime
    matches the parent simorisc process; per-CPU instance.

    The worker is no-op when Tk import fails (CI / headless) — the
    framebuffer object still exists, the firmware path still works,
    just nothing visible appears.

    tick() is called from System.run after each progress pass.  It
    pumps Tk's event loop and repaints any framebuffer whose
    desc.fb_dirty is set.  Repaints throttle at ~60 Hz to keep the
    simulator from spending its budget repainting on rapid bursts of
    small writes."""

    def __init__(self, title_prefix="oriscwm fb"):
        self.title_prefix = title_prefix
        self._tk = None        # tkinter module (lazy import)
        self._root = None
        self._tracked = {}     # idx → {win, image, width, height, desc}
        # Pending registrations: (cpu_pid, idx, desc).  Filled by
        # register_framebuffer (called from inside the firmware
        # primitive — must return fast so the WM doesn't stall while
        # supervisors are racing wm_init retries) and drained by
        # tick() off the firmware-critical path.  Tk root + Toplevel
        # creation is hundreds of ms, enough to push the WM's
        # /sys/wm/<N>/0 dir_register past the supervisor's retry
        # budget.
        self._pending = []
        self._lut = _build_palette_lut()
        self._last_repaint = 0.0
        self._min_repaint_interval = 1.0 / 60.0

    def _ensure_root(self):
        if self._root is not None:
            return
        try:
            import tkinter as tk
        except ImportError:
            return
        try:
            self._root = tk.Tk()
        except Exception:
            self._root = None
            return
        self._tk = tk
        self._root.withdraw()  # FB windows are Toplevels; root invisible

    def register_framebuffer(self, cpu, idx, desc):
        # Fast path: just record.  tick() does the heavy Tk init.
        self._pending.append((cpu.pid, idx, desc))

    def _drain_pending(self):
        if not self._pending:
            return
        self._ensure_root()
        if self._root is None:
            self._pending.clear()  # Tk unavailable; drop without retry
            return
        while self._pending:
            cpu_pid, idx, desc = self._pending.pop(0)
            if idx in self._tracked:
                continue
            win = self._tk.Toplevel(self._root)
            win.title(f"{self.title_prefix} pid={cpu_pid} fb#{idx}")
            img = self._tk.PhotoImage(width=desc.fb_width,
                                      height=desc.fb_height)
            canvas = self._tk.Canvas(win,
                                     width=desc.fb_width,
                                     height=desc.fb_height,
                                     borderwidth=0,
                                     highlightthickness=0)
            canvas.pack(fill="both", expand=True)
            canvas.create_image(0, 0, image=img, anchor="nw")
            self._tracked[idx] = {
                "win": win, "image": img,
                "width": desc.fb_width, "height": desc.fb_height,
                "desc": desc,
            }

    def _repaint(self, info):
        desc = info["desc"]
        W, H = info["width"], info["height"]
        lut = self._lut
        rgb = b"".join([lut[b] for b in desc.storage])
        ppm = (b"P6\n" + str(W).encode() + b" "
               + str(H).encode() + b"\n255\n" + rgb)
        try:
            info["image"].configure(data=ppm)
        except Exception:
            pass

    def tick(self):
        # System.run calls tick() once per simulated CPU instruction —
        # too often for any actual Tk work, so wallclock-throttle the
        # whole body to ~60 Hz.  Early-return on the throttle keeps
        # the per-cycle overhead to a single time.time() + compare,
        # which restores the WM CPU's effective rate after Phase 60
        # step 2 hooked us into the cycle loop.
        if not self._pending and self._root is None:
            return  # no Tk yet AND nothing pending — pure no-op
        now = time.time()
        if now - self._last_repaint < self._min_repaint_interval:
            return
        # Drain any pending Tk window registrations first — they
        # arrive from primitive_ObjAllocFramebuffer, which has to
        # return fast for the WM's boot sequence.
        self._drain_pending()
        if self._root is None:
            return
        for info in self._tracked.values():
            desc = info["desc"]
            if desc.fb_dirty:
                self._repaint(info)
                desc.fb_dirty = False
        self._last_repaint = now
        try:
            self._root.update()
        except Exception:
            self._root = None


