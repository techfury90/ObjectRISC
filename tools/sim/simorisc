# ---------------------------------------------------------------------------
# Object descriptor and reference layout
# ---------------------------------------------------------------------------

@dataclass
class Descriptor:
    """An object descriptor in a CPU's local object table.

    We don't model the 32-byte on-the-wire layout from Volume III Section
    3.2 here; we keep the architecturally observable state in Python form
    and rely on the generation-counter semantics to make accesses
    cache-coherent (Volume III Section 4)."""
    storage: bytearray
    length: int
    generation: int
    type_tag: int
    max_caps: int
    flags: int = 0
    live: bool = True
    send_handler_ref: int = 0
    send_handler_off: int = 0
    send_handler_va:  int = 0   # populated by InstallHandler from object's mapping
    objstore: bool = False      # if True, storage is OR-typed (OREFLD/OREFST only)
    # Receive-queue mode: when set by ReceiveQueueAttach, incoming SENDs are
    # appended here instead of dispatching a handler task. queue_max_depth
    # bounds the queue length; arrivals beyond it are dropped.
    queue: Optional[List] = None
    queue_max_depth: int = 0
    # Phase 60 — host-display backing.  Set on TAG_FRAMEBUFFER objects
    # by primitive_ObjAllocFramebuffer.  fb_dirty is toggled by
    # ObjStoreBytes; the --display worker repaints when it sees the
    # flag set, then clears it.  fb_width/fb_height let the worker
    # build a Tk PhotoImage of the right shape.
    fb_width:  int = 0
    fb_height: int = 0
    fb_dirty:  bool = False


def make_ref(generation: int, home: int, index: int, caps: int) -> int:
    """Pack a 64-bit object reference per Volume III Section 2.1.

       63       48 47    40 39          16 15  8 7 0
       generation  home pr  local idx     caps  rsv
    """
    assert 0 <= generation < (1 << 16)
    assert 0 <= home < (1 << 8)
    assert 0 <= index < (1 << 24)
    assert 0 <= caps < (1 << 8)
    return ((generation & 0xFFFF) << 48) | \
           ((home       & 0xFF)   << 40) | \
           ((index      & 0xFFFFFF) << 16) | \
           ((caps       & 0xFF)   << 8)


def ref_generation(ref: int) -> int:  return (ref >> 48) & 0xFFFF
def ref_home(ref: int)       -> int:  return (ref >> 40) & 0xFF
def ref_index(ref: int)      -> int:  return (ref >> 16) & 0xFFFFFF
def ref_caps(ref: int)       -> int:  return (ref >>  8) & 0xFF


# ---------------------------------------------------------------------------
# Tasks (Volume VI Section 4)
# ---------------------------------------------------------------------------

@dataclass
class Task:
    """A swappable execution context. The CPU's per-task fields
    (general/object registers, PC, mode, the supervisor-visible control
    registers, and the address-space mappings) are mirrored here so the
    scheduler can save out the running task and load another in.

    Per-CPU state (descriptor table, inbox, request/response queues,
    cycle counter, VECBASE) lives on the CPU, not the task. VECBASE
    is firmware-installed once per CPU and shared by every task."""
    descriptor_idx: int             # index in cpu.descriptors for the task ref
    code_ref:  int = 0              # original code object (kept for restart/debug)
    stack_ref: int = 0              # original stack object
    state:     int = TASK_STATE_NEW
    exit_code: Optional[int] = None

    # Saved register file. CPU's gpr/opr/etc. become these on context-in.
    gpr: List[int] = field(default_factory=lambda: [0]*32)
    opr: List[int] = field(default_factory=lambda: [0]*16)
    hi:  int = 0
    lo:  int = 0
    pc:  int = 0
    next_pc: int = 0

    # Privilege state — current mode and whatever ERET / trap delivery
    # has stashed so far. Each task's traps are private to it.
    mode:        int = MODE_SUPERVISOR
    saved_mode:  int = MODE_SUPERVISOR
    saved_pc:    int = 0
    cause_reg:   int = 0
    badvaddr_reg: int = 0

    # Address space. Each task carries its own virtual-address layout;
    # the CPU's `mappings` list IS the running task's layout.
    mappings: List[Tuple[int,int,int,int,int]] = field(default_factory=list)

    # Tasks parked in TaskWait on this one. When this task transitions to
    # EXITED, every entry's R3 is filled with the exit code, R2 with OK,
    # and the waiter is moved BLOCKED → RUNNABLE. The list is then
    # cleared (waiters can't double-collect).
    waiters: List['Task'] = field(default_factory=list)

    # Phase 45d: remote callers waiting on this task via TASK_WAIT_REQ.
    # Each entry is (waiter_pid, trans_id); on EXITED we send a
    # TASK_WAIT_RESP back to each. Cleared after the responses go out.
    remote_waiters: List[Tuple[int, int]] = field(default_factory=list)

    # IPC blocked_on saved with this task. When the current task hits
    # a blocking primitive (ReceiveQueuePoll on an empty queue, remote
    # OL/OS waiting on a response) and there's another runnable task
    # we'd like to schedule, save the BlockedSignal here so the
    # scheduler can switch in the runnable task and process this
    # task's unblock condition asynchronously. Phase 36.
    blocked_on: Optional['BlockedSignal'] = None


# ---------------------------------------------------------------------------
# Trap exception
# ---------------------------------------------------------------------------

class Trap(Exception):
    def __init__(self, cause: int, faulting_pc: int, detail: str = "",
                 bad_vaddr: int = 0):
        self.cause = cause
        self.faulting_pc = faulting_pc
        self.bad_vaddr = bad_vaddr & 0xFFFFFFFF
        self.detail = detail
        super().__init__(f"trap {CAUSE_NAMES.get(cause, hex(cause))} @ "
                         f"0x{faulting_pc:08x}: {detail}")


class TaskExitSignal(Exception):
    """Raised by primitive_TaskExit; caught by the System scheduler."""
    def __init__(self, code: int):
        self.code = code


class BlockedSignal(Exception):
    """Base class for "hold the CPU at this instruction" signals. Two
    subclasses cover the cases we currently need; both are caught at the
    instruction-dispatch site (CALL or OL/OS) and observed by the
    scheduler to suspend and later resume the CPU."""
    pass


class BlockedOnQueue(BlockedSignal):
    """Raised by ReceiveQueuePoll when its target queue is empty and the
    timeout is non-zero. The scheduler holds the CPU at the CALL until
    the queue receives a message (or timeout expires); on resume it
    populates registers per Volume VI Section 6 and advances PC."""
    def __init__(self, descriptor_idx: int, timeout: int):
        self.descriptor_idx = descriptor_idx
        # timeout: -1 = infinite; otherwise number of scheduler ticks remaining
        self.timeout = timeout


class BlockedOnResponse(BlockedSignal):
    """Raised by remote OL/OS instructions after queueing an OBJ_READ_REQ
    or OBJ_WRITE_REQ on the home CPU. The scheduler holds the CPU at the
    OL/OS instruction until a matching response arrives; on resume it
    either writes the loaded value into the destination register
    (`OBJ_READ_RESP` with flags=OK), no-ops (`OBJ_WRITE_RESP` with
    flags=OK), or raises a Trap (any non-OK flags)."""
    def __init__(self, trans_id: int, *, target_reg: Optional[int] = None,
                 width: int = 0, signed: bool = False, is_write: bool = False):
        self.trans_id = trans_id
        self.target_reg = target_reg
        self.width = width
        self.signed = signed
        self.is_write = is_write


class BlockedOnExitWait(BlockedSignal):
    """Set by primitive_TaskExit when the exiting task was the only
    runnable task but other tasks remain BLOCKED (e.g., a shell
    parked on RecvQueuePoll waiting for a key). The CPU stays alive
    so _process_requests can answer in-flight OBJ_READ_REQs from
    the just-finished task's data segment, and so _wake_blocked_tasks
    can promote a blocked task once its condition fires; the
    blocked-but-runnable branch in run() then context-switches into
    it. There's no "unblock" condition tied to this signal — it's a
    sentinel, not a wait — so _try_unblock returns False and the
    blocked-but-runnable branch is the only path that consumes it."""
    pass


class BlockedOnTaskWait(BlockedSignal):
    """Phase 45d. Raised by primitive_TaskWait when the target ref's
    home is a different CPU. The caller queues a TASK_WAIT_REQ on the
    home and parks here until the matching TASK_WAIT_RESP arrives;
    on resume R2 receives the status word, R3 the exit code (when
    status == OK), and PC advances past the CALL."""
    def __init__(self, trans_id: int):
        self.trans_id = trans_id


class BlockedOnTaskQuery(BlockedSignal):
    """Phase 45d. Raised by primitive_TaskQuery for remote refs. On
    response R2 = status, R3 = packed state word; PC advances."""
    def __init__(self, trans_id: int):
        self.trans_id = trans_id


class BlockedOnTaskKill(BlockedSignal):
    """Phase 45d. Raised by primitive_TaskKill for remote refs. On
    response R2 = status; no other GPRs touched; PC advances."""
    def __init__(self, trans_id: int):
        self.trans_id = trans_id


class BlockedOnObjFetch(BlockedSignal):
    """Phase 45e. Raised by primitive_ObjFetchBytes when the source ref
    is remote. The CALL holds PC until the matching OBJ_READ_RESP
    arrives; on resume the response data is copied into the local
    destination descriptor at (dst_idx, dst_off..dst_off+byte_count),
    R2 = ERR_OK or remote-fault-derived ERR_*, R3 = bytes copied,
    PC advances. On a remote-side fault flag we never end up writing
    the destination — caller sees R3 = 0."""
    def __init__(self, trans_id: int, dst_idx: int, dst_off: int,
                 byte_count: int):
        self.trans_id = trans_id
        self.dst_idx = dst_idx
        self.dst_off = dst_off
        self.byte_count = byte_count


class BlockedOnObjStore(BlockedSignal):
    """Phase 59 (Object RISC Vol VI #0x109). Raised by
    primitive_ObjStoreBytes when the destination ref is remote.
    The CALL holds PC until the matching OBJ_WRITE_RESP arrives;
    on resume R2 = ERR_OK / ERR_*, R3 = byte_count on OK or 0 on
    fault, PC advances.  Mirror of BlockedOnObjFetch for the write
    direction — used by the WM's glyph renderer to push bitmap-font
    rows to a remote framebuffer in a single wire RTT."""
    def __init__(self, trans_id: int, byte_count: int):
        self.trans_id = trans_id
        self.byte_count = byte_count


# ---------------------------------------------------------------------------
# Wire-level packet format (Volume IV §3, §4)
# ---------------------------------------------------------------------------
#
# Every packet is:
#   header (8 bytes) | payload (length × 4 bytes) | checksum (4 bytes)
#
# The header layout (Volume IV §3.1) is:
#   src_pid (8) | dst_pid (8) | type (8) | flags (8) | trans_id (16) | length (16)
# where length is the number of payload words (not bytes), big-endian throughout.
# The trailing checksum is the bitwise XOR of every header and payload word.
#
# Message types are taken from Volume IV §4. Phase 1 implements only
# SEND_DELIVER (0x20) on the wire; Phase 2 will add OBJ_READ_REQ/RESP (0x10/11)
# and OBJ_WRITE_REQ/RESP (0x12/13) so that remote OL/OS likewise flow as
# real packets.

# Packet type codes.
PKT_OBJ_READ_REQ    = 0x10
PKT_OBJ_READ_RESP   = 0x11
PKT_OBJ_WRITE_REQ   = 0x12
PKT_OBJ_WRITE_RESP  = 0x13
PKT_SEND_DELIVER    = 0x20
PKT_SEND_ACK        = 0x21
PKT_DESC_REQ        = 0x30
PKT_DESC_RESP       = 0x31
PKT_DESC_FORWARD    = 0x32
PKT_DESC_INVALIDATE = 0x33
# Phase 45d — remote task primitives. The home CPU is the source of truth
# for a task's state; remote callers exchange these request/response
# packets to invoke TaskWait/Query/Kill across CPU boundaries. Status
# travels in the response payload (rather than the flags byte) because
# the architectural Task API uses ERR_* codes that don't all map to the
# 6-bit RESP_* fault codes used by OL/OS responses.
PKT_TASK_WAIT_REQ   = 0x40
PKT_TASK_WAIT_RESP  = 0x41
PKT_TASK_QUERY_REQ  = 0x42
PKT_TASK_QUERY_RESP = 0x43
PKT_TASK_KILL_REQ   = 0x44
PKT_TASK_KILL_RESP  = 0x45
PKT_LINK_FLOW_CREDIT= 0xF0
PKT_LINK_ERROR      = 0xF1
PKT_LINK_HEARTBEAT  = 0xFE
PKT_LINK_RESET      = 0xFF


def pack_packet(src_pid: int, dst_pid: int, msg_type: int, flags: int,
                trans_id: int, payload_words: List[int]) -> bytes:
    """Build a wire-format packet per Volume IV §3.1 + §3.2."""
    length_words = len(payload_words)
    header_bytes = struct.pack(">BBBBHH",
                               src_pid & 0xFF, dst_pid & 0xFF,
                               msg_type & 0xFF, flags & 0xFF,
                               trans_id & 0xFFFF, length_words & 0xFFFF)
    payload_bytes = b''.join(struct.pack(">I", w & 0xFFFFFFFF)
                             for w in payload_words)
    # Checksum = XOR of header and payload words (header is two 32-bit words).
    h0, h1 = struct.unpack(">II", header_bytes)
    chk = h0 ^ h1
    for w in payload_words:
        chk ^= w & 0xFFFFFFFF
    return header_bytes + payload_bytes + struct.pack(">I", chk & 0xFFFFFFFF)


def unpack_packet(data: bytes) -> Dict:
    """Parse a wire-format packet and validate its size/checksum.
    Returns dict with src_pid, dst_pid, type, flags, trans_id, payload (list of words).
    Raises ValueError on malformed input."""
    if len(data) < 12:
        raise ValueError(f"packet too short: {len(data)} bytes")
    src, dst, mtype, flags, trans_id, length_words = \
        struct.unpack(">BBBBHH", data[:8])
    expected_total = 8 + length_words * 4 + 4
    if len(data) != expected_total:
        raise ValueError(
            f"packet length mismatch: header says {length_words} payload "
            f"words, total bytes {len(data)} != expected {expected_total}")
    payload_bytes = data[8:8 + length_words * 4]
    payload_words = list(struct.unpack(f">{length_words}I", payload_bytes)
                         if length_words else [])
    h0, h1 = struct.unpack(">II", data[:8])
    chk = h0 ^ h1
    for w in payload_words:
        chk ^= w
    expected_chk = struct.unpack(">I", data[-4:])[0]
    if (chk & 0xFFFFFFFF) != expected_chk:
        raise ValueError(
            f"checksum mismatch: computed {chk:#010x}, "
            f"packet says {expected_chk:#010x}")
    return {
        "src_pid": src, "dst_pid": dst, "type": mtype, "flags": flags,
        "trans_id": trans_id, "payload": payload_words,
    }


def build_send_deliver(src_pid: int, dst_pid: int, trans_id: int,
                       recipient_ref: int, int_payload: List[int],
                       or_payload: List[int]) -> bytes:
    """Construct a SEND_DELIVER packet (Volume IV §4.2) from an in-memory
    PendingSend's contents. Object references travel low-half-first
    (Volume IV §4.1)."""
    payload: List[int] = []
    payload.append(recipient_ref & 0xFFFFFFFF)
    payload.append((recipient_ref >> 32) & 0xFFFFFFFF)
    for w in int_payload[:4]:
        payload.append(w & 0xFFFFFFFF)
    for ref in or_payload[:4]:
        payload.append(ref & 0xFFFFFFFF)
        payload.append((ref >> 32) & 0xFFFFFFFF)
    return pack_packet(src_pid, dst_pid, PKT_SEND_DELIVER, 0, trans_id, payload)


def parse_send_deliver(packet: Dict) -> Tuple[int, List[int], List[int]]:
    """Inverse of build_send_deliver. Returns (recipient_ref, int_payload, or_payload)."""
    if packet["type"] != PKT_SEND_DELIVER:
        raise ValueError(f"expected SEND_DELIVER ({PKT_SEND_DELIVER:#x}), "
                         f"got {packet['type']:#x}")
    p = packet["payload"]
    if len(p) != 14:
        raise ValueError(f"SEND_DELIVER payload must be 14 words; got {len(p)}")
    recipient_ref = p[0] | (p[1] << 32)
    int_payload = list(p[2:6])
    or_payload = []
    for i in range(4):
        ref = p[6 + 2*i] | (p[7 + 2*i] << 32)
        or_payload.append(ref)
    return recipient_ref, int_payload, or_payload


# OBJ_READ_REQ / OBJ_READ_RESP / OBJ_WRITE_REQ / OBJ_WRITE_RESP
# (Volume IV §4.1). The home processor performs the validity, bounds,
# and capability checks itself; on failure the response carries a fault
# code in the low six bits of the `flags` byte instead of data.

# Response fault codes (Vol IV §4.1, low 6 bits of the response flags byte).
RESP_OK         = 0x00
RESP_STALE      = 0x01
RESP_BOUNDS     = 0x02
RESP_CAP        = 0x03
RESP_BUS_ERROR  = 0x04
RESP_FORWARDED  = 0x3F


def build_obj_read_req(src_pid: int, dst_pid: int, trans_id: int,
                       ref: int, offset: int, width: int) -> bytes:
    payload = [
        ref & 0xFFFFFFFF,
        (ref >> 32) & 0xFFFFFFFF,
        offset & 0xFFFFFFFF,
        width & 0xFFFFFFFF,
    ]
    return pack_packet(src_pid, dst_pid, PKT_OBJ_READ_REQ, 0, trans_id, payload)


def build_obj_read_resp(src_pid: int, dst_pid: int, trans_id: int,
                        flags: int, data: bytes) -> bytes:
    """Pad data to a 4-byte word boundary; pack words as the payload."""
    if flags == RESP_OK:
        pad = (-len(data)) % 4
        padded = data + bytes(pad)
        words = list(struct.unpack(f">{len(padded)//4}I", padded)) if padded else []
    else:
        words = []
    return pack_packet(src_pid, dst_pid, PKT_OBJ_READ_RESP, flags, trans_id, words)


def build_obj_write_req(src_pid: int, dst_pid: int, trans_id: int,
                        ref: int, offset: int, width: int, data: bytes) -> bytes:
    pad = (-len(data)) % 4
    padded = data + bytes(pad)
    data_words = list(struct.unpack(f">{len(padded)//4}I", padded)) if padded else []
    payload = [
        ref & 0xFFFFFFFF,
        (ref >> 32) & 0xFFFFFFFF,
        offset & 0xFFFFFFFF,
        width & 0xFFFFFFFF,
    ] + data_words
    return pack_packet(src_pid, dst_pid, PKT_OBJ_WRITE_REQ, 0, trans_id, payload)


def build_obj_write_resp(src_pid: int, dst_pid: int, trans_id: int,
                         flags: int) -> bytes:
    return pack_packet(src_pid, dst_pid, PKT_OBJ_WRITE_RESP, flags, trans_id, [])


# Phase 45d — remote Task primitive packets. Each REQ carries the target
# task ref (2 words, low-half first per Vol IV §4.1); the corresponding
# RESP carries an ERR_* status word plus any primitive-specific result
# words. flags is unused in these packet types.

def build_task_wait_req(src_pid: int, dst_pid: int, trans_id: int,
                        ref: int) -> bytes:
    payload = [ref & 0xFFFFFFFF, (ref >> 32) & 0xFFFFFFFF]
    return pack_packet(src_pid, dst_pid, PKT_TASK_WAIT_REQ, 0, trans_id, payload)


def build_task_wait_resp(src_pid: int, dst_pid: int, trans_id: int,
                         status: int, exit_code: int) -> bytes:
    """status = ERR_*; exit_code is meaningful only when status == ERR_OK."""
    payload = [status & 0xFFFFFFFF, exit_code & 0xFFFFFFFF]
    return pack_packet(src_pid, dst_pid, PKT_TASK_WAIT_RESP, 0, trans_id, payload)


def build_task_query_req(src_pid: int, dst_pid: int, trans_id: int,
                         ref: int) -> bytes:
    payload = [ref & 0xFFFFFFFF, (ref >> 32) & 0xFFFFFFFF]
    return pack_packet(src_pid, dst_pid, PKT_TASK_QUERY_REQ, 0, trans_id, payload)


def build_task_query_resp(src_pid: int, dst_pid: int, trans_id: int,
                          status: int, packed: int) -> bytes:
    """status = ERR_*; packed is the architectural Vol VI #0x008 packed
    state word (state | proc<<8 | exit_code<<16) — meaningful only when
    status == ERR_OK."""
    payload = [status & 0xFFFFFFFF, packed & 0xFFFFFFFF]
    return pack_packet(src_pid, dst_pid, PKT_TASK_QUERY_RESP, 0, trans_id, payload)


def build_task_kill_req(src_pid: int, dst_pid: int, trans_id: int,
                        ref: int, exit_code: int) -> bytes:
    payload = [ref & 0xFFFFFFFF, (ref >> 32) & 0xFFFFFFFF,
               exit_code & 0xFFFFFFFF]
    return pack_packet(src_pid, dst_pid, PKT_TASK_KILL_REQ, 0, trans_id, payload)


def build_task_kill_resp(src_pid: int, dst_pid: int, trans_id: int,
                         status: int) -> bytes:
    payload = [status & 0xFFFFFFFF]
    return pack_packet(src_pid, dst_pid, PKT_TASK_KILL_RESP, 0, trans_id, payload)


# Map response-flag fault codes to architectural trap causes for the
# issuer to raise upon receiving a non-OK response.
RESP_FLAG_TO_CAUSE = {
    RESP_STALE:     CAUSE_STALE_REF,
    RESP_BOUNDS:    CAUSE_BOUNDS,
    RESP_CAP:       CAUSE_CAP_VIOLATION,
    RESP_BUS_ERROR: CAUSE_BUS_ERROR_D,
}


# ---------------------------------------------------------------------------
# Pending SEND message (host-side parsed form of a SEND_DELIVER packet)
# ---------------------------------------------------------------------------

@dataclass
class PendingSend:
    recipient_ref: int                   # full 64-bit ref of the target object
    int_payload: List[int]               # 4 ints (R4..R7 of issuer at SEND time)
    or_payload: List[int]                # 4 OR refs (O1..O4 of issuer at SEND time)
    src_pid: int                         # which CPU issued this SEND
    trans_id: int = 0                    # per-source transaction id

    def to_wire(self, dst_pid: int) -> bytes:
        return build_send_deliver(self.src_pid, dst_pid, self.trans_id,
                                  self.recipient_ref, self.int_payload,
                                  self.or_payload)

    @classmethod
    def from_wire(cls, data: bytes) -> 'PendingSend':
        pkt = unpack_packet(data)
        recipient_ref, int_payload, or_payload = parse_send_deliver(pkt)
        return cls(recipient_ref=recipient_ref,
                   int_payload=int_payload,
                   or_payload=or_payload,
                   src_pid=pkt["src_pid"],
                   trans_id=pkt["trans_id"])


# ---------------------------------------------------------------------------
# Crossbar interface and in-process implementation
# ---------------------------------------------------------------------------
#
# Everything that crosses between CPUs (and, in a future revision, between
# CPUs and devices) goes through a Crossbar. The Crossbar owns nothing
# semantic about the protocol — it inspects each packet's `dst_pid` field
# and hands the packet off to that destination's Port. A Port is anything
# that can receive packets: today, only CPUs implement Port; tomorrow,
# device processes will too.
#
# The InProcessCrossbar implementation routes by direct method dispatch
# inside one Python process. A SocketCrossbar (next phase) will route
# bytes over a UNIX domain socket to peer CPU processes.

class Port:
    """A participant on the crossbar. Any object that can receive packet
    bytes addressed to a particular pid is a Port."""
    def receive_packet(self, packet: bytes) -> None:
        raise NotImplementedError


class Crossbar:
    """Interface for the crossbar interconnect.

    `send_packet(packet)` routes one wire-format packet to the Port
    registered for its `dst_pid` field. Implementations may be
    in-process, over a socket, or over a real fabric — the rest of the
    simulator only sees this method.

    `poll_incoming()` is called once per scheduler tick; it lets
    transport-bearing implementations (e.g., SocketCrossbar) drain any
    bytes from their wire and deliver complete packets into the local
    Port. The default in-process implementation does nothing."""
    def send_packet(self, packet: bytes) -> None:
        raise NotImplementedError

    def attach_port(self, pid: int, port: Port) -> None:
        raise NotImplementedError

    def poll_incoming(self) -> bool:
        return False

    def close(self) -> None:
        pass


class SocketCrossbar(Crossbar):
    """Crossbar implementation that talks to an external `oriscbar`
    process over a UNIX domain socket. Wire framing and handshake are
    documented in oriscbar's module docstring. The simulator runs in
    single-CPU mode in this configuration; the external crossbar
    routes between many such simorisc instances and any device
    processes."""
    HELLO_MAGIC  = 0xC0FFEEAA
    HELLO_OK     = 0x00000000

    def __init__(self, sock_path: str, my_pid: int,
                 trace_enabled: bool = False):
        import socket
        self.sock_path = sock_path
        self.my_pid = my_pid
        self.trace_enabled = trace_enabled
        self.local_port: Optional[Port] = None
        self.recv_buf = bytearray()
        self.connected = True
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        # Brief retry loop in case the launcher is still bringing
        # oriscbar up.
        deadline = time.time() + 5.0
        while True:
            try:
                self.sock.connect(sock_path)
                break
            except (FileNotFoundError, ConnectionRefusedError) as e:
                if time.time() >= deadline:
                    raise SystemExit(
                        f"simorisc: could not connect to crossbar at "
                        f"{sock_path}: {e}")
                time.sleep(0.05)
        # Handshake.
        self.sock.sendall(struct.pack(">II", self.HELLO_MAGIC, my_pid))
        reply = self._recv_exact(8)
        magic, status = struct.unpack(">II", reply)
        if magic != self.HELLO_MAGIC or status != self.HELLO_OK:
            raise SystemExit(
                f"simorisc: crossbar handshake failed "
                f"(magic={magic:#x}, status={status:#x})")
        self.sock.setblocking(False)

    def _recv_exact(self, n: int) -> bytes:
        out = bytearray()
        while len(out) < n:
            chunk = self.sock.recv(n - len(out))
            if not chunk:
                raise SystemExit("simorisc: crossbar closed during handshake")
            out.extend(chunk)
        return bytes(out)

    def attach_port(self, pid: int, port: Port) -> None:
        if pid != self.my_pid:
            raise ValueError(f"SocketCrossbar can only host pid={self.my_pid}, "
                             f"not pid={pid}")
        self.local_port = port

    def send_packet(self, packet: bytes) -> None:
        try:
            self.sock.sendall(struct.pack(">I", len(packet)) + packet)
        except OSError as e:
            print(f"simorisc: socket send failed: {e}", file=sys.stderr)
            return
        if self.trace_enabled:
            self._trace_outgoing(packet)

    def poll_incoming(self) -> bool:
        worked = False
        while True:
            try:
                chunk = self.sock.recv(65536)
            except (BlockingIOError, InterruptedError):
                break
            except OSError:
                self.connected = False
                break
            if not chunk:
                self.connected = False
                break
            self.recv_buf.extend(chunk)
            worked = True
        while len(self.recv_buf) >= 4:
            (length,) = struct.unpack(">I", bytes(self.recv_buf[:4]))
            if len(self.recv_buf) < 4 + length:
                break
            packet = bytes(self.recv_buf[4:4 + length])
            del self.recv_buf[:4 + length]
            if self.trace_enabled:
                self._trace_incoming(packet)
            if self.local_port is not None:
                self.local_port.receive_packet(packet)
            worked = True
        return worked

    def _trace_outgoing(self, packet: bytes) -> None:
        try:
            p = unpack_packet(packet)
            print(f"  ; CROSSBAR(socket) tx -> CPU{p['dst_pid']} "
                  f"type=0x{p['type']:02x} bytes={packet.hex()}", file=sys.stderr)
        except ValueError:
            print(f"  ; CROSSBAR(socket) tx malformed bytes={packet.hex()}",
                  file=sys.stderr)

    def _trace_incoming(self, packet: bytes) -> None:
        try:
            p = unpack_packet(packet)
            print(f"  ; CROSSBAR(socket) rx <- CPU{p['src_pid']} "
                  f"type=0x{p['type']:02x} bytes={packet.hex()}", file=sys.stderr)
        except ValueError:
            print(f"  ; CROSSBAR(socket) rx malformed bytes={packet.hex()}",
                  file=sys.stderr)

    def close(self) -> None:
        try:
            self.sock.close()
        except OSError:
            pass


class InProcessCrossbar(Crossbar):
    """Default implementation: an in-memory routing table. Each call to
    `send_packet` immediately delivers to the destination Port's
    `receive_packet`. No latency model, no flow control, no real link
    arbitration — just direct dispatch sufficient for ISA-level
    simulation."""
    def __init__(self, trace_enabled: bool = False):
        self.ports: Dict[int, Port] = {}
        self.trace_enabled = trace_enabled

    def attach_port(self, pid: int, port: Port) -> None:
        self.ports[pid] = port

    def send_packet(self, packet: bytes) -> None:
        try:
            pkt = unpack_packet(packet)
        except ValueError as e:
            if self.trace_enabled:
                print(f"  ; CROSSBAR drop (malformed): {e}", file=sys.stderr)
            return
        dst = pkt["dst_pid"]
        if dst not in self.ports:
            if self.trace_enabled:
                print(f"  ; CROSSBAR drop: dst CPU{dst} not connected",
                      file=sys.stderr)
            return
        if self.trace_enabled:
            self._trace(packet, pkt)
        self.ports[dst].receive_packet(packet)

    def _trace(self, packet: bytes, pkt: Dict) -> None:
        type_name = {
            PKT_OBJ_READ_REQ:    "OBJ_READ_REQ",
            PKT_OBJ_READ_RESP:   "OBJ_READ_RESP",
            PKT_OBJ_WRITE_REQ:   "OBJ_WRITE_REQ",
            PKT_OBJ_WRITE_RESP:  "OBJ_WRITE_RESP",
            PKT_SEND_DELIVER:    "SEND_DELIVER",
            PKT_TASK_WAIT_REQ:   "TASK_WAIT_REQ",
            PKT_TASK_WAIT_RESP:  "TASK_WAIT_RESP",
            PKT_TASK_QUERY_REQ:  "TASK_QUERY_REQ",
            PKT_TASK_QUERY_RESP: "TASK_QUERY_RESP",
            PKT_TASK_KILL_REQ:   "TASK_KILL_REQ",
            PKT_TASK_KILL_RESP:  "TASK_KILL_RESP",
        }.get(pkt["type"], f"type=0x{pkt['type']:02x}")
        print(f"  ; CROSSBAR CPU{pkt['src_pid']} -> CPU{pkt['dst_pid']} "
              f"{type_name} trans={pkt['trans_id']} len={len(pkt['payload'])}w "
              f"bytes={packet.hex()}", file=sys.stderr)


# ---------------------------------------------------------------------------
# CPU state (per-processor)
# ---------------------------------------------------------------------------

class CPU(Port):
    def __init__(self, pid: int = 0, system: Optional['System'] = None):
        self.pid      = pid
        self.system   = system

        self.gpr      = [0] * 32          # R0..R31, R0 hardwired zero
        self.opr      = [0] * 16          # O0..O15, O0 hardwired null
        self.hi       = 0
        self.lo       = 0
        self.pc       = 0
        self.next_pc  = 0
        self.cycles   = 0

        # Object table — local to this processor; remote references are
        # routed through System.lookup_remote_descriptor().
        self.descriptors: List[Optional[Descriptor]] = [None]  # idx 0 reserved
        self.next_obj_idx = 1
        # Reusable freed-slot list (FIFO); generation already incremented.
        self.free_indices: List[int] = []

        # Page-table substitute: VA range -> (descriptor index, base offset, prot).
        self.mappings: List[Tuple[int,int,int,int,int]] = []

        # Multi-CPU bookkeeping.
        self.active = False                  # True when a task is running
        self.exit_code: Optional[int] = None # set by TaskExit
        # inbox holds raw SEND_DELIVER packet bytes per Volume IV. The
        # crossbar deposits packets here; dispatch_handler pops bytes,
        # parses to a PendingSend, and runs the registered handler.
        # Per-object queues installed by ReceiveQueueAttach hold packet
        # bytes too (in Descriptor.queue).
        self.inbox: List[bytes] = []
        # Wire-level request/response queues for OBJ_READ/WRITE traffic.
        # `requests` holds OBJ_READ_REQ / OBJ_WRITE_REQ packets that this
        # CPU is the home of; the scheduler drains them autonomously each
        # tick (the CPU's "memory controller"). `responses` holds the
        # corresponding *_RESP packets addressed to this CPU as the
        # original issuer; a blocked CPU watches these for matching
        # trans_ids.
        self.requests:  List[bytes] = []
        self.responses: List[bytes] = []
        self.boot_state: Optional[Dict] = None  # snapshot used to relaunch handler tasks
        self.blocked_on: Optional[BlockedSignal] = None  # poll/response wait state
        self.next_trans_id = 0               # per-CPU SEND/OL/OS transaction id counter
        # Set to True by primitives that have already moved PC into the
        # right place (InstallProgram, TaskYield, TaskExit-with-successor)
        # so the CALL dispatch site won't bump it past the redirect.
        self._call_redirected_pc = False

        # Preemption plumbing (Phase 35). `in_trap_handler` is True
        # between deliver_trap and the next ERET; while it's set,
        # TaskYield-from-the-handler doesn't context-switch
        # immediately (which would lose the trap's saved state).
        # Instead it sets `yield_pending`, and ERET honors it by
        # picking the next runnable task before resuming user mode.
        # The trapping task's user state was checkpointed into its
        # Task struct on trap delivery so the swap is clean.
        self.in_trap_handler = False
        self.yield_pending   = False

        # Pending deferred frees (Volume VI primitive #0x107,
        # ObjFreeDeferred). Each entry is (deadline_seconds, idx);
        # entries fire in run() once `time.time() >= deadline_seconds`,
        # at which point the descriptor is freed normally. The
        # descriptor stays live (answers OBJ_READ_REQs) while waiting,
        # which is the whole point — gives an in-flight async SEND's
        # receiver time to finish reading the bytes before they
        # disappear. Same idiom as RESET_DRAIN_SECONDS for chunkboot.
        self.deferred_frees: List[Tuple[float, int]] = []

        # Task scheduling state. `current_task` is what's running on this
        # CPU right now; `tasks` is every Task ever created here keyed by
        # its descriptor index; `runnable` is the round-robin queue of
        # ready-to-run tasks not currently running. Populated by
        # init_cpu (bootstrap task) and TaskCreate.
        self.current_task: Optional['Task'] = None
        self.tasks:    Dict[int, 'Task'] = {}
        self.runnable: List['Task'] = []

        # Privilege state (Volume II Section 13). Mode defaults to
        # supervisor — this preserves the pre-privilege-modes behaviour
        # of every existing program: shells, the chunkboot loader,
        # everything that calls MapObject / InstallHandler / InstallProgram
        # boots as supervisor and keeps working. main() honours --mode to
        # override per-program (and per-CPU on reset).
        self.mode = MODE_SUPERVISOR
        # ERET destination, written by trap delivery (deliver_trap) and
        # consumed by ERET. saved_pc is also exposed as the EPC control
        # register; saved_mode lives in STATUS bits [3:2] when read out.
        self.saved_mode = MODE_SUPERVISOR
        self.saved_pc   = 0

        # Architecturally visible control registers populated by trap
        # delivery (Volume II Section 14). VECBASE is supplied by
        # firmware via SCTRL; CAUSE / BADVADDR are written when a trap
        # is delivered to a vector and read by the handler via LCTRL.
        self.vecbase     = 0
        self.cause_reg   = 0
        self.badvaddr_reg = 0

        # Supervisor-installable trap handlers (Volume VI primitive
        # #0x520, InstallTrapHandler). Per-CPU map cause → handler VA;
        # consulted by deliver_trap before falling back to VECBASE.
        # Handlers run in supervisor mode. The handler VA may not be
        # mapped in the trapping task's address space (e.g., a shell
        # registers a handler in its own code; a guest task it spawned
        # later traps), so deliver_trap swaps in the mappings the
        # supervisor had at install time, then load_task_to_cpu on
        # ERET restores the trapping task's mappings.
        self.trap_handlers: Dict[int, int] = {}
        self.trap_handler_mappings: Dict[int, List[Tuple[int,int,int,int,int]]] = {}

        # Timer interrupt state (Volume V Section 2.10 — COMPARE).
        # `compare_reg` is the cycle-counter target; when cycles >=
        # compare and STATUS.IE is set, the simulator raises an
        # external-interrupt trap once and clears IE so the handler
        # runs without immediately re-firing. Setting compare_reg=0
        # disables the timer (the default).
        self.compare_reg = 0
        self.status_ie   = False    # bit 4 of STATUS

        # Trace control.
        self.trace_enabled = False

    # ---- Port interface -----------------------------------------------------

    def receive_packet(self, packet: bytes) -> None:
        """Crossbar entry point. Decode the packet's type and route it to
        the appropriate per-CPU queue: SEND_DELIVER goes to a
        descriptor's receive queue if attached, else to the inbox; object
        memory requests/responses go to the requests/responses queues."""
        try:
            pkt = unpack_packet(packet)
        except ValueError:
            return
        t = pkt["type"]
        if t == PKT_SEND_DELIVER:
            try:
                recipient_ref, _, _ = parse_send_deliver(pkt)
            except ValueError:
                return
            idx = ref_index(recipient_ref)
            if 0 < idx < len(self.descriptors) and \
                    self.descriptors[idx] is not None and \
                    self.descriptors[idx].queue is not None:
                desc = self.descriptors[idx]
                if len(desc.queue) >= desc.queue_max_depth:
                    return  # full; drop
                desc.queue.append(packet)
            else:
                self.inbox.append(packet)
        elif t in (PKT_OBJ_READ_REQ, PKT_OBJ_WRITE_REQ,
                   PKT_TASK_WAIT_REQ, PKT_TASK_QUERY_REQ, PKT_TASK_KILL_REQ):
            # All home-side request packets land in `requests` and get
            # serviced by _process_requests on the home CPU's tick.
            self.requests.append(packet)
        elif t in (PKT_OBJ_READ_RESP, PKT_OBJ_WRITE_RESP,
                   PKT_TASK_WAIT_RESP, PKT_TASK_QUERY_RESP, PKT_TASK_KILL_RESP):
            # All issuer-side response packets land in `responses` and
            # get matched against cpu.blocked_on (or task.blocked_on for
            # parked tasks) by trans_id.
            self.responses.append(packet)
        # Other packet types currently dropped silently (e.g., DESC_*,
        # LINK_*); future revisions may dispatch them here too.

    # ---- GPR/OR helpers -----------------------------------------------------

    def set_gpr(self, idx: int, val: int) -> None:
        if idx == 0:
            return
        self.gpr[idx] = val & 0xFFFFFFFF

    def get_gpr(self, idx: int) -> int:
        return self.gpr[idx] & 0xFFFFFFFF

    def set_opr(self, idx: int, val: int) -> None:
        if idx == 0:
            return  # O0 hardwired null
        self.opr[idx] = val & 0xFFFFFFFFFFFFFFFF

    def get_opr(self, idx: int) -> int:
        return self.opr[idx] & 0xFFFFFFFFFFFFFFFF

    # ---- privileged control registers (Volume V Section 2.10) ---------------

    def ctrl_read(self, idx: int) -> int:
        """LCTRL fetch. The simulator backs the architecturally visible
        subset; firmware-only registers controlling the (absent) TLB,
        object table, and crossbar route are read-as-zero.

        STATUS layout (simulator-defined; spec leaves bit assignment to
        Volume V): bits [1:0] = current mode, bits [3:2] = saved mode,
        bit 4 = IE (interrupt enable, gates the timer-interrupt path)."""
        if   idx == CTRL_STATUS:
            return ((self.mode & 0x3) |
                    ((self.saved_mode & 0x3) << 2) |
                    ((1 if self.status_ie else 0) << 4))
        elif idx == CTRL_CAUSE:    return self.cause_reg & 0xFFFFFFFF
        elif idx == CTRL_EPC:      return self.saved_pc & 0xFFFFFFFF
        elif idx == CTRL_BADVADDR: return self.badvaddr_reg & 0xFFFFFFFF
        elif idx == CTRL_CONTEXT:  return 0
        elif idx == CTRL_COUNT:    return self.cycles & 0xFFFFFFFF
        elif idx == CTRL_COMPARE:  return self.compare_reg & 0xFFFFFFFF
        elif idx == CTRL_PROCID:   return self.pid & 0xFFFFFFFF
        elif idx == CTRL_VECBASE:  return self.vecbase & 0xFFFFFFFF
        return 0

    def ctrl_write(self, idx: int, val: int) -> None:
        """SCTRL store. PROCID is read-only (writes silently ignored, per
        Volume V). STATUS writes update both the current mode bits
        (immediate effect — how supervisor code self-demotes) and the
        saved-mode bits (consumed by the next ERET — how supervisor
        sets up an ERET-into-user-mode hand-off after preparing EPC)."""
        v = val & 0xFFFFFFFF
        if   idx == CTRL_STATUS:
            self.mode = v & 0x3
            self.saved_mode = (v >> 2) & 0x3
            self.status_ie = bool((v >> 4) & 0x1)
        elif idx == CTRL_CAUSE:    self.cause_reg = v
        elif idx == CTRL_EPC:      self.saved_pc = v
        elif idx == CTRL_BADVADDR: self.badvaddr_reg = v
        elif idx == CTRL_COMPARE:  self.compare_reg = v
        elif idx == CTRL_VECBASE:  self.vecbase = v
        # CONTEXT / COUNT: writable in spec but no architectural effect
        # in this simulator yet. PROCID and the remaining firmware-only
        # registers: ignore.

    # ---- object table -------------------------------------------------------

    def alloc_object(self, size: int, type_tag: int, max_caps: int,
                     init_bytes: Optional[bytes] = None,
                     objstore: bool = False) -> int:
        """Allocate an object on this CPU; return its reference (caps =
        max_caps; home = self.pid). When `objstore` is True the descriptor
        is flagged as OR-typed: integer OL/OS trap on it, and only
        OREFLD/OREFST can read or write its storage."""
        storage = bytearray(size)
        if init_bytes is not None:
            storage[:len(init_bytes)] = init_bytes
        if self.free_indices:
            idx = self.free_indices.pop(0)
            # Carry the bumped generation forward.
            prior_gen = self.descriptors[idx].generation if self.descriptors[idx] else 1
            desc = Descriptor(storage=storage, length=size,
                              generation=prior_gen, type_tag=type_tag,
                              max_caps=max_caps, objstore=objstore)
            self.descriptors[idx] = desc
        else:
            desc = Descriptor(storage=storage, length=size,
                              generation=1, type_tag=type_tag,
                              max_caps=max_caps, objstore=objstore)
            idx = self.next_obj_idx
            self.next_obj_idx += 1
            self.descriptors.append(desc)
        return make_ref(generation=desc.generation, home=self.pid,
                        index=idx, caps=max_caps)

    def free_object(self, idx: int) -> None:
        """Bump the generation and mark the slot freed; callers are
        responsible for capability checks."""
        d = self.descriptors[idx]
        if d is None:
            return
        d.generation = (d.generation + 1) & 0xFFFF
        if d.generation == 0:
            d.generation = 1   # avoid the all-zero-fields-=-null collision
        d.live = False
        # Keep slot in self.descriptors so the bumped generation persists;
        # mark it freed via .live = False, and recycle through free_indices.
        self.free_indices.append(idx)

    def map_object(self, ref: int, va: int, offset: int, length: int,
                   prot: int) -> None:
        """Install a VA->object mapping for general-register loads/stores."""
        idx = ref_index(ref)
        self.mappings.append((va, va + length, idx, offset, prot))

    def lookup_va(self, va: int, width: int, want_prot: int,
                  is_fetch: bool, faulting_pc: int) -> Tuple[Descriptor, int]:
        """Translate a virtual address to (local descriptor, object_offset)."""
        if width in (2, 4) and (va & (width - 1)):
            raise Trap(
                CAUSE_ADDR_MISALIGN_I if is_fetch else CAUSE_ADDR_MISALIGN_D,
                faulting_pc,
                f"VA 0x{va:08x} not aligned to {width}")
        for (lo, hi, idx, base, prot) in self.mappings:
            if lo <= va < hi and va + width <= hi:
                if (prot & want_prot) != want_prot:
                    raise Trap(CAUSE_PAGE_PERMISSION, faulting_pc,
                               f"VA 0x{va:08x} prot {prot:#x} lacks {want_prot:#x}")
                return self.descriptors[idx], base + (va - lo)
        raise Trap(
            CAUSE_TLB_MISS_I if is_fetch else CAUSE_TLB_MISS_D,
            faulting_pc,
            f"unmapped VA 0x{va:08x}")

    # ---- memory access -------------------------------------------------------

    def fetch_instr(self, pc: int) -> int:
        desc, off = self.lookup_va(pc, 4, CAP_X, is_fetch=True, faulting_pc=pc)
        return struct.unpack(">I", bytes(desc.storage[off:off+4]))[0]

    def load_gpr_mem(self, va: int, width: int, signed: bool,
                     faulting_pc: int) -> int:
        desc, off = self.lookup_va(va, width, CAP_R, is_fetch=False,
                                   faulting_pc=faulting_pc)
        raw = bytes(desc.storage[off:off+width])
        if   width == 1: val = raw[0]
        elif width == 2: val = struct.unpack(">H", raw)[0]
        elif width == 4: val = struct.unpack(">I", raw)[0]
        else: raise AssertionError("width")
        if signed:
            sign = 1 << (width * 8 - 1)
            if val & sign:
                val -= (1 << (width * 8))
            val &= 0xFFFFFFFF
        return val

    def store_gpr_mem(self, va: int, width: int, val: int,
                      faulting_pc: int) -> None:
        desc, off = self.lookup_va(va, width, CAP_W, is_fetch=False,
                                   faulting_pc=faulting_pc)
        if   width == 1: desc.storage[off] = val & 0xFF
        elif width == 2: desc.storage[off:off+2] = struct.pack(">H", val & 0xFFFF)
        elif width == 4: desc.storage[off:off+4] = struct.pack(">I", val & 0xFFFFFFFF)
        else: raise AssertionError("width")

    # ---- object register access ---------------------------------------------

    def deref_obj(self, oreg_idx: int, offset: int, width: int,
                  required_cap: int, faulting_pc: int,
                  *, expect_objstore: bool = False) -> Tuple[Descriptor, int, int]:
        """Validate (null/stale/bounds/cap/storage-type) an OL/OS or
        OREFLD/OREFST reference and return (descriptor, byte offset in
        storage, home_pid). When `expect_objstore` is True (OREFLD/OREFST
        path) the descriptor's `objstore` flag must be set; when False
        (integer OL/OS path) the flag must be clear. A mismatch traps
        capability-violation."""
        ref = self.get_opr(oreg_idx)
        if ref == 0:
            raise Trap(CAUSE_NULL_DEREF, faulting_pc,
                       f"null O{oreg_idx} dereference")

        # Caps check uses the issuing reference's caps field; the home's
        # max_caps is the upper bound but not checked here (it was checked
        # at allocation/derivation).
        if (ref_caps(ref) & required_cap) != required_cap:
            raise Trap(CAUSE_CAP_VIOLATION, faulting_pc,
                       f"O{oreg_idx} caps {ref_caps(ref):#x} lacks {required_cap:#x}")

        home = ref_home(ref)
        if self.system is None or home == self.pid:
            descriptors = self.descriptors
        else:
            target = self.system.cpus[home]
            descriptors = target.descriptors

        idx = ref_index(ref)
        if idx >= len(descriptors) or descriptors[idx] is None:
            raise Trap(CAUSE_STALE_REF, faulting_pc,
                       f"O{oreg_idx} index {idx} out of range on CPU {home}")
        desc = descriptors[idx]
        if not desc.live or desc.generation != ref_generation(ref):
            raise Trap(CAUSE_STALE_REF, faulting_pc,
                       f"O{oreg_idx} generation {ref_generation(ref)} != "
                       f"descriptor {desc.generation}")

        if desc.objstore != expect_objstore:
            kind = "OR-typed (OBJSTORE)" if desc.objstore else "byte-typed"
            wanted = "OBJSTORE" if expect_objstore else "byte-typed"
            raise Trap(CAUSE_CAP_VIOLATION, faulting_pc,
                       f"O{oreg_idx} storage is {kind}; access requires {wanted}")

        if offset < 0 or offset + width > desc.length or width <= 0:
            raise Trap(CAUSE_BOUNDS, faulting_pc,
                       f"O{oreg_idx} offset {offset} width {width} "
                       f"outside [0,{desc.length})")
        if width in (2, 4, 8) and (offset & (width - 1)):
            raise Trap(CAUSE_ADDR_MISALIGN_D, faulting_pc,
                       f"O{oreg_idx} offset {offset} not aligned to {width}")
        return desc, offset, home

    def inspect_obj(self, oreg_idx: int, faulting_pc: int) -> Tuple[Descriptor, int]:
        """Look up an object's descriptor for the inspection ops (OLEN, OTAG,
        OHOME, OCAP). Only checks null + stale, no caps or bounds. Returns
        (descriptor, home_pid). The OHOME caller wants the home directly
        (stored already in the ref); other callers just want the descriptor."""
        ref = self.get_opr(oreg_idx)
        if ref == 0:
            raise Trap(CAUSE_NULL_DEREF, faulting_pc, f"O{oreg_idx} null on inspect")
        home = ref_home(ref)
        if self.system is None or home == self.pid:
            descriptors = self.descriptors
        else:
            descriptors = self.system.cpus[home].descriptors
        idx = ref_index(ref)
        if idx >= len(descriptors) or descriptors[idx] is None:
            raise Trap(CAUSE_STALE_REF, faulting_pc, f"O{oreg_idx} stale on inspect")
        desc = descriptors[idx]
        if not desc.live or desc.generation != ref_generation(ref):
            raise Trap(CAUSE_STALE_REF, faulting_pc, f"O{oreg_idx} stale on inspect")
        return desc, home


# ---------------------------------------------------------------------------
# System (the crossbar + N CPUs)
# ---------------------------------------------------------------------------

class System:
    def __init__(self, n_cpus: int):
        self.cpus = [CPU(pid=i, system=self) for i in range(n_cpus)]
        self.n_cpus = n_cpus
        self.trace_enabled = False
        self.serve_mode = False    # if True, don't exit on idle (socket-server mode)
        self.crossbar: Crossbar = InProcessCrossbar()
        for cpu in self.cpus:
            self.crossbar.attach_port(cpu.pid, cpu)
        # Wall-clock zero-point for the TimeNow firmware primitive
        # (Vol VI #0x400). TimeNow returns microseconds since this
        # moment, so the simulator's sense of time matches the
        # outside world rather than a fictional clock. Captured here
        # so all CPUs in a multi-CPU System see the same epoch.
        self.boot_time = time.time()

    # ---- inter-CPU SEND queue ----------------------------------------------

    def queue_send(self, msg: PendingSend) -> None:
        """Serialize a PendingSend to a wire-format SEND_DELIVER packet and
        push it onto the crossbar. Routing (inbox vs descriptor queue) is
        the receiving CPU's responsibility — see CPU.receive_packet. In
        socket mode the local System has only one CPU; the crossbar
        validates that the destination is connected and drops otherwise."""
        home = ref_home(msg.recipient_ref)
        packet = msg.to_wire(dst_pid=home)
        self.crossbar.send_packet(packet)

    # ---- handler dispatch --------------------------------------------------

    def dispatch_handler(self, cpu: CPU) -> bool:
        """If `cpu` is idle and has a pending SEND, dispatch its handler as a
        fresh task. Returns True iff a handler was launched."""
        if cpu.active or not cpu.inbox:
            return False
        packet = cpu.inbox.pop(0)
        try:
            msg = PendingSend.from_wire(packet)
        except ValueError as e:
            if self.trace_enabled:
                print(f"  ; CPU{cpu.pid}: malformed inbox packet ({e}); dropped",
                      file=sys.stderr)
            return False
        idx = ref_index(msg.recipient_ref)
        if idx >= len(cpu.descriptors) or cpu.descriptors[idx] is None:
            if self.trace_enabled:
                print(f"  ; CPU{cpu.pid}: SEND_DELIVER for absent obj idx={idx} dropped",
                      file=sys.stderr)
            return False
        desc = cpu.descriptors[idx]
        if not desc.live or desc.generation != ref_generation(msg.recipient_ref):
            if self.trace_enabled:
                print(f"  ; CPU{cpu.pid}: SEND_DELIVER stale (gen mismatch) dropped",
                      file=sys.stderr)
            return False
        if desc.send_handler_ref == 0:
            if self.trace_enabled:
                print(f"  ; CPU{cpu.pid}: SEND_DELIVER to obj idx={idx} dropped (no handler)",
                      file=sys.stderr)
            return False

        # Restore the boot register snapshot, then overlay the handler-specific
        # registers per Volume III Section 7.2.
        snap = cpu.boot_state
        cpu.gpr = list(snap["gpr"])
        cpu.opr = list(snap["opr"])
        cpu.hi  = 0
        cpu.lo  = 0

        # O1 = fresh full-caps self-reference (firmware constructs).
        full_self = make_ref(generation=desc.generation, home=cpu.pid,
                             index=idx, caps=desc.max_caps)
        cpu.set_opr(1, full_self)
        # O2..O4 = first three OR payload args from the wire.
        for i, oref in enumerate(msg.or_payload[:3]):
            cpu.set_opr(2 + i, oref)
        # R4..R7 = integer payload from the wire.
        for i, val in enumerate(msg.int_payload[:4]):
            cpu.set_gpr(4 + i, val)

        # PC = handler VA computed at install time from the handler code
        # object's executable mapping. Loadable modules mapped at any VA
        # work transparently here; InstallHandler is responsible for
        # rejecting handlers whose offset is not in any executable mapping.
        cpu.pc = desc.send_handler_va & 0xFFFFFFFF
        cpu.next_pc = (cpu.pc + 4) & 0xFFFFFFFF
        cpu.active = True

        if self.trace_enabled:
            print(f"  ; CPU{cpu.pid}: dispatched handler at PC=0x{cpu.pc:08x} "
                  f"for obj idx={idx}",
                  file=sys.stderr)
        return True

    # ---- autonomous request handling ---------------------------------------

    def _process_requests(self, cpu: CPU) -> None:
        """Drain any OBJ_READ_REQ / OBJ_WRITE_REQ packets in this CPU's
        request queue, perform the bounds/cap/generation checks against
        the local descriptor table, and emit corresponding *_RESP packets
        to the originating CPU. This is the firmware/memory-controller
        contribution per Volume IV §4.1."""
        while cpu.requests:
            packet = cpu.requests.pop(0)
            try:
                pkt = unpack_packet(packet)
            except ValueError as e:
                if self.trace_enabled:
                    print(f"  ; CPU{cpu.pid}: malformed request packet ({e})",
                          file=sys.stderr)
                continue
            if pkt["type"] == PKT_OBJ_READ_REQ:
                self._handle_obj_read_req(cpu, pkt)
            elif pkt["type"] == PKT_OBJ_WRITE_REQ:
                self._handle_obj_write_req(cpu, pkt)
            elif pkt["type"] == PKT_TASK_WAIT_REQ:
                self._handle_task_wait_req(cpu, pkt)
            elif pkt["type"] == PKT_TASK_QUERY_REQ:
                self._handle_task_query_req(cpu, pkt)
            elif pkt["type"] == PKT_TASK_KILL_REQ:
                self._handle_task_kill_req(cpu, pkt)

    def _validate_at_home(self, cpu: CPU, ref: int, offset: int, width: int,
                          required_cap: int, expect_objstore: bool = False
                          ) -> Tuple[Optional[Descriptor], int]:
        """Run the home-side validation (Vol IV §4.1) and return
        (descriptor or None, fault_code). On fault `descriptor` is None
        and the caller responds with the fault code in flags."""
        idx = ref_index(ref)
        if idx >= len(cpu.descriptors) or cpu.descriptors[idx] is None:
            return None, RESP_STALE
        desc = cpu.descriptors[idx]
        if not desc.live or desc.generation != ref_generation(ref):
            return None, RESP_STALE
        if (ref_caps(ref) & required_cap) != required_cap:
            return None, RESP_CAP
        if desc.objstore != expect_objstore:
            return None, RESP_CAP
        if offset < 0 or offset + width > desc.length or width <= 0:
            return None, RESP_BOUNDS
        # Don't enforce offset/width alignment here: this validator is
        # called from _handle_obj_read_req / _handle_obj_write_req, which
        # serve arbitrary byte-stream device reads (e.g. oriscterm
        # fetching a 2-byte console-write payload at an odd offset).
        # CPU-side OL/OS instructions enforce VA alignment in
        # lookup_va, before they even issue an OBJ_READ_REQ, so adding
        # an alignment check here would only break legitimate device
        # traffic.
        return desc, RESP_OK

    def _handle_obj_read_req(self, cpu: CPU, pkt: Dict) -> None:
        p = pkt["payload"]
        ref = p[0] | (p[1] << 32)
        offset = p[2] if p[2] < 0x80000000 else p[2] - 0x100000000  # signed
        width = p[3]
        issuer = pkt["src_pid"]
        desc, fault = self._validate_at_home(cpu, ref, offset, width, CAP_R)
        if fault != RESP_OK:
            response = build_obj_read_resp(cpu.pid, issuer, pkt["trans_id"],
                                           fault, b'')
        else:
            data = bytes(desc.storage[offset:offset+width])
            response = build_obj_read_resp(cpu.pid, issuer, pkt["trans_id"],
                                           RESP_OK, data)
        self.crossbar.send_packet(response)

    def _handle_obj_write_req(self, cpu: CPU, pkt: Dict) -> None:
        p = pkt["payload"]
        ref = p[0] | (p[1] << 32)
        offset = p[2] if p[2] < 0x80000000 else p[2] - 0x100000000
        width = p[3]
        issuer = pkt["src_pid"]
        desc, fault = self._validate_at_home(cpu, ref, offset, width, CAP_W)
        if fault == RESP_OK:
            # Reconstruct data from payload words 4..end, take only `width` bytes.
            data_words = p[4:]
            raw = b''.join(struct.pack(">I", w & 0xFFFFFFFF) for w in data_words)
            desc.storage[offset:offset+width] = raw[:width]
        response = build_obj_write_resp(cpu.pid, issuer, pkt["trans_id"], fault)
        self.crossbar.send_packet(response)

    # ---- Phase 45d: remote Task primitive request handlers -----------------
    #
    # All three look up the target task from a 64-bit ref payload and
    # validate against this CPU's descriptor table. Validation uses the
    # same checks as _resolve_task_arg (descriptor exists, live,
    # generation matches, tagged TAG_TASK, present in cpu.tasks). On
    # validation failure we send the matching ERR_* in the response and
    # return immediately. On success the primitive logic runs locally.
    #
    # _resolve_remote_task returns (task, status). status == ERR_OK means
    # the task lookup succeeded; non-OK means we should return that
    # status without performing the operation.

    def _resolve_remote_task(self, cpu: CPU, ref: int) -> Tuple[Optional['Task'], int]:
        if ref == 0:
            return None, ERR_EFAULT
        if ref_home(ref) != cpu.pid:
            # Shouldn't happen — the originator wouldn't have routed
            # the request here if home didn't match cpu.pid. Treat as
            # ESTALE (nothing for us to find).
            return None, ERR_ESTALE
        idx = ref_index(ref)
        if idx <= 0 or idx >= len(cpu.descriptors) or cpu.descriptors[idx] is None:
            return None, ERR_ESTALE
        desc = cpu.descriptors[idx]
        if not desc.live or desc.generation != ref_generation(ref):
            return None, ERR_ESTALE
        if desc.type_tag != TAG_TASK or idx not in cpu.tasks:
            return None, ERR_EINVAL
        return cpu.tasks[idx], ERR_OK

    def _handle_task_wait_req(self, cpu: CPU, pkt: Dict) -> None:
        p = pkt["payload"]
        ref = p[0] | (p[1] << 32)
        issuer = pkt["src_pid"]
        trans_id = pkt["trans_id"]
        task, status = self._resolve_remote_task(cpu, ref)
        if status != ERR_OK:
            self.crossbar.send_packet(build_task_wait_resp(
                cpu.pid, issuer, trans_id, status, 0))
            return
        if task.state == TASK_STATE_EXITED:
            # Already exited — reply immediately with the exit code.
            self.crossbar.send_packet(build_task_wait_resp(
                cpu.pid, issuer, trans_id, ERR_OK, task.exit_code & 0xFF))
            return
        # Park the request as a remote waiter. _wake_waiters will pump
        # the response when this task transitions to EXITED (via either
        # primitive_TaskExit on the task itself or primitive_TaskKill
        # from anywhere).
        task.remote_waiters.append((issuer, trans_id))

    def _handle_task_query_req(self, cpu: CPU, pkt: Dict) -> None:
        p = pkt["payload"]
        ref = p[0] | (p[1] << 32)
        issuer = pkt["src_pid"]
        trans_id = pkt["trans_id"]
        task, status = self._resolve_remote_task(cpu, ref)
        if status != ERR_OK:
            self.crossbar.send_packet(build_task_query_resp(
                cpu.pid, issuer, trans_id, status, 0))
            return
        # Build the same packed state word primitive_TaskQuery does
        # (Vol VI #0x008): low 8 bits = state, next 8 = proc, upper
        # 16 = exit_code (only meaningful for EXITED).
        state = task.state & 0xFF
        proc  = cpu.pid & 0xFF
        code  = (task.exit_code or 0) & 0xFFFF \
                if task.state == TASK_STATE_EXITED else 0
        packed = state | (proc << 8) | (code << 16)
        self.crossbar.send_packet(build_task_query_resp(
            cpu.pid, issuer, trans_id, ERR_OK, packed))

    def _handle_task_kill_req(self, cpu: CPU, pkt: Dict) -> None:
        p = pkt["payload"]
        ref = p[0] | (p[1] << 32)
        exit_code = p[2] & 0xFF
        issuer = pkt["src_pid"]
        trans_id = pkt["trans_id"]
        task, status = self._resolve_remote_task(cpu, ref)
        if status != ERR_OK:
            self.crossbar.send_packet(build_task_kill_resp(
                cpu.pid, issuer, trans_id, status))
            return
        # Local primitive_TaskKill rejects "kill yourself"; remote
        # callers can't BE the target (different CPU), so the only
        # protective check that still applies is "kill of an already-
        # EXITED task is a no-op (idempotent)" — same as the local path.
        if task.state == TASK_STATE_EXITED:
            self.crossbar.send_packet(build_task_kill_resp(
                cpu.pid, issuer, trans_id, ERR_OK))
            return
        # Drop the target from anywhere it might be parked, mirroring
        # primitive_TaskKill.
        if task.state == TASK_STATE_RUNNABLE:
            try:
                cpu.runnable.remove(task)
            except ValueError:
                pass
        was_current = (task is cpu.current_task)
        task.blocked_on = None
        task.state      = TASK_STATE_EXITED
        task.exit_code  = exit_code
        if was_current:
            # The home CPU was running this task at the moment we
            # killed it. Step it off the CPU now: pick another
            # runnable, context-switch, and (if there's nothing
            # else to run) park on BlockedOnExitWait so the CPU
            # stays alive to answer in-flight requests until the
            # scheduler finds something else to schedule. This
            # mirrors what primitive_TaskExit does when a task
            # exits itself, except triggered by a remote SEND
            # rather than a local CALL.
            cpu.current_task = None
            cpu.active = False
            nxt = pick_next_runnable(cpu)
            if nxt is not None:
                context_switch(cpu, nxt)
            elif any(t.state == TASK_STATE_BLOCKED
                     for t in cpu.tasks.values()):
                cpu.blocked_on = BlockedOnExitWait()
        _wake_waiters(cpu, task)
        self.crossbar.send_packet(build_task_kill_resp(
            cpu.pid, issuer, trans_id, ERR_OK))

    # ---- blocked-CPU resume ------------------------------------------------

    def _wake_blocked_tasks(self, cpu: 'CPU') -> None:
        """Scan tasks that are BLOCKED-but-not-current; if their
        IPC condition is now satisfied (matching response in
        cpu.responses, or non-empty queue), promote them to
        RUNNABLE and queue them up for the scheduler. The actual
        unblock (writing the result registers, advancing PC) happens
        in the existing _try_unblock path once the task is
        scheduled back and cpu.blocked_on holds its signal again.

        Read-only against cpu state — no responses consumed, no
        descriptor queues popped. Phase 36."""
        for task in cpu.tasks.values():
            if task.state != TASK_STATE_BLOCKED:
                continue
            if task is cpu.current_task:
                continue   # current_task's blocked_on lives on the CPU
            b = task.blocked_on
            if b is None:
                continue
            ready = False
            if isinstance(b, (BlockedOnResponse, BlockedOnTaskWait,
                              BlockedOnTaskQuery, BlockedOnTaskKill,
                              BlockedOnObjFetch)):
                # All four "wait for a response packet by trans_id"
                # signals share the same readiness condition: a matching
                # packet sitting in cpu.responses. The actual delivery
                # (R2/R3 fill, PC advance) happens in _try_unblock once
                # this task is current again.
                for packet in cpu.responses:
                    try:
                        pkt = unpack_packet(packet)
                    except ValueError:
                        continue
                    if pkt['trans_id'] == b.trans_id:
                        ready = True
                        break
            elif isinstance(b, BlockedOnQueue):
                idx = b.descriptor_idx
                if 0 < idx < len(cpu.descriptors) \
                        and cpu.descriptors[idx] is not None \
                        and cpu.descriptors[idx].queue \
                        and len(cpu.descriptors[idx].queue) > 0:
                    ready = True
                # Skip the timeout-decrement path — non-current
                # tasks don't tick down. Practical for the shell
                # case where the blocking call is term_getkey
                # (infinite timeout); user code that needs strict
                # timeout semantics should stay current.
            if ready:
                task.state = TASK_STATE_RUNNABLE
                cpu.runnable.append(task)

    def _try_unblock(self, cpu: CPU) -> bool:
        """Resume a blocked CPU if its wait condition is now satisfied.
        Returns True if the CPU made progress (delivered a message,
        advanced past a fault, or decremented a timeout)."""
        b = cpu.blocked_on
        if isinstance(b, BlockedOnQueue):
            return self._try_unblock_queue(cpu, b)
        if isinstance(b, BlockedOnResponse):
            return self._try_unblock_response(cpu, b)
        if isinstance(b, BlockedOnTaskWait):
            return self._try_unblock_task_resp(cpu, b, PKT_TASK_WAIT_RESP,
                                                deliver_r3=True)
        if isinstance(b, BlockedOnTaskQuery):
            return self._try_unblock_task_resp(cpu, b, PKT_TASK_QUERY_RESP,
                                                deliver_r3=True)
        if isinstance(b, BlockedOnTaskKill):
            return self._try_unblock_task_resp(cpu, b, PKT_TASK_KILL_RESP,
                                                deliver_r3=False)
        if isinstance(b, BlockedOnObjFetch):
            return self._try_unblock_obj_fetch(cpu, b)
        if isinstance(b, BlockedOnObjStore):
            return self._try_unblock_obj_store(cpu, b)
        return False

    def _try_unblock_queue(self, cpu: CPU, b: 'BlockedOnQueue') -> bool:
        idx = b.descriptor_idx
        if idx >= len(cpu.descriptors) or cpu.descriptors[idx] is None:
            cpu.set_gpr(2, ERR_ESTALE); cpu.set_gpr(3, 0)
            cpu.pc = (cpu.pc + 4) & 0xFFFFFFFF
            cpu.next_pc = (cpu.pc + 4) & 0xFFFFFFFF
            cpu.blocked_on = None
            return True
        desc = cpu.descriptors[idx]
        if desc.queue and len(desc.queue) > 0:
            _deliver_queue_msg(cpu, desc.queue.pop(0))
            cpu.pc = (cpu.pc + 4) & 0xFFFFFFFF
            cpu.next_pc = (cpu.pc + 4) & 0xFFFFFFFF
            cpu.blocked_on = None
            return True
        if b.timeout < 0:
            return False    # infinite wait, nothing to do this tick
        b.timeout -= 1
        if b.timeout <= 0:
            cpu.set_gpr(2, ERR_ETIMEOUT); cpu.set_gpr(3, 0)
            cpu.pc = (cpu.pc + 4) & 0xFFFFFFFF
            cpu.next_pc = (cpu.pc + 4) & 0xFFFFFFFF
            cpu.blocked_on = None
            return True
        return True   # decremented the timer

    def _try_unblock_response(self, cpu: CPU, b: 'BlockedOnResponse') -> bool:
        """Look for a response packet matching this CPU's outstanding
        request trans_id; on match either deliver into the destination
        register (read) or simply ack (write), then advance PC. On a
        non-OK response flag, raise the corresponding architectural
        Trap (which the scheduler catches)."""
        for i, packet in enumerate(cpu.responses):
            try:
                pkt = unpack_packet(packet)
            except ValueError:
                continue
            if pkt["trans_id"] != b.trans_id:
                continue
            cpu.responses.pop(i)
            flags = pkt["flags"] & 0x3F
            if flags != RESP_OK:
                cpu.blocked_on = None
                cause = RESP_FLAG_TO_CAUSE.get(flags, CAUSE_BUS_ERROR_D)
                raise Trap(cause, cpu.pc,
                           f"remote O{'S' if b.is_write else 'L'} fault "
                           f"flags={flags:#x}")
            if not b.is_write:
                # Reassemble the loaded value from the response data words.
                payload = pkt["payload"]
                raw = b''.join(struct.pack(">I", w & 0xFFFFFFFF) for w in payload)
                raw = raw[:b.width]
                v = int.from_bytes(raw, "big")
                if b.signed and v & (1 << (b.width*8 - 1)):
                    v -= 1 << (b.width*8)
                cpu.set_gpr(b.target_reg, to_u32(v))
            cpu.pc = (cpu.pc + 4) & 0xFFFFFFFF
            cpu.next_pc = (cpu.pc + 4) & 0xFFFFFFFF
            cpu.blocked_on = None
            return True
        return False  # no matching response yet

    def _try_unblock_obj_fetch(self, cpu: CPU, b: 'BlockedOnObjFetch') -> bool:
        """Phase 45e. Handler for ObjFetchBytes responses. The response
        is a regular OBJ_READ_RESP (we reuse the existing wire packet
        instead of inventing a new type — it already carries the bytes
        in its payload), matched by trans_id. On RESP_OK we copy the
        payload into the local destination descriptor at the offset
        the primitive recorded; on a fault flag we map RESP_* to ERR_*
        and leave the destination untouched. R2 = status, R3 = bytes
        copied (== b.byte_count on OK, 0 on fault), PC advances."""
        for i, packet in enumerate(cpu.responses):
            try:
                pkt = unpack_packet(packet)
            except ValueError:
                continue
            if pkt['type'] != PKT_OBJ_READ_RESP:
                continue
            if pkt['trans_id'] != b.trans_id:
                continue
            cpu.responses.pop(i)
            flags = pkt['flags'] & 0x3F
            if flags != RESP_OK:
                # Map RESP_* fault to ERR_* status; same translation
                # OL/OS uses to raise an architectural Trap, but here
                # we surface it as an ordinary primitive return code
                # so the caller can recover (it's a polled bulk read,
                # not a CPU-instruction load).
                err_map = {
                    RESP_STALE:     ERR_ESTALE,
                    RESP_BOUNDS:    ERR_EINVAL,
                    RESP_CAP:       ERR_EPERM,
                    RESP_BUS_ERROR: ERR_EFAULT,
                }
                cpu.set_gpr(2, err_map.get(flags, ERR_EFAULT))
                cpu.set_gpr(3, 0)
            else:
                payload = pkt['payload']
                raw = b''.join(struct.pack(">I", w & 0xFFFFFFFF)
                               for w in payload)
                raw = raw[:b.byte_count]
                # Re-validate the destination descriptor — the caller
                # may have ObjFreed it between issuing the request and
                # the response arriving (unlikely but possible if a
                # signal handler runs in between).
                desc = cpu.descriptors[b.dst_idx] \
                       if 0 < b.dst_idx < len(cpu.descriptors) else None
                if desc is None or not desc.live:
                    cpu.set_gpr(2, ERR_ESTALE); cpu.set_gpr(3, 0)
                else:
                    desc.storage[b.dst_off:b.dst_off+b.byte_count] = raw
                    cpu.set_gpr(2, ERR_OK)
                    cpu.set_gpr(3, b.byte_count)
            cpu.pc = (cpu.pc + 4) & 0xFFFFFFFF
            cpu.next_pc = (cpu.pc + 4) & 0xFFFFFFFF
            cpu.blocked_on = None
            return True
        return False

    def _try_unblock_obj_store(self, cpu: CPU, b: 'BlockedOnObjStore') -> bool:
        """Phase 59. Mirror of _try_unblock_obj_fetch for ObjStoreBytes.
        The response is an OBJ_WRITE_RESP — no payload, just a flags
        byte.  On RESP_OK: R2 = ERR_OK, R3 = byte_count.  On fault:
        R2 = mapped ERR_*, R3 = 0.  Same RESP_* → ERR_* mapping
        ObjFetchBytes uses, since the failure modes (stale ref,
        out-of-bounds offset, missing W cap, etc.) are symmetric
        across read and write."""
        for i, packet in enumerate(cpu.responses):
            try:
                pkt = unpack_packet(packet)
            except ValueError:
                continue
            if pkt['type'] != PKT_OBJ_WRITE_RESP:
                continue
            if pkt['trans_id'] != b.trans_id:
                continue
            cpu.responses.pop(i)
            flags = pkt['flags'] & 0x3F
            if flags != RESP_OK:
                err_map = {
                    RESP_STALE:     ERR_ESTALE,
                    RESP_BOUNDS:    ERR_EINVAL,
                    RESP_CAP:       ERR_EPERM,
                    RESP_BUS_ERROR: ERR_EFAULT,
                }
                cpu.set_gpr(2, err_map.get(flags, ERR_EFAULT))
                cpu.set_gpr(3, 0)
            else:
                cpu.set_gpr(2, ERR_OK)
                cpu.set_gpr(3, b.byte_count)
            cpu.pc = (cpu.pc + 4) & 0xFFFFFFFF
            cpu.next_pc = (cpu.pc + 4) & 0xFFFFFFFF
            cpu.blocked_on = None
            return True
        return False

    def _try_unblock_task_resp(self, cpu: CPU, b: 'BlockedSignal',
                                expected_type: int, deliver_r3: bool) -> bool:
        """Phase 45d. Unified handler for the three new
        BlockedOnTask{Wait,Query,Kill} signals — they share a wire
        layout (status word in payload[0], optional secondary word in
        payload[1]). Match by trans_id, deliver R2 = status, R3 =
        secondary (when `deliver_r3`), advance PC, clear blocked_on.

        For TASK_KILL_RESP `deliver_r3` is False — the architectural
        TaskKill returns only a status in R2 (Vol VI #0x00A) and we
        don't want to clobber R3 from whatever the program had there.
        """
        for i, packet in enumerate(cpu.responses):
            try:
                pkt = unpack_packet(packet)
            except ValueError:
                continue
            if pkt["type"] != expected_type:
                continue
            if pkt["trans_id"] != b.trans_id:
                continue
            cpu.responses.pop(i)
            payload = pkt["payload"]
            status = payload[0] if payload else ERR_EFAULT
            cpu.set_gpr(2, status & 0xFFFFFFFF)
            if deliver_r3:
                secondary = payload[1] if len(payload) >= 2 else 0
                cpu.set_gpr(3, secondary & 0xFFFFFFFF)
            cpu.pc = (cpu.pc + 4) & 0xFFFFFFFF
            cpu.next_pc = (cpu.pc + 4) & 0xFFFFFFFF
            cpu.blocked_on = None
            return True
        return False  # no matching response yet

    # ---- scheduler ---------------------------------------------------------

    def run(self, max_cycles: int) -> int:
        """Round-robin one instruction per active CPU per tick; dispatch
        handler tasks on idle CPUs with queued SENDs. Returns the exit code
        of CPU 0 (or of whichever CPU last exited if CPU 0 didn't run).

        `max_cycles == 0` means unlimited — the loop runs until the
        natural exit conditions fire (TaskExitSignal with no remaining
        work, or socket EOF in --connect mode). The default 10M cap is
        there as a CI safety net for runaway tests, not as a real
        budget for interactive use."""
        ticks = 0
        while max_cycles == 0 or ticks < max_cycles:
            any_progress = False
            # Drain incoming bytes from the crossbar transport (no-op for
            # InProcessCrossbar). This must happen before per-CPU work so
            # that responses arriving via socket are visible this tick.
            if self.crossbar.poll_incoming():
                any_progress = True
            # Then, drain inbound OBJ_READ_REQ / OBJ_WRITE_REQ packets on
            # every CPU. This represents the home processor's autonomous
            # memory-controller behaviour and runs regardless of the CPU's
            # task state — even idle or blocked CPUs answer remote reads.
            for cpu in self.cpus:
                if cpu.requests:
                    self._process_requests(cpu)
                    any_progress = True
            # Process any ObjFreeDeferred (#0x107) deadlines that have
            # elapsed. The descriptor stayed live up to this point so
            # late OBJ_READ_REQs from receivers (oriscterm, hostfsd)
            # could still be answered; now we tear it down for real.
            now = time.time()
            for cpu in self.cpus:
                if cpu.deferred_frees:
                    survivors = []
                    for (deadline, idx) in cpu.deferred_frees:
                        if now >= deadline:
                            if 0 < idx < len(cpu.descriptors) \
                                    and cpu.descriptors[idx] is not None \
                                    and cpu.descriptors[idx].live:
                                cpu.free_object(idx)
                            any_progress = True
                        else:
                            survivors.append((deadline, idx))
                    cpu.deferred_frees = survivors
            for cpu in self.cpus:
                # Wake any non-current BLOCKED tasks whose unblock
                # condition is now satisfied (the response landed,
                # the queue got a SEND); they go back to RUNNABLE for
                # the scheduler to pick. The actual unblock work
                # (writing R2/R3, advancing PC) happens when the task
                # is next scheduled and cpu.blocked_on is processed.
                self._wake_blocked_tasks(cpu)
                # Blocked CPUs: see if their queue/response is now ready
                # and resume past the CALL or OL/OS accordingly.
                if cpu.blocked_on is not None:
                    try:
                        if self._try_unblock(cpu):
                            any_progress = True
                    except Trap as t:
                        if deliver_trap(cpu, t):
                            any_progress = True
                            continue
                        report_trap(cpu, t)
                        return 3
                    # Still blocked? If there's another runnable task on
                    # this CPU, switch to it — the blocked task's
                    # blocked_on is preserved in its Task struct via
                    # save_cpu_to_task and will be reinstated when it's
                    # scheduled back. (Phase 36 — blocked-task preemption.)
                    if cpu.blocked_on is not None and cpu.runnable:
                        cur = cpu.current_task
                        nxt = pick_next_runnable(cpu)
                        if nxt is not None and nxt is not cur:
                            if cur is not None and cur.state != TASK_STATE_EXITED:
                                # Park the live current task as BLOCKED;
                                # save_cpu_to_task captures cpu.blocked_on
                                # so its wait state is restored when it's
                                # scheduled back. EXITED tasks just stay
                                # EXITED — nothing to save and we don't
                                # want to flip them to BLOCKED.
                                cur.state = TASK_STATE_BLOCKED
                                save_cpu_to_task(cpu, cur)
                            load_task_to_cpu(cpu, nxt)
                            nxt.state = TASK_STATE_RUNNING
                            cpu.current_task = nxt
                            any_progress = True
                    continue
                if cpu.active:
                    try:
                        step(cpu)
                    except BlockedSignal as b:
                        # Raised mid-instruction (e.g., remote OL/OS).
                        # PC is unchanged; the scheduler will resume
                        # from the same instruction once the response
                        # arrives.
                        cpu.blocked_on = b
                        any_progress = True
                        continue
                    except TaskExitSignal as e:
                        if getattr(cpu, "reset_on_exit", False):
                            # MVP "tiny OS": this CPU is a reusable
                            # program slot. The guest just TaskExited;
                            # we'll wipe state and re-run the loader.
                            # But: if the guest's last act was a
                            # term_print SEND, the receiver may still
                            # be issuing OBJ_READ_REQs against the
                            # guest's data descriptor — wiping
                            # immediately would lose those bytes.
                            # Defer the actual reset until a wall-
                            # clock deadline; meanwhile
                            # _process_requests answers in-flight
                            # reads against the still-valid descriptor
                            # table.
                            cpu.active = False
                            cpu.exit_code = e.code & 0xFF
                            cpu.reset_at_time = time.time() + RESET_DRAIN_SECONDS
                            any_progress = True
                            continue
                        cpu.active = False
                        cpu.exit_code = e.code & 0xFF
                        # Snapshot state at TaskExit so any handlers that
                        # subsequently dispatch on this CPU inherit the
                        # environment main configured (e.g., O5..O15
                        # carrying refs to other objects). Architecturally
                        # the handler is a fresh task; this snapshot is the
                        # firmware/loader's contribution to its initial
                        # register state, atop which the SEND payload is
                        # overlaid by Volume III Section 7.2.
                        cpu.boot_state = {
                            "gpr": list(cpu.gpr),
                            "opr": list(cpu.opr),
                            "code_va_base": cpu.boot_state["code_va_base"],
                        }
                    except Trap as t:
                        if deliver_trap(cpu, t):
                            any_progress = True
                            continue
                        report_trap(cpu, t)
                        return 3
                    any_progress = True
                else:
                    # Inactive CPU: either it's draining toward a
                    # deferred reset (the wall-clock deadline gates
                    # this; while waiting, _process_requests above
                    # still answers in-flight reads), or it has
                    # handler dispatch work to do.
                    if getattr(cpu, "reset_at_time", 0) > 0:
                        if time.time() >= cpu.reset_at_time:
                            cpu.reset_at_time = 0
                            reset_cpu(cpu)
                            any_progress = True
                        # else: don't set any_progress — let the run
                        # loop's idle-sleep give us 1ms ticks while
                        # we wait for the deadline.
                    elif self.dispatch_handler(cpu):
                        any_progress = True
            if not any_progress:
                # Stay alive if any of: (a) the user asked us to serve
                # forever via --serve, (b) we're in socket mode and at
                # least one CPU is blocked waiting on something the
                # socket might deliver, or (c) a CPU is draining
                # toward a deferred reset and may yet receive
                # in-flight OBJ_READ_REQs. In all cases, exit when
                # the socket has EOF'd.
                in_socket_mode = hasattr(self.crossbar, 'connected')
                waiting_blocked = any(
                    cpu.blocked_on is not None for cpu in self.cpus)
                draining = any(
                    getattr(cpu, "reset_at_time", 0) > 0 for cpu in self.cpus)
                # Pending ObjFreeDeferred deadlines deliberately do NOT
                # keep the loop alive: if the system has otherwise gone
                # idle (e.g., the shell typed `exit`), the host process
                # is winding down and the OS reclaims everything. Frees
                # only matter while there's an active CPU around to
                # service incoming OBJ_READ_REQs against the not-yet-
                # freed descriptor; in that case the active CPU itself
                # already keeps the loop alive via any_progress.
                if self.serve_mode or (in_socket_mode and waiting_blocked) \
                        or (in_socket_mode and draining):
                    if in_socket_mode and not self.crossbar.connected:
                        break
                    time.sleep(0.001)
                    ticks += 1
                    # Phase 60 — pump the host display worker on idle
                    # ticks too, so a screen with no firmware activity
                    # still processes Tk events (window-close, expose,
                    # etc.).
                    for cpu in self.cpus:
                        w = getattr(cpu, "display_worker", None)
                        if w is not None:
                            w.tick()
                    continue
                break
            ticks += 1
            # Phase 60 — pump host display workers each progress tick.
            # Internally throttled to ~60 Hz so rapid bursts of
            # ObjStoreBytes don't repaint per cycle.
            for cpu in self.cpus:
                w = getattr(cpu, "display_worker", None)
                if w is not None:
                    w.tick()
        else:
            print(f"simorisc: max cycles exceeded ({max_cycles})", file=sys.stderr)
            return 2

        # Determine exit code: prefer CPU 0's exit, else first non-None.
        for cpu in self.cpus:
            if cpu.exit_code is not None:
                return cpu.exit_code
        return 0


