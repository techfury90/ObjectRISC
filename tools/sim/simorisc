# Loader (CONTRACT.md Section 1 + 2)
# ---------------------------------------------------------------------------

DEFAULT_STACK_SIZE = 0x10000

# Wall-clock seconds a --reset-on-exit CPU spends in a "drain" phase
# between TaskExit and the actual reset. During this window the CPU
# doesn't fetch instructions, but _process_requests still answers any
# in-flight OBJ_READ_REQs from receivers (e.g., oriscterm fetching
# the bytes of the guest's last term_print). Sized for a few-process
# Tk-mediated SEND→OBJ_READ_REQ round trip with some slack.
RESET_DRAIN_SECONDS = 0.5

def load_orx_file(path: str) -> Tuple[bytes, bytes, int, int]:
    """Parse an .orx file and return (text_bytes, data_bytes, entry_offset,
    stack_size)."""
    with open(path, "rb") as f:
        data = f.read()
    if len(data) < 0x20:
        sys.exit(f"simorisc: {path}: file too short for header")
    if data[:8] != MAGIC:
        sys.exit(f"simorisc: {path}: bad magic (got {data[:8]!r}, want {MAGIC!r})")
    version, flags, entry, text_size, data_size, stack_size = \
        struct.unpack(">IIIIII", data[0x08:0x20])
    if version != 1:
        sys.exit(f"simorisc: {path}: unsupported format version {version}")
    if text_size % 4 != 0:
        sys.exit(f"simorisc: {path}: text_size {text_size} not multiple of 4")
    expected = 0x20 + text_size + data_size
    if len(data) != expected:
        sys.exit(f"simorisc: {path}: file size {len(data)} != header-implied {expected}")
    if entry >= text_size or entry % 4 != 0:
        sys.exit(f"simorisc: {path}: bad entry offset {entry:#x} for text size {text_size:#x}")
    text_bytes = data[0x20:0x20 + text_size]
    data_bytes = data[0x20 + text_size:0x20 + text_size + data_size]
    if stack_size == 0:
        stack_size = DEFAULT_STACK_SIZE
    return text_bytes, data_bytes, entry, stack_size


CODE_VA = 0x00010000
DATA_VA = 0x00040000
ARGV_VA = 0x000A0000
STACK_TOP = 0x00200000


def init_cpu(cpu: CPU, text_bytes: bytes, data_bytes: bytes,
             entry: int, stack_size: int) -> None:
    """Allocate code/stack/(data) on `cpu` and prime its initial register state.
    Service objects (and the cross-CPU O5..O5+N-2 refs) are populated by
    System.populate_service_objects() after every CPU has been initialized."""
    text_size = len(text_bytes)
    data_size = len(data_bytes)

    code_ref  = cpu.alloc_object(text_size, type_tag=TAG_CODE,
                                 max_caps=CAP_R|CAP_X|CAP_C,
                                 init_bytes=text_bytes)
    stack_ref = cpu.alloc_object(stack_size, type_tag=TAG_STACK,
                                 max_caps=CAP_R|CAP_W|CAP_C)
    if data_size > 0:
        # Data REF stays R|C (CONTRACT §3) — OCAP and direct
        # OSB-through-O3 see the historical caps. But the MAPPING
        # gets R|W so VA-based stores to global variables work,
        # which C programs need (Dhrystone, the shell's cwd[],
        # anything with mutable file-scope data). The split is
        # intentional in OR: refs carry max-allowed caps, mappings
        # carry actually-exposed caps. UB programs that mutate
        # string literals via VA writes will silently succeed —
        # the MVP toolchain doesn't separate .rodata from .data.
        data_ref = cpu.alloc_object(data_size, type_tag=TAG_DATA,
                                    max_caps=CAP_R|CAP_C,
                                    init_bytes=data_bytes)
    else:
        data_ref = 0

    cpu.map_object(code_ref,  va=CODE_VA, offset=0,
                   length=text_size,  prot=CAP_R|CAP_X)
    cpu.map_object(stack_ref, va=STACK_TOP - stack_size, offset=0,
                   length=stack_size, prot=CAP_R|CAP_W)
    if data_size > 0:
        cpu.map_object(data_ref, va=DATA_VA, offset=0,
                       length=data_size, prot=CAP_R|CAP_W)

    cpu.set_opr(1, code_ref)
    cpu.set_opr(2, stack_ref)
    cpu.set_opr(3, data_ref)
    cpu.set_gpr(7, cpu.pid)            # PROCID by contract
    cpu.set_gpr(29, STACK_TOP - 16)    # SP
    cpu.set_gpr(30, 0)                 # FP
    cpu.set_gpr(31, 0)                 # RA

    cpu.pc = CODE_VA + entry
    cpu.next_pc = cpu.pc + 4
    cpu.active = True

    # Wrap the just-primed CPU state into a bootstrap Task struct so the
    # scheduler has a current_task to swap out when (if) the program
    # ever creates a child task and yields. Single-task programs never
    # touch this Task — they TaskExit, run loop sees no successor, and
    # tears the CPU down via TaskExitSignal as it always has.
    make_bootstrap_task(cpu, code_ref, stack_ref)


def populate_service_objects(system: System) -> None:
    """Allocate one service object per CPU (in multi-CPU mode), then hand
    each CPU references to its own (full caps in O4) and to the others
    (R+S only, in O5..O5+N-2 in PID-skipping-self order)."""
    if system.n_cpus < 2:
        return
    service_refs = []
    for cpu in system.cpus:
        ref = cpu.alloc_object(SERVICE_OBJ_SIZE, type_tag=TAG_SERVICE,
                               max_caps=CAP_R|CAP_W|CAP_S|CAP_V|CAP_C)
        service_refs.append(ref)

    for cpu in system.cpus:
        # O4 = my own service object, full caps.
        cpu.set_opr(4, service_refs[cpu.pid])
        # O5..O5+N-2 = other CPUs' services, R+S only.
        slot = 5
        for other_pid in range(system.n_cpus):
            if other_pid == cpu.pid:
                continue
            full_ref = service_refs[other_pid]
            weak = make_ref(generation=ref_generation(full_ref),
                            home=ref_home(full_ref),
                            index=ref_index(full_ref),
                            caps=CAP_R|CAP_S)
            cpu.set_opr(slot, weak)
            slot += 1


def snapshot_boot_state(cpu: CPU) -> None:
    """Record the post-init register state so handler dispatch can restore
    it before overlaying the SEND payload."""
    cpu.boot_state = {
        "gpr": list(cpu.gpr),
        "opr": list(cpu.opr),
        "code_va_base": CODE_VA,
    }


def reset_cpu(cpu: CPU) -> None:
    """Wipe `cpu` back to fresh boot state and re-run init from the saved
    boot args. Used by --reset-on-exit: when a non-leader CPU running the
    chunkboot loader hits TaskExit, we don't terminate the process; we
    re-init so the loader runs again and can boot the next program.

    Crossbar connection, PID, and trace settings persist across reset.

    The previous run's exit code (the byte the guest passed to
    TaskExit) is smuggled into the new R6 so the chunkboot loader
    can include it in its next "ready" announce — that's how
    linkbootd surfaces guest exit codes to the shell. R6 defaults
    to 0 on the very first boot (no prior run)."""
    args = cpu.reset_args   # set by main() once at startup
    prev_exit_code = cpu.exit_code if cpu.exit_code is not None else 0
    cpu.gpr            = [0] * 32
    cpu.opr            = [0] * 16
    cpu.hi             = 0
    cpu.lo             = 0
    cpu.pc             = 0
    cpu.next_pc        = 0
    cpu.descriptors    = [None]
    cpu.next_obj_idx   = 1
    cpu.free_indices   = []
    cpu.mappings       = []
    cpu.active         = False
    cpu.exit_code      = None
    cpu.inbox          = []
    cpu.requests       = []
    cpu.responses      = []
    cpu.boot_state     = None
    cpu.blocked_on     = None
    cpu.next_trans_id  = 0
    cpu.reset_at_time  = 0
    cpu.deferred_frees = []
    cpu.in_trap_handler = False
    cpu.yield_pending  = False
    cpu.current_task   = None
    cpu.tasks          = {}
    cpu.runnable       = []
    init_cpu(cpu, args["text"], args["data"], args["entry"], args["stack_size"])
    init_r4 = args.get("init_r4", 0)
    if init_r4:
        cpu.set_gpr(4, init_r4 & 0xFFFFFFFF)
    populate_self_service(cpu)
    install_external_services(cpu, args["services"])
    snapshot_boot_state(cpu)
    cpu.set_gpr(6, prev_exit_code & 0xFF)
    # Restore the boot-time privilege mode so a CPU rebooted under
    # --mode=user comes back as user, not the supervisor default.
    cpu.mode = getattr(cpu, "initial_mode", MODE_SUPERVISOR)


# ---------------------------------------------------------------------------
# Task scheduling (Volume VI Section 4)
# ---------------------------------------------------------------------------

def alloc_task_descriptor(cpu: CPU) -> int:
    """Reserve an object-table slot for a Task ref. The Task struct is
    stored separately in cpu.tasks; the descriptor exists so SEND, OREFLD,
    and other ref-bearing operations have something to identify the task
    by. Storage is empty (length 0) — the task lives in Python state."""
    ref = cpu.alloc_object(0, type_tag=TAG_TASK,
                           max_caps=CAP_R | CAP_V | CAP_C)
    return ref_index(ref)


def task_ref_for(cpu: CPU, task: 'Task', caps: int = CAP_R | CAP_V | CAP_C) -> int:
    """Manufacture a ref to `task` with the requested caps."""
    desc = cpu.descriptors[task.descriptor_idx]
    return make_ref(generation=desc.generation, home=cpu.pid,
                    index=task.descriptor_idx, caps=caps)


def save_cpu_to_task(cpu: CPU, task: 'Task') -> None:
    """Copy the running task's CPU-resident state out to its Task struct
    in preparation for a context switch. Called on the *outgoing* task
    just before load_task_to_cpu paints in the incoming one."""
    task.gpr          = cpu.gpr.copy()
    task.opr          = cpu.opr.copy()
    task.hi           = cpu.hi
    task.lo           = cpu.lo
    task.pc           = cpu.pc
    task.next_pc      = cpu.next_pc
    task.mode         = cpu.mode
    task.saved_mode   = cpu.saved_mode
    task.saved_pc     = cpu.saved_pc
    task.cause_reg    = cpu.cause_reg
    task.badvaddr_reg = cpu.badvaddr_reg
    task.mappings     = list(cpu.mappings)
    task.blocked_on   = cpu.blocked_on


def load_task_to_cpu(cpu: CPU, task: 'Task') -> None:
    """Paint the incoming task's saved state onto the CPU. Mirror of
    save_cpu_to_task; together they implement the context switch."""
    cpu.gpr          = task.gpr.copy()
    cpu.opr          = task.opr.copy()
    cpu.hi           = task.hi
    cpu.lo           = task.lo
    cpu.pc           = task.pc
    cpu.next_pc      = task.next_pc
    cpu.mode         = task.mode
    cpu.saved_mode   = task.saved_mode
    cpu.saved_pc     = task.saved_pc
    cpu.cause_reg    = task.cause_reg
    cpu.badvaddr_reg = task.badvaddr_reg
    cpu.mappings     = list(task.mappings)
    cpu.blocked_on   = task.blocked_on


def context_switch(cpu: CPU, next_task: 'Task') -> None:
    """Swap the running task. The outgoing task's state is saved to its
    Task struct; the incoming task's state is painted onto the CPU. The
    caller is responsible for having set the outgoing task's state field
    appropriately (RUNNABLE for yield, EXITED for exit) and for queuing
    it back on cpu.runnable if it should run again. The CALL dispatch
    site is told to skip its post-call PC advance (the new task's PC is
    already where it should be)."""
    outgoing = cpu.current_task
    if outgoing is not None:
        save_cpu_to_task(cpu, outgoing)
    load_task_to_cpu(cpu, next_task)
    next_task.state = TASK_STATE_RUNNING
    cpu.current_task = next_task
    cpu._call_redirected_pc = True


def pick_next_runnable(cpu: CPU) -> Optional['Task']:
    """Pop the next runnable task from the round-robin queue, or return
    None if the queue is empty."""
    return cpu.runnable.pop(0) if cpu.runnable else None


def make_bootstrap_task(cpu: CPU, code_ref: int, stack_ref: int) -> 'Task':
    """After init_cpu has primed the CPU's register file and mappings,
    capture them into a Task struct so the scheduler has something to
    save out when a context switch eventually happens. The CPU and the
    bootstrap task share their initial state by construction; the Task
    struct is the home of that state once a context switch occurs."""
    task = Task(descriptor_idx=alloc_task_descriptor(cpu),
                code_ref=code_ref, stack_ref=stack_ref,
                state=TASK_STATE_RUNNING)
    save_cpu_to_task(cpu, task)
    cpu.tasks[task.descriptor_idx] = task
    cpu.current_task = task
    return task


# ---------------------------------------------------------------------------
# Firmware primitive dispatch
# ---------------------------------------------------------------------------

def primitive_TaskCreate(cpu: CPU) -> None:
    """Create a task with its own address space and prime its register
    state. The new task starts in the NEW state — TaskResume moves it
    onto the runnable queue. Standard layout: code at CODE_VA (R+X),
    stack at STACK_TOP (R+W), data at DATA_VA (R+W) when O3 is
    non-null, and an args/argv buffer at ARGV_VA (R-only) when O4 is
    non-null — same VAs as init_cpu so pcc-generated code that
    assumes flat addresses Just Works in the child."""
    code_ref  = cpu.get_opr(1)
    stack_ref = cpu.get_opr(2)
    data_ref  = cpu.get_opr(3)              # optional; 0 = no data segment
    args_ref  = cpu.get_opr(4)              # optional; 0 = no args buffer
    entry     = cpu.get_gpr(4) & 0xFFFFFFFF
    init_r4   = cpu.get_gpr(5) & 0xFFFFFFFF
    if entry & 0x80000000:
        entry -= 0x100000000

    if code_ref == 0 or stack_ref == 0:
        cpu.set_gpr(2, ERR_EFAULT); return
    if ref_home(code_ref) != cpu.pid or ref_home(stack_ref) != cpu.pid:
        cpu.set_gpr(2, ERR_EREMOTE); return
    if (ref_caps(code_ref) & CAP_X) == 0:
        cpu.set_gpr(2, ERR_EPERM); return
    if (ref_caps(stack_ref) & (CAP_R | CAP_W)) != (CAP_R | CAP_W):
        cpu.set_gpr(2, ERR_EPERM); return
    code_idx, stack_idx = ref_index(code_ref), ref_index(stack_ref)
    for idx in (code_idx, stack_idx):
        if idx >= len(cpu.descriptors) or cpu.descriptors[idx] is None \
                or not cpu.descriptors[idx].live:
            cpu.set_gpr(2, ERR_ESTALE); return
    code_desc, stack_desc = cpu.descriptors[code_idx], cpu.descriptors[stack_idx]
    if code_desc.generation != ref_generation(code_ref) \
            or stack_desc.generation != ref_generation(stack_ref):
        cpu.set_gpr(2, ERR_ESTALE); return
    if entry < 0 or entry >= code_desc.length:
        cpu.set_gpr(2, ERR_EINVAL); return

    data_idx, data_desc = None, None
    if data_ref != 0:
        if ref_home(data_ref) != cpu.pid:
            cpu.set_gpr(2, ERR_EREMOTE); return
        if (ref_caps(data_ref) & CAP_R) == 0:
            cpu.set_gpr(2, ERR_EPERM); return
        data_idx = ref_index(data_ref)
        if data_idx >= len(cpu.descriptors) or cpu.descriptors[data_idx] is None \
                or not cpu.descriptors[data_idx].live:
            cpu.set_gpr(2, ERR_ESTALE); return
        data_desc = cpu.descriptors[data_idx]
        if data_desc.generation != ref_generation(data_ref):
            cpu.set_gpr(2, ERR_ESTALE); return

    args_idx, args_desc = None, None
    if args_ref != 0:
        if ref_home(args_ref) != cpu.pid:
            cpu.set_gpr(2, ERR_EREMOTE); return
        if (ref_caps(args_ref) & CAP_R) == 0:
            cpu.set_gpr(2, ERR_EPERM); return
        args_idx = ref_index(args_ref)
        if args_idx >= len(cpu.descriptors) or cpu.descriptors[args_idx] is None \
                or not cpu.descriptors[args_idx].live:
            cpu.set_gpr(2, ERR_ESTALE); return
        args_desc = cpu.descriptors[args_idx]
        if args_desc.generation != ref_generation(args_ref):
            cpu.set_gpr(2, ERR_ESTALE); return

    task = Task(descriptor_idx=alloc_task_descriptor(cpu),
                code_ref=code_ref, stack_ref=stack_ref,
                state=TASK_STATE_NEW)
    task.mappings = [
        (CODE_VA, CODE_VA + code_desc.length, code_idx, 0,
         CAP_R | CAP_X),
        (STACK_TOP - stack_desc.length, STACK_TOP, stack_idx, 0,
         CAP_R | CAP_W),
    ]
    if data_idx is not None:
        # Match init_cpu: data is mapped R+W so guests can mutate
        # globals (the ref's caps may still be R-only — the
        # ref-vs-mapping cap split is intentional, see init_cpu).
        task.mappings.append(
            (DATA_VA, DATA_VA + data_desc.length, data_idx, 0,
             CAP_R | CAP_W))
    if args_idx is not None:
        # Argv buffer mapped R-only at ARGV_VA. Programs that want
        # their args grab them via the libc helper which dereferences
        # this VA. Programs that don't care just don't map and the
        # VA stays unmapped — accessing it would trap.
        task.mappings.append(
            (ARGV_VA, ARGV_VA + args_desc.length, args_idx, 0,
             CAP_R))
    task.pc      = (CODE_VA + entry) & 0xFFFFFFFF
    task.next_pc = (task.pc + 4)     & 0xFFFFFFFF
    # Child inherits the parent's object registers — that's how the
    # parent passes service refs (terminal, hostfsd, shared scratch)
    # without a separate handoff mechanism. Vol VI §4.1 doesn't pin
    # the child's initial OR state, so inheriting matches the typical
    # fork-style hand-off and matches snapshot_boot_state's pattern
    # for handler dispatch. O0 stays the null reference. Supervisor
    # that wants a clean slate can always overwrite afterwards.
    task.opr     = list(cpu.opr)
    task.opr[0]  = 0
    task.gpr[4]  = init_r4
    task.gpr[7]  = cpu.pid                    # PROCID by contract
    task.gpr[29] = STACK_TOP - 16             # SP
    # Inherit the parent's privilege mode by default; supervisor can
    # demote a child by SCTRL-ing the new task's saved state via... well,
    # there's no primitive for that yet. Today: same mode as parent.
    task.mode    = cpu.mode
    task.saved_mode = cpu.mode

    cpu.tasks[task.descriptor_idx] = task
    cpu.set_opr(1, task_ref_for(cpu, task))
    cpu.set_gpr(2, ERR_OK)


def _resolve_task_arg(cpu: CPU, require_v: bool = True) -> Optional['Task']:
    """Validate O1 as a task ref, return its Task or None (with R2 set).
    `require_v=False` skips the V-capability check — TaskWait/TaskQuery
    take a task ref of any caps per Volume VI §4.1."""
    ref = cpu.get_opr(1)
    if ref == 0:
        cpu.set_gpr(2, ERR_EFAULT); return None
    if ref_home(ref) != cpu.pid:
        cpu.set_gpr(2, ERR_EREMOTE); return None
    if require_v and (ref_caps(ref) & CAP_V) == 0:
        cpu.set_gpr(2, ERR_EPERM); return None
    idx = ref_index(ref)
    desc = cpu.descriptors[idx] if 0 < idx < len(cpu.descriptors) else None
    if desc is None or not desc.live or desc.generation != ref_generation(ref):
        cpu.set_gpr(2, ERR_ESTALE); return None
    if desc.type_tag != TAG_TASK or idx not in cpu.tasks:
        cpu.set_gpr(2, ERR_EINVAL); return None
    return cpu.tasks[idx]


def primitive_TaskResume(cpu: CPU) -> None:
    task = _resolve_task_arg(cpu)
    if task is None:
        return
    if task.state == TASK_STATE_RUNNING or task.state == TASK_STATE_EXITED:
        cpu.set_gpr(2, ERR_EBUSY); return
    if task.state in (TASK_STATE_RUNNABLE,):
        cpu.set_gpr(2, ERR_OK); return  # already queued; idempotent
    task.state = TASK_STATE_RUNNABLE
    cpu.runnable.append(task)
    cpu.set_gpr(2, ERR_OK)


def primitive_TaskSuspend(cpu: CPU) -> None:
    task = _resolve_task_arg(cpu)
    if task is None:
        return
    if task.state == TASK_STATE_EXITED:
        cpu.set_gpr(2, ERR_EINVAL); return
    if task.state == TASK_STATE_RUNNABLE:
        try:
            cpu.runnable.remove(task)
        except ValueError:
            pass
    task.state = TASK_STATE_SUSPENDED
    if task is cpu.current_task:
        # Self-suspend: pick another runnable. If none, we'd deadlock;
        # report EBUSY rather than wedge the CPU silently. Real OS would
        # pull from a wait queue / interrupt.
        nxt = pick_next_runnable(cpu)
        if nxt is None:
            cpu.set_gpr(2, ERR_EBUSY); return
        cpu.set_gpr(2, ERR_OK)
        # The suspended task sees R2=OK on resume.
        save_cpu_to_task(cpu, task)
        load_task_to_cpu(cpu, nxt)
        nxt.state = TASK_STATE_RUNNING
        cpu.current_task = nxt
        cpu._call_redirected_pc = True
        return
    cpu.set_gpr(2, ERR_OK)


def primitive_TaskYield(cpu: CPU, faulting_pc: int) -> None:
    """Voluntarily surrender the rest of the quantum. Round-robin: pop
    the next runnable, push the current onto the back of the queue, swap
    state. If nobody else is runnable, this is a no-op.

    When called from inside a trap handler (cpu.in_trap_handler set
    by deliver_trap), an immediate context_switch would save the
    handler's mid-execution state into the outgoing task struct and
    lose the trapped task's resume image. So instead we set
    yield_pending and return; ERET honors it on the way out, after
    reflecting any handler-side SCTRL of EPC/STATUS into the
    outgoing task's resume image. This is the deferred-yield idiom
    that makes timer-driven preemption safe."""
    if cpu.in_trap_handler:
        cpu.yield_pending = True
        cpu.set_gpr(2, ERR_OK)
        return

    nxt = pick_next_runnable(cpu)
    cur = cpu.current_task
    if nxt is None or nxt is cur:
        cpu.set_gpr(2, ERR_OK)
        return
    # The yielding task resumes at the instruction after the CALL. Bump
    # PC before save so its restored state lands there, not on the CALL.
    cpu.pc      = (faulting_pc + 4) & 0xFFFFFFFF
    cpu.next_pc = (cpu.pc + 4)      & 0xFFFFFFFF
    cpu.set_gpr(2, ERR_OK)            # what `cur` will see on resume
    cur.state = TASK_STATE_RUNNABLE
    cpu.runnable.append(cur)
    context_switch(cpu, nxt)


def primitive_TaskCurrent(cpu: CPU) -> None:
    cur = cpu.current_task
    if cur is None:
        cpu.set_opr(1, 0); cpu.set_gpr(2, ERR_OK); return
    cpu.set_opr(1, task_ref_for(cpu, cur))
    cpu.set_gpr(2, ERR_OK)


def _wake_waiters(cpu: CPU, exiting: 'Task') -> None:
    """Move every task parked on `exiting` from BLOCKED to RUNNABLE,
    seeding its R2/R3 (visible after context-switch back) with the
    TaskWait return values. Called from primitive_TaskExit before
    pick_next_runnable so wakeups are first-class scheduler citizens.

    Phase 45d: also drains exiting.remote_waiters by sending a
    TASK_WAIT_RESP (status=ERR_OK, exit_code) for each pending
    remote TaskWait request. The originating CPU's
    _try_unblock_task_wait will deliver into its waiter's R2/R3 and
    advance PC."""
    for w in exiting.waiters:
        if w.state != TASK_STATE_BLOCKED:
            continue
        w.gpr[2] = ERR_OK
        w.gpr[3] = exiting.exit_code & 0xFF
        w.state  = TASK_STATE_RUNNABLE
        cpu.runnable.append(w)
    exiting.waiters = []
    # Remote waiters: build + send a TASK_WAIT_RESP for each. The
    # exit_code is what the local waiters got above. cpu.system is
    # always non-None for tasks that arrived via TASK_WAIT_REQ
    # (single-CPU sim has no crossbar route in), but guard anyway
    # for forward compatibility / unit tests.
    if exiting.remote_waiters and cpu.system is not None:
        for (waiter_pid, trans_id) in exiting.remote_waiters:
            cpu.system.crossbar.send_packet(build_task_wait_resp(
                cpu.pid, waiter_pid, trans_id,
                ERR_OK, exiting.exit_code & 0xFF))
        exiting.remote_waiters = []


def primitive_TaskExit(cpu: CPU) -> None:
    """Terminate the calling task. Wake any tasks waiting on it, then
    context-switch to the next runnable. If nothing is runnable BUT
    there are still BLOCKED tasks (e.g., a shell parked in
    RecvQueuePoll waiting on a key), park the CPU on a sentinel
    BlockedOnExitWait so the run loop's _wake_blocked_tasks can
    eventually promote one and the blocked-but-runnable branch can
    pick it up. Only if no runnable AND no blocked tasks do we tear
    down the CPU via TaskExitSignal — that's the genuinely-finished
    case where there's nobody left to run."""
    code = cpu.get_gpr(4) & 0xFF
    cur = cpu.current_task
    if cur is not None:
        cur.state = TASK_STATE_EXITED
        cur.exit_code = code
        _wake_waiters(cpu, cur)
    nxt = pick_next_runnable(cpu)
    if nxt is not None:
        context_switch(cpu, nxt)
        return
    # Are there any tasks that might yet wake?
    has_blocked = any(t.state == TASK_STATE_BLOCKED for t in cpu.tasks.values())
    if has_blocked:
        # Park the CPU. The blocked-but-runnable branch in run() will
        # context_switch into the woken task. Until then, _process_requests
        # and _wake_blocked_tasks keep firing every loop tick.
        cpu.blocked_on = BlockedOnExitWait()
        return
    raise TaskExitSignal(code)


def primitive_TaskKill(cpu: CPU) -> None:
    """Volume VI §4.1 #0x00A. Externally terminate the named task. The
    target moves to EXITED with the supplied exit code, drops out of the
    runnable queue, releases any pending IPC wait, and wakes anyone
    blocked in TaskWait on it. The caller (a different task on the same
    CPU) continues normally — no context switch.

    Killing the calling task itself is rejected with EINVAL — that's
    what TaskExit is for. Killing an already-EXITED task is a no-op
    (idempotent, so a shell can `kill` a task that just finished racing
    a `wait` without erroring).

    Phase 45d: remote refs route via TASK_KILL_REQ — see
    _try_unblock_task_kill for the response side."""
    o1 = cpu.get_opr(1)
    if o1 != 0 and cpu.system is not None and ref_home(o1) != cpu.pid:
        code = cpu.get_gpr(4) & 0xFF
        trans_id = cpu.next_trans_id & 0xFFFF
        cpu.next_trans_id = (cpu.next_trans_id + 1) & 0xFFFF
        cpu.system.crossbar.send_packet(build_task_kill_req(
            cpu.pid, ref_home(o1), trans_id, o1, code))
        raise BlockedOnTaskKill(trans_id)

    target = _resolve_task_arg(cpu)
    if target is None:
        return
    if target is cpu.current_task:
        cpu.set_gpr(2, ERR_EINVAL); return
    if target.state == TASK_STATE_EXITED:
        cpu.set_gpr(2, ERR_OK); return
    code = cpu.get_gpr(4) & 0xFF
    # Drop the target from anywhere it might be parked. RUNNABLE tasks
    # live in cpu.runnable; BLOCKED tasks have a blocked_on saved in
    # their Task struct (Phase 36) — clearing it ensures a stale
    # _try_unblock attempt can't fire on a corpse if the queue/response
    # ever gets satisfied later.
    if target.state == TASK_STATE_RUNNABLE:
        try:
            cpu.runnable.remove(target)
        except ValueError:
            pass
    target.blocked_on = None
    target.state      = TASK_STATE_EXITED
    target.exit_code  = code
    _wake_waiters(cpu, target)
    cpu.set_gpr(2, ERR_OK)


def primitive_TaskQuery(cpu: CPU) -> None:
    """Volume VI §4.2 #0x008. Return summary information about a task:
    its state, the processor it lives on, and its exit code if it
    terminated. Non-blocking from the caller's POV in the local case;
    in the remote case the CPU still suspends at the CALL while the
    home formulates the response (typically a single tick), but
    architecturally it's still a one-shot query.

    Args:
      O1: task object reference (no V cap required, like TaskWait).

    Returns:
      R2: status (OK / EFAULT / EREMOTE / EPERM / ESTALE / EINVAL).
      R3: packed state word (low 8 bits = state per TASK_STATE_*,
          next 8 bits = processor id, upper 16 bits = exit code if
          state == TASK_STATE_EXITED, else 0).

    Phase 45d: remote refs route via TASK_QUERY_REQ — see
    _try_unblock_task_query for the response side."""
    o1 = cpu.get_opr(1)
    if o1 != 0 and cpu.system is not None and ref_home(o1) != cpu.pid:
        trans_id = cpu.next_trans_id & 0xFFFF
        cpu.next_trans_id = (cpu.next_trans_id + 1) & 0xFFFF
        cpu.system.crossbar.send_packet(build_task_query_req(
            cpu.pid, ref_home(o1), trans_id, o1))
        raise BlockedOnTaskQuery(trans_id)

    target = _resolve_task_arg(cpu, require_v=False)
    if target is None:
        return
    state = target.state & 0xFF
    proc  = cpu.pid & 0xFF
    code  = (target.exit_code or 0) & 0xFFFF \
            if target.state == TASK_STATE_EXITED else 0
    packed = state | (proc << 8) | (code << 16)
    cpu.set_gpr(2, ERR_OK)
    cpu.set_gpr(3, packed)


def primitive_TaskWait(cpu: CPU, faulting_pc: int) -> None:
    """Block the calling task until O1 has terminated. The exit code is
    returned in R3 (Volume VI §4.1). If O1 is already EXITED the call
    returns immediately.

    Phase 45d: when O1's home isn't this CPU, queue a TASK_WAIT_REQ on
    the home and raise BlockedOnTaskWait — the CALL stays at PC until
    the matching TASK_WAIT_RESP arrives, then _try_unblock_task_wait
    delivers status into R2 and exit_code into R3 and advances PC."""
    o1 = cpu.get_opr(1)
    if o1 != 0 and cpu.system is not None and ref_home(o1) != cpu.pid:
        # Remote target. Issuer-side fast-fail: ref must have V cap?
        # No — TaskWait is require_v=False per Vol VI §4.1, same as the
        # local path. Home does the descriptor check via
        # _resolve_remote_task. Issue the request and block.
        trans_id = cpu.next_trans_id & 0xFFFF
        cpu.next_trans_id = (cpu.next_trans_id + 1) & 0xFFFF
        cpu.system.crossbar.send_packet(build_task_wait_req(
            cpu.pid, ref_home(o1), trans_id, o1))
        raise BlockedOnTaskWait(trans_id)

    target = _resolve_task_arg(cpu, require_v=False)
    if target is None:
        return
    if target.state == TASK_STATE_EXITED:
        cpu.set_gpr(2, ERR_OK)
        cpu.set_gpr(3, target.exit_code & 0xFF)
        return
    cur = cpu.current_task
    if cur is None or cur is target:
        cpu.set_gpr(2, ERR_EINVAL); return
    # The waiter resumes at the instruction after the CALL. R2/R3 will
    # be overwritten by _wake_waiters when the target exits, so we don't
    # set them here. Bump PC before save so that's where it lands on
    # resume.
    cpu.pc      = (faulting_pc + 4) & 0xFFFFFFFF
    cpu.next_pc = (cpu.pc + 4)      & 0xFFFFFFFF
    cur.state = TASK_STATE_BLOCKED
    target.waiters.append(cur)
    nxt = pick_next_runnable(cpu)
    if nxt is not None:
        context_switch(cpu, nxt)
        return
    # No other runnable task — but the target itself, or some other
    # task, may yet wake on an external event (a wire packet, a key,
    # a remote response). Park the CPU idle: save `cur`'s state to
    # its Task struct (so when the target's eventual TaskExit fires
    # _wake_waiters, the gpr[2]=OK / gpr[3]=exit_code writes land in
    # the right place to be loaded back), set current_task=None to
    # signal "no task is running," and arm BlockedOnExitWait so the
    # run loop's idle-with-blocked-tasks branch keeps the CPU alive
    # to service in-flight wire requests.
    #
    # When `cur` later becomes RUNNABLE (added to cpu.runnable by
    # _wake_waiters), the run loop's blocked-but-runnable branch
    # picks it up: cur was None so the "nxt is not cur" condition
    # triggers a clean load_task_to_cpu, which paints cur's saved
    # gpr/pc/blocked_on (=None at save time, before we armed the
    # sentinel) onto the CPU and resumes past the CALL.
    #
    # (Phase 48 bugfix: the previous "return EBUSY when no other
    # runnable" policy was incorrect — TaskWait isn't deadlocked just
    # because the CPU is currently idle. login.orx hit this when its
    # task_wait(shell) ran AFTER the shell had already blocked in
    # term_getkey: pick_next_runnable was empty because shell was
    # BLOCKED, so login got EBUSY back, fell through orx_unload, and
    # spun the welcome-banner loop instead of waiting for shell to
    # exit.)
    has_blocked = any(t.state == TASK_STATE_BLOCKED for t in cpu.tasks.values())
    if has_blocked:
        save_cpu_to_task(cpu, cur)
        cpu.current_task = None
        cpu.blocked_on = BlockedOnExitWait()
        return
    # Genuinely nothing can wake — preserve the original EBUSY
    # semantics so a single-task program waiting on a never-runnable
    # peer gets a useful error.
    target.waiters.remove(cur)
    cur.state = TASK_STATE_RUNNING
    cpu.pc      = faulting_pc & 0xFFFFFFFF
    cpu.next_pc = (faulting_pc + 4) & 0xFFFFFFFF
    cpu.set_gpr(2, ERR_EBUSY)

def primitive_ReadCycles(cpu: CPU) -> None:
    cpu.set_gpr(2, 0)
    cpu.set_gpr(3, cpu.cycles & 0xFFFFFFFF)

def primitive_TimeNow(cpu: CPU) -> None:
    """Vol VI #0x400. Returns microseconds elapsed since the System's
    boot_time, low 32 bits in R3. The spec puts the high 32 bits in
    the side-channel buffer (Vol VI §11), but this firmware doesn't
    yet implement the side-channel; programs that need a 64-bit span
    will have to track epoch wraps themselves. 32-bit microseconds
    wrap at ~71.6 minutes — fine for benchmarks and typical
    interactive use."""
    if cpu.system is None:
        cpu.set_gpr(2, ERR_OK)
        cpu.set_gpr(3, 0)
        return
    elapsed = time.time() - cpu.system.boot_time
    micros = int(elapsed * 1_000_000) & 0xFFFFFFFFFFFFFFFF
    cpu.set_gpr(2, ERR_OK)
    cpu.set_gpr(3, micros & 0xFFFFFFFF)
    # High 32 bits would go to the side-channel; not implemented.

def primitive_ClockResolution(cpu: CPU) -> None:
    """Vol VI #0x410. Returns ticks per second of the clock TimeNow
    counts. Picked to be 1_000_000 (microseconds) — a 1980s-Unix-
    typical value, comfortably finer than anything Dhrystone or a
    cmd-line shell needs to measure."""
    cpu.set_gpr(2, ERR_OK)
    cpu.set_gpr(3, 1_000_000)

def primitive_ConsoleWrite(cpu: CPU, faulting_pc: int) -> None:
    o1   = cpu.get_opr(1)
    off  = cpu.get_gpr(4)
    n    = cpu.get_gpr(5)

    if o1 == 0:
        cpu.set_gpr(2, ERR_EFAULT); cpu.set_gpr(3, 0); return
    home = ref_home(o1)
    if cpu.system is None or home == cpu.pid:
        descriptors = cpu.descriptors
    else:
        descriptors = cpu.system.cpus[home].descriptors
    idx = ref_index(o1)
    if idx >= len(descriptors) or descriptors[idx] is None:
        cpu.set_gpr(2, ERR_ESTALE); cpu.set_gpr(3, 0); return
    desc = descriptors[idx]
    if not desc.live or desc.generation != ref_generation(o1):
        cpu.set_gpr(2, ERR_ESTALE); cpu.set_gpr(3, 0); return
    if (ref_caps(o1) & CAP_R) == 0:
        cpu.set_gpr(2, ERR_EPERM);  cpu.set_gpr(3, 0); return
    end = off + n
    if end < off or end > desc.length:
        cpu.set_gpr(2, ERR_EINVAL); cpu.set_gpr(3, 0); return
    payload = bytes(desc.storage[off:off+n])
    sys.stdout.buffer.write(payload)
    sys.stdout.flush()
    cpu.set_gpr(2, ERR_OK); cpu.set_gpr(3, n)

def primitive_ObjAlloc(cpu: CPU) -> None:
    length = cpu.get_gpr(4)
    type_tag = cpu.get_gpr(5) & 0xFFFF
    init_caps = cpu.get_gpr(6) & 0xFF
    if length == 0 or length > (1 << 24):
        cpu.set_gpr(2, ERR_EINVAL); cpu.set_opr(1, 0); return
    try:
        ref = cpu.alloc_object(length, type_tag=type_tag, max_caps=init_caps)
    except Exception:
        cpu.set_gpr(2, ERR_ENOMEM); cpu.set_opr(1, 0); return
    cpu.set_gpr(2, ERR_OK); cpu.set_opr(1, ref)

def primitive_ObjAllocFramebuffer(cpu: CPU) -> None:
    """Phase 60 — allocate a TAG_FRAMEBUFFER object backed by a host
    display surface (when --display tk is on; just a plain bytearray
    otherwise).  The WM normally writes pixels into this object via
    ObjStoreBytes; the host display worker mirrors the bytes into a
    Tk PhotoImage with no wire round-trip — replaces the per-pixel /
    per-row ObjStoreBytes-to-oriscterm path with a same-CPU store.

    Inputs:
      R4 = width  (pixels, 1..4096)
      R5 = height (pixels, 1..4096)
      R6 = caps mask (typically R|W|C for the WM's own use)

    Outputs:
      R2 = status (ERR_OK / ERR_EINVAL / ERR_ENOMEM)
      O1 = ref to the new object on success, null on failure

    Object size = width × height bytes (1 byte per palette index,
    matching the existing oriscterm framebuffer convention).  The
    palette interpretation lives entirely in the host display worker;
    the firmware only sees raw bytes. """
    width  = cpu.get_gpr(4) & 0xFFFF
    height = cpu.get_gpr(5) & 0xFFFF
    init_caps = cpu.get_gpr(6) & 0xFF
    if width == 0 or height == 0 or width > 4096 or height > 4096:
        cpu.set_gpr(2, ERR_EINVAL); cpu.set_opr(1, 0); return
    size = width * height
    try:
        ref = cpu.alloc_object(size, type_tag=TAG_FRAMEBUFFER,
                               max_caps=init_caps)
    except Exception:
        cpu.set_gpr(2, ERR_ENOMEM); cpu.set_opr(1, 0); return
    idx = ref_index(ref)
    desc = cpu.descriptors[idx]
    desc.fb_width  = width
    desc.fb_height = height
    desc.fb_dirty  = True   # initial paint
    # Notify the host display worker (if any) so it can create a Tk
    # window for this framebuffer.  Headless / no-display runs leave
    # the object as a plain bytearray; ObjStoreBytes still works.
    worker = getattr(cpu, "display_worker", None)
    if worker is not None:
        worker.register_framebuffer(cpu, idx, desc)
    cpu.set_gpr(2, ERR_OK); cpu.set_opr(1, ref)


def primitive_ObjAllocStore(cpu: CPU) -> None:
    """Like ObjAlloc but the new object's storage is OR-typed: OREFLD/
    OREFST may access it; integer OL/OS trap. Length must be a multiple
    of 8 bytes (one OR slot)."""
    length = cpu.get_gpr(4)
    type_tag = cpu.get_gpr(5) & 0xFFFF
    init_caps = cpu.get_gpr(6) & 0xFF
    if length == 0 or length > (1 << 24) or (length & 0x07) != 0:
        cpu.set_gpr(2, ERR_EINVAL); cpu.set_opr(1, 0); return
    try:
        ref = cpu.alloc_object(length, type_tag=type_tag,
                               max_caps=init_caps, objstore=True)
    except Exception:
        cpu.set_gpr(2, ERR_ENOMEM); cpu.set_opr(1, 0); return
    cpu.set_gpr(2, ERR_OK); cpu.set_opr(1, ref)


def primitive_ObjFree(cpu: CPU) -> None:
    o1 = cpu.get_opr(1)
    if o1 == 0:
        cpu.set_gpr(2, ERR_EFAULT); return
    if (ref_caps(o1) & CAP_V) == 0:
        cpu.set_gpr(2, ERR_EPERM); return
    home = ref_home(o1)
    if home != cpu.pid:
        cpu.set_gpr(2, ERR_EREMOTE); return
    idx = ref_index(o1)
    if idx >= len(cpu.descriptors) or cpu.descriptors[idx] is None:
        cpu.set_gpr(2, ERR_ESTALE); return
    desc = cpu.descriptors[idx]
    if not desc.live or desc.generation != ref_generation(o1):
        cpu.set_gpr(2, ERR_ESTALE); return
    # Reaping a TAG_TASK descriptor: only legal once the task has
    # exited, and we evict the Python Task struct alongside the
    # descriptor so cpu.tasks doesn't accumulate dead entries. A live
    # task can't be freed — that would silently strand the running
    # context (or the runnable queue would hold a dangling pointer).
    if desc.type_tag == TAG_TASK:
        task = cpu.tasks.get(idx)
        if task is not None:
            if task.state != TASK_STATE_EXITED:
                cpu.set_gpr(2, ERR_EBUSY); return
            cpu.tasks.pop(idx, None)
    cpu.free_object(idx)
    cpu.set_gpr(2, ERR_OK)

def primitive_ObjFreeDeferred(cpu: CPU) -> None:
    """Volume VI #0x107. Like ObjFree, but the descriptor stays live
    for at least R4 milliseconds before being torn down. Designed for
    the case where a guest task has just SENT data through this
    object's storage (e.g., a term_print payload) and the receiver
    may still issue OBJ_READ_REQs for it after the sender has moved
    on. Freeing immediately would lose those bytes; freeing after a
    drain window matches the chunkboot RESET_DRAIN_SECONDS idiom.

    Args:
      O1:  ref to free (must carry V).
      R4:  drain delay in milliseconds; clamped to [0, 60_000].

    Returns: R2 = OK on success; the same error codes as ObjFree
    apply (EFAULT/EPERM/EREMOTE/ESTALE/EBUSY).

    The descriptor is freed regardless of whether anyone is still
    reading from it when the deadline elapses; this is a hint for
    receivers to drain, not a hard reference count."""
    o1 = cpu.get_opr(1)
    delay_ms = cpu.get_gpr(4) & 0xFFFFFFFF
    if delay_ms > 60_000:
        delay_ms = 60_000
    if o1 == 0:
        cpu.set_gpr(2, ERR_EFAULT); return
    if (ref_caps(o1) & CAP_V) == 0:
        cpu.set_gpr(2, ERR_EPERM); return
    if ref_home(o1) != cpu.pid:
        cpu.set_gpr(2, ERR_EREMOTE); return
    idx = ref_index(o1)
    if idx >= len(cpu.descriptors) or cpu.descriptors[idx] is None:
        cpu.set_gpr(2, ERR_ESTALE); return
    desc = cpu.descriptors[idx]
    if not desc.live or desc.generation != ref_generation(o1):
        cpu.set_gpr(2, ERR_ESTALE); return
    # TAG_TASK descriptors carry a Python Task struct in cpu.tasks
    # that the immediate-free path evicts; if anyone ever uses the
    # deferred path on a task, refuse — the deferral semantics
    # (descriptor stays live) interact badly with the scheduler's
    # task-state machine.
    if desc.type_tag == TAG_TASK:
        cpu.set_gpr(2, ERR_EINVAL); return
    deadline = time.time() + (delay_ms / 1000.0)
    cpu.deferred_frees.append((deadline, idx))
    cpu.set_gpr(2, ERR_OK)


def primitive_ObjDerive(cpu: CPU) -> None:
    o1 = cpu.get_opr(1)
    mask = cpu.get_gpr(4) & 0xFF
    if o1 == 0:
        cpu.set_gpr(2, ERR_EFAULT); return
    if (ref_caps(o1) & CAP_C) == 0:
        cpu.set_gpr(2, ERR_EPERM); cpu.set_opr(1, 0); return
    new_caps = ref_caps(o1) & mask
    derived = make_ref(generation=ref_generation(o1),
                       home=ref_home(o1),
                       index=ref_index(o1),
                       caps=new_caps)
    cpu.set_opr(1, derived)
    cpu.set_gpr(2, ERR_OK)


def primitive_ObjFetchBytes(cpu: CPU) -> None:
    """Vol VI #0x108 (Phase 45e). Copy R6 bytes from O1+R4 to O2+R5.
    Source O1 may be local or remote; destination O2 must be local
    and non-objstore (we'd otherwise corrupt OR refs). Bridges the
    OL-immediate-offset gap for cross-CPU bulk reads — OBJ_READ_REQ
    already supports arbitrary widths on the wire, but no instruction
    or primitive previously exposed that to programs.

    Args:
      O1: source object ref (CAP_R required)
      O2: destination object ref (CAP_W required, must be local,
          must not be objstore)
      R4: source offset (signed 32-bit)
      R5: destination offset (signed 32-bit)
      R6: byte count (unsigned 32-bit)

    Returns:
      R2: status (OK / EFAULT / EREMOTE / EPERM / ESTALE / EINVAL)
      R3: bytes actually copied (R6 on success, 0 on error)

    Wire behaviour: when ref_home(O1) != cpu.pid, issues a single
    OBJ_READ_REQ for the full range and raises BlockedOnObjFetch.
    The handler at response time writes payload bytes into the
    local destination descriptor. RESP_* fault flags map to ERR_*
    (STALE/BOUNDS/CAP/BUS_ERROR) — same mapping OL/OS uses.
    """
    src = cpu.get_opr(1)
    dst = cpu.get_opr(2)
    src_off = cpu.get_gpr(4)
    if src_off & 0x80000000: src_off -= 0x100000000
    dst_off = cpu.get_gpr(5)
    if dst_off & 0x80000000: dst_off -= 0x100000000
    n = cpu.get_gpr(6) & 0xFFFFFFFF

    if src == 0 or dst == 0:
        cpu.set_gpr(2, ERR_EFAULT); cpu.set_gpr(3, 0); return
    if (ref_caps(src) & CAP_R) == 0:
        cpu.set_gpr(2, ERR_EPERM); cpu.set_gpr(3, 0); return
    if (ref_caps(dst) & CAP_W) == 0:
        cpu.set_gpr(2, ERR_EPERM); cpu.set_gpr(3, 0); return
    if ref_home(dst) != cpu.pid:
        cpu.set_gpr(2, ERR_EREMOTE); cpu.set_gpr(3, 0); return

    # Validate destination locally.
    dst_idx = ref_index(dst)
    if dst_idx <= 0 or dst_idx >= len(cpu.descriptors) \
            or cpu.descriptors[dst_idx] is None:
        cpu.set_gpr(2, ERR_ESTALE); cpu.set_gpr(3, 0); return
    dst_desc = cpu.descriptors[dst_idx]
    if not dst_desc.live or dst_desc.generation != ref_generation(dst):
        cpu.set_gpr(2, ERR_ESTALE); cpu.set_gpr(3, 0); return
    if dst_desc.objstore:
        cpu.set_gpr(2, ERR_EINVAL); cpu.set_gpr(3, 0); return
    if n == 0:
        cpu.set_gpr(2, ERR_OK); cpu.set_gpr(3, 0); return
    if dst_off < 0 or dst_off + n > dst_desc.length:
        cpu.set_gpr(2, ERR_EINVAL); cpu.set_gpr(3, 0); return

    if cpu.system is None or ref_home(src) == cpu.pid:
        # Local source: validate, then bytes copy.
        src_idx = ref_index(src)
        if src_idx <= 0 or src_idx >= len(cpu.descriptors) \
                or cpu.descriptors[src_idx] is None:
            cpu.set_gpr(2, ERR_ESTALE); cpu.set_gpr(3, 0); return
        src_desc = cpu.descriptors[src_idx]
        if not src_desc.live or src_desc.generation != ref_generation(src):
            cpu.set_gpr(2, ERR_ESTALE); cpu.set_gpr(3, 0); return
        if src_off < 0 or src_off + n > src_desc.length:
            cpu.set_gpr(2, ERR_EINVAL); cpu.set_gpr(3, 0); return
        dst_desc.storage[dst_off:dst_off+n] = \
            src_desc.storage[src_off:src_off+n]
        cpu.set_gpr(2, ERR_OK)
        cpu.set_gpr(3, n)
        return

    # Remote source: issue OBJ_READ_REQ, block. Home does the
    # validation and answers with the bytes (or a fault flag).
    trans_id = cpu.next_trans_id & 0xFFFF
    cpu.next_trans_id = (cpu.next_trans_id + 1) & 0xFFFF
    packet = build_obj_read_req(cpu.pid, ref_home(src), trans_id,
                                src, src_off, n)
    cpu.system.crossbar.send_packet(packet)
    raise BlockedOnObjFetch(trans_id, dst_idx, dst_off, n)


def primitive_ObjStoreBytes(cpu: CPU) -> None:
    """Vol VI #0x109 (Phase 59).  Mirror of ObjFetchBytes for the
    write direction.  Copy R6 bytes from O1+R4 (must be local) to
    O2+R5 (may be local or remote).

    The WM's glyph renderer is the headline consumer: drawing one
    8×16 bitmap-font cell to the remote framebuffer = 128 byte
    writes; per-byte OSB on a remote ref would block the CPU on
    128 wire RTTs.  ObjStoreBytes packs the whole 128-byte row into
    one OBJ_WRITE_REQ → one RTT.  Symmetric counterpart of
    ObjFetchBytes (#0x108): together they cover bulk transfers in
    either direction as long as one side is local.

    Args:
      O1: source object ref (CAP_R required, must be local, must
          not be objstore — we'd otherwise be reading OR-typed
          storage as plain bytes)
      O2: destination object ref (CAP_W required, may be local or
          remote)
      R4: source offset (signed 32-bit)
      R5: destination offset (signed 32-bit)
      R6: byte count (unsigned 32-bit)

    Returns:
      R2: status (OK / EFAULT / EREMOTE / EPERM / ESTALE / EINVAL)
      R3: bytes actually written (R6 on success, 0 on error)

    Wire behaviour: when ref_home(O2) != cpu.pid, issues a single
    OBJ_WRITE_REQ carrying all R6 bytes and raises BlockedOnObjStore.
    The matching OBJ_WRITE_RESP delivers the status; RESP_* fault
    flags map to ERR_* the same way ObjFetchBytes maps OBJ_READ_RESP
    faults."""
    src = cpu.get_opr(1)
    dst = cpu.get_opr(2)
    src_off = cpu.get_gpr(4)
    if src_off & 0x80000000: src_off -= 0x100000000
    dst_off = cpu.get_gpr(5)
    if dst_off & 0x80000000: dst_off -= 0x100000000
    n = cpu.get_gpr(6) & 0xFFFFFFFF

    if src == 0 or dst == 0:
        cpu.set_gpr(2, ERR_EFAULT); cpu.set_gpr(3, 0); return
    if (ref_caps(src) & CAP_R) == 0:
        cpu.set_gpr(2, ERR_EPERM); cpu.set_gpr(3, 0); return
    if (ref_caps(dst) & CAP_W) == 0:
        cpu.set_gpr(2, ERR_EPERM); cpu.set_gpr(3, 0); return
    if ref_home(src) != cpu.pid:
        cpu.set_gpr(2, ERR_EREMOTE); cpu.set_gpr(3, 0); return

    # Validate source locally and read the bytes.
    src_idx = ref_index(src)
    if src_idx <= 0 or src_idx >= len(cpu.descriptors) \
            or cpu.descriptors[src_idx] is None:
        cpu.set_gpr(2, ERR_ESTALE); cpu.set_gpr(3, 0); return
    src_desc = cpu.descriptors[src_idx]
    if not src_desc.live or src_desc.generation != ref_generation(src):
        cpu.set_gpr(2, ERR_ESTALE); cpu.set_gpr(3, 0); return
    if src_desc.objstore:
        cpu.set_gpr(2, ERR_EINVAL); cpu.set_gpr(3, 0); return
    if n == 0:
        cpu.set_gpr(2, ERR_OK); cpu.set_gpr(3, 0); return
    if src_off < 0 or src_off + n > src_desc.length:
        cpu.set_gpr(2, ERR_EINVAL); cpu.set_gpr(3, 0); return

    data = bytes(src_desc.storage[src_off:src_off + n])

    if cpu.system is None or ref_home(dst) == cpu.pid:
        # Local destination: validate, then bytes copy.
        dst_idx = ref_index(dst)
        if dst_idx <= 0 or dst_idx >= len(cpu.descriptors) \
                or cpu.descriptors[dst_idx] is None:
            cpu.set_gpr(2, ERR_ESTALE); cpu.set_gpr(3, 0); return
        dst_desc = cpu.descriptors[dst_idx]
        if not dst_desc.live or dst_desc.generation != ref_generation(dst):
            cpu.set_gpr(2, ERR_ESTALE); cpu.set_gpr(3, 0); return
        if dst_desc.objstore:
            cpu.set_gpr(2, ERR_EINVAL); cpu.set_gpr(3, 0); return
        if dst_off < 0 or dst_off + n > dst_desc.length:
            cpu.set_gpr(2, ERR_EINVAL); cpu.set_gpr(3, 0); return
        dst_desc.storage[dst_off:dst_off + n] = data
        # Phase 60: TAG_FRAMEBUFFER objects mirror their bytes into a
        # host display surface — flag the descriptor so the display
        # worker repaints on its next tick.
        if dst_desc.type_tag == TAG_FRAMEBUFFER:
            dst_desc.fb_dirty = True
        cpu.set_gpr(2, ERR_OK)
        cpu.set_gpr(3, n)
        return

    # Remote destination: issue OBJ_WRITE_REQ with all the bytes,
    # block. The home processes and replies with OBJ_WRITE_RESP.
    trans_id = cpu.next_trans_id & 0xFFFF
    cpu.next_trans_id = (cpu.next_trans_id + 1) & 0xFFFF
    packet = build_obj_write_req(cpu.pid, ref_home(dst), trans_id,
                                 dst, dst_off, n, data)
    cpu.system.crossbar.send_packet(packet)
    raise BlockedOnObjStore(trans_id, n)


def primitive_ReceiveQueueAttach(cpu: CPU) -> None:
    """Replace handler-dispatch behaviour on a target object with a
    queue. Subsequent SENDs to the object are appended to the queue
    instead of spawning a handler task."""
    target = cpu.get_opr(1)
    max_depth = cpu.get_gpr(4)

    if target == 0:
        cpu.set_gpr(2, ERR_EFAULT); return
    if (ref_caps(target) & (CAP_S | CAP_V)) != (CAP_S | CAP_V):
        cpu.set_gpr(2, ERR_EPERM); return
    if ref_home(target) != cpu.pid:
        cpu.set_gpr(2, ERR_EREMOTE); return
    if max_depth <= 0 or max_depth > 1024:
        cpu.set_gpr(2, ERR_EINVAL); return

    idx = ref_index(target)
    if idx >= len(cpu.descriptors) or cpu.descriptors[idx] is None:
        cpu.set_gpr(2, ERR_ESTALE); return
    desc = cpu.descriptors[idx]
    if not desc.live or desc.generation != ref_generation(target):
        cpu.set_gpr(2, ERR_ESTALE); return

    desc.queue = []
    desc.queue_max_depth = max_depth
    cpu.set_gpr(2, ERR_OK)


def _deliver_queue_msg(cpu: CPU, packet: bytes) -> None:
    """Populate registers from a queued SEND_DELIVER packet per Volume VI
    Section 6: R3..R6 receive the integer payload; O1..O4 receive the OR
    payload verbatim (no self-override, unlike handler dispatch)."""
    msg = PendingSend.from_wire(packet)
    cpu.set_gpr(2, ERR_OK)
    for i in range(4):
        cpu.set_gpr(3 + i, msg.int_payload[i])
    for i in range(4):
        cpu.set_opr(1 + i, msg.or_payload[i])


def primitive_ReceiveQueuePoll(cpu: CPU) -> None:
    target = cpu.get_opr(1)
    timeout = cpu.get_gpr(4)

    if target == 0:
        cpu.set_gpr(2, ERR_EFAULT); return
    if (ref_caps(target) & CAP_V) == 0:
        cpu.set_gpr(2, ERR_EPERM); return
    if ref_home(target) != cpu.pid:
        cpu.set_gpr(2, ERR_EREMOTE); return

    idx = ref_index(target)
    if idx >= len(cpu.descriptors) or cpu.descriptors[idx] is None:
        cpu.set_gpr(2, ERR_ESTALE); return
    desc = cpu.descriptors[idx]
    if not desc.live or desc.generation != ref_generation(target):
        cpu.set_gpr(2, ERR_ESTALE); return
    if desc.queue is None:
        cpu.set_gpr(2, ERR_EINVAL); return

    if desc.queue:
        _deliver_queue_msg(cpu, desc.queue.pop(0))
        return

    if timeout == 0:
        cpu.set_gpr(2, ERR_ETIMEOUT)
        cpu.set_gpr(3, 0)
        return

    # Block. The scheduler holds the CPU at this CALL until the queue
    # receives a message (delivered then) or the timeout expires.
    raise BlockedOnQueue(
        descriptor_idx=idx,
        timeout=-1 if timeout == 0xFFFFFFFF else timeout,
    )


def primitive_InstallTrapHandler(cpu: CPU) -> None:
    """Volume VI #0x520. Install a supervisor-mode trap handler for the
    given cause code. Subsequent traps with that cause are delivered to
    `R5` (a virtual address mapped in the trapping task's address space)
    in supervisor mode, instead of going through the firmware-only
    VECBASE table.

    Args:
      R4: cause code (0x01..0x21 — must appear in CAUSE_VECTOR_OFFSET).
      R5: handler virtual address.

    Returns: R2 = OK on success, EINVAL if cause is not a recognised
    architectural exception."""
    cause = cpu.get_gpr(4) & 0xFF
    va    = cpu.get_gpr(5) & 0xFFFFFFFF
    if cause not in CAUSE_VECTOR_OFFSET:
        cpu.set_gpr(2, ERR_EINVAL); return
    cpu.trap_handlers[cause] = va
    # Snapshot the supervisor's mappings at install time. When the trap
    # eventually fires from a child task whose own address space doesn't
    # cover this handler VA (e.g. an orx_run-spawned guest faults under
    # a shell that registered the handler), deliver_trap swaps these
    # mappings in for the duration of the handler. ERET then restores
    # the trapping task's mappings via load_task_to_cpu.
    cpu.trap_handler_mappings[cause] = list(cpu.mappings)
    cpu.set_gpr(2, ERR_OK)


def primitive_InstallHandler(cpu: CPU) -> None:
    target = cpu.get_opr(1)
    handler = cpu.get_opr(2)
    handler_off = cpu.get_gpr(4)

    if target == 0 or handler == 0:
        cpu.set_gpr(2, ERR_EFAULT); return
    if (ref_caps(target) & (CAP_S | CAP_V)) != (CAP_S | CAP_V):
        cpu.set_gpr(2, ERR_EPERM); return
    if (ref_caps(handler) & CAP_X) == 0:
        cpu.set_gpr(2, ERR_EPERM); return
    if ref_home(target) != cpu.pid:
        cpu.set_gpr(2, ERR_EREMOTE); return

    # Find an executable mapping for the handler code object on this CPU,
    # so dispatch knows the VA at which to begin execution. Boot text is
    # mapped at 0x10000 by init_cpu; loadable modules are mapped wherever
    # MapObject placed them.
    handler_idx = ref_index(handler)
    handler_va = None
    for (lo, hi, idx, base, prot) in cpu.mappings:
        if idx == handler_idx and (prot & CAP_X) and \
                base <= handler_off < base + (hi - lo):
            handler_va = lo + (handler_off - base)
            break
    if handler_va is None:
        cpu.set_gpr(2, ERR_EINVAL); return

    idx = ref_index(target)
    if idx >= len(cpu.descriptors) or cpu.descriptors[idx] is None:
        cpu.set_gpr(2, ERR_ESTALE); return
    desc = cpu.descriptors[idx]
    if not desc.live or desc.generation != ref_generation(target):
        cpu.set_gpr(2, ERR_ESTALE); return

    desc.send_handler_ref = handler
    desc.send_handler_off = handler_off
    desc.send_handler_va  = handler_va
    cpu.set_gpr(2, ERR_OK)


def primitive_InstallProgram(cpu: CPU) -> None:
    """Atomically replace the running program with one loaded into a
    fresh code/(optional) data object pair, and jump to its entry.

    Used by chunkboot.s after fetching all chunks of a guest .orx:
    the loader hands control to the guest at CODE_VA + entry_offset,
    with the guest seeing the same VA layout as a standalone simorisc
    boot would have produced.

    Args:
        O1 = code reference (must have R+X effective caps)
        O3 = data reference (must have R; null for code-only programs)
        R4 = entry offset within the new code

    Effects:
        - Drops all mappings whose descriptors aren't TAG_STACK; the
          stack mapping (whatever VA range it lives in) is preserved
          so the guest can keep using the inherited stack.
        - Maps code at CODE_VA with prot=R+X.
        - Maps data at DATA_VA with prot=R (only if O3 != 0).
        - Resets all GPRs except R7 (PROCID), R29 (SP=STACK_TOP-16),
          R30 (FP=0), R31 (RA=0).
        - Sets PC = CODE_VA + R4 and next_PC = PC + 4.
        - Sets cpu._call_redirected_pc=True so the dispatch_call site
          knows to skip the post-call PC advance.

    The CPU's OR slots are NOT cleared (the guest inherits whatever
    O5..O15 the loader has arranged, e.g. terminal/keyboard/hostfsd
    refs after the loader's pre-jump shift). O1 is set to the new
    code ref; O3 is set to the new data ref or zero."""
    code_ref = cpu.get_opr(1)
    data_ref = cpu.get_opr(3)
    entry    = cpu.get_gpr(4) & 0xFFFFFFFF
    if entry & 0x80000000:
        entry -= 0x100000000

    if code_ref == 0:
        cpu.set_gpr(2, ERR_EFAULT); return
    if ref_home(code_ref) != cpu.pid:
        cpu.set_gpr(2, ERR_EREMOTE); return
    if (ref_caps(code_ref) & (CAP_R | CAP_X)) != (CAP_R | CAP_X):
        cpu.set_gpr(2, ERR_EPERM); return
    code_idx = ref_index(code_ref)
    if code_idx >= len(cpu.descriptors) or cpu.descriptors[code_idx] is None:
        cpu.set_gpr(2, ERR_ESTALE); return
    code_desc = cpu.descriptors[code_idx]
    if not code_desc.live or code_desc.generation != ref_generation(code_ref):
        cpu.set_gpr(2, ERR_ESTALE); return
    code_size = code_desc.length
    if entry < 0 or entry >= code_size:
        cpu.set_gpr(2, ERR_EINVAL); return

    data_size = 0
    if data_ref != 0:
        if ref_home(data_ref) != cpu.pid:
            cpu.set_gpr(2, ERR_EREMOTE); return
        if (ref_caps(data_ref) & CAP_R) != CAP_R:
            cpu.set_gpr(2, ERR_EPERM); return
        data_idx = ref_index(data_ref)
        if data_idx >= len(cpu.descriptors) or cpu.descriptors[data_idx] is None:
            cpu.set_gpr(2, ERR_ESTALE); return
        data_desc = cpu.descriptors[data_idx]
        if not data_desc.live or data_desc.generation != ref_generation(data_ref):
            cpu.set_gpr(2, ERR_ESTALE); return
        data_size = data_desc.length

    # Keep only stack mappings; toss everything else (loader's own
    # code/data, any temp R+W mappings the loader created during the
    # chunk copy, etc.). The stack VA range is inherited.
    stack_idx = None
    new_mappings = []
    for m in cpu.mappings:
        d = cpu.descriptors[m[2]]
        if d is not None and d.type_tag == TAG_STACK:
            new_mappings.append(m)
            stack_idx = m[2]
    cpu.mappings = new_mappings

    cpu.map_object(code_ref, va=CODE_VA, offset=0, length=code_size,
                   prot=CAP_R | CAP_X)
    if data_size > 0:
        # Match init_cpu: data is R+W so guests can mutate globals.
        # (Caller is responsible for the data ref carrying CAP_W.)
        cpu.map_object(data_ref, va=DATA_VA, offset=0, length=data_size,
                       prot=CAP_R | CAP_W)

    # Match init_cpu's GPR state — minus R0 (always zero), and with
    # PROCID restored to cpu.pid (some loaders may have shuffled R7).
    for i in range(32):
        cpu.gpr[i] = 0
    cpu.set_gpr(7, cpu.pid)
    cpu.set_gpr(29, STACK_TOP - 16)
    cpu.set_gpr(30, 0)
    cpu.set_gpr(31, 0)

    cpu.set_opr(1, code_ref)
    cpu.set_opr(3, data_ref)
    # O2 = stack ref so term_init's `omov o11, o2` lands the right
    # thing. Reconstruct from the surviving stack descriptor (its
    # index is fixed by init_cpu, but we look it up to be tolerant of
    # future layout changes).
    if stack_idx is not None:
        sd = cpu.descriptors[stack_idx]
        stack_ref = make_ref(generation=sd.generation, home=cpu.pid,
                             index=stack_idx, caps=sd.max_caps)
        cpu.set_opr(2, stack_ref)

    cpu.pc      = (CODE_VA + entry) & 0xFFFFFFFF
    cpu.next_pc = (cpu.pc + 4)      & 0xFFFFFFFF
    cpu._call_redirected_pc = True
    cpu.set_gpr(2, ERR_OK)


def primitive_MapObject(cpu: CPU) -> None:
    target  = cpu.get_opr(1)
    va_hint = cpu.get_gpr(4)
    offset  = cpu.get_gpr(5)
    prot    = cpu.get_gpr(6) & (CAP_R | CAP_W | CAP_X)
    length  = cpu.get_gpr(7)

    if target == 0:
        cpu.set_gpr(2, ERR_EFAULT); return
    if ref_home(target) != cpu.pid:
        cpu.set_gpr(2, ERR_EREMOTE); return
    # Requested protection must be a subset of the reference's effective
    # capabilities (Volume VI Section 5.2).
    if (ref_caps(target) & prot) != prot:
        cpu.set_gpr(2, ERR_EPERM); return

    idx = ref_index(target)
    if idx >= len(cpu.descriptors) or cpu.descriptors[idx] is None:
        cpu.set_gpr(2, ERR_ESTALE); return
    desc = cpu.descriptors[idx]
    if not desc.live or desc.generation != ref_generation(target):
        cpu.set_gpr(2, ERR_ESTALE); return

    if length <= 0 or offset < 0 or offset + length > desc.length:
        cpu.set_gpr(2, ERR_EINVAL); return

    # Choose VA. With va_hint == 0, pick a fresh region above the loadable-
    # module floor (0x00100000); with va_hint != 0, honour it verbatim
    # without checking for collisions (the program is responsible).
    if va_hint == 0:
        va = 0x00100000
        while any(lo <= va < hi or va <= lo < va + length
                  for (lo, hi, _, _, _) in cpu.mappings):
            va += (length + 0xFFF) & ~0xFFF
    else:
        va = va_hint & 0xFFFFFFFF

    cpu.map_object(target, va=va, offset=offset, length=length, prot=prot)
    cpu.set_gpr(2, ERR_OK)
    cpu.set_gpr(3, va)


def primitive_Unmap(cpu: CPU) -> None:
    """Volume VI #0x111. Drop the mapping that starts at exactly R4 and
    has exactly R5 length. The simulator's mapping list permits
    duplicates (older entries shadow newer ones — first-match-wins in
    lookup_va), so a clean replace-via-MapObject sequence is
    `Unmap(va,len); MapObject(...,va,len,...)`. Unmapping a range that
    isn't a current mapping returns EINVAL.

    Args:
      R4: virtual address of the mapping to drop.
      R5: length of the mapping (must match the original MapObject).

    Returns: R2 = OK on success, EINVAL if no exact match.
    """
    va  = cpu.get_gpr(4) & 0xFFFFFFFF
    length = cpu.get_gpr(5)
    for i, (lo, hi, _, _, _) in enumerate(cpu.mappings):
        if lo == va and hi == va + length:
            del cpu.mappings[i]
            cpu.set_gpr(2, ERR_OK); return
    cpu.set_gpr(2, ERR_EINVAL)


# Per-primitive minimum caller mode (Volume VI Section 2.4 + Volume II
# Section 13). Anything not listed defaults to MODE_USER on the theory
# that callable-from-user-code is the common case; exposing a privileged
# capability is an explicit decision made here.
PRIMITIVE_MIN_MODE = {
    0x000: MODE_SUPERVISOR,  # TaskCreate       — installs a child task
    0x001: MODE_USER,        # TaskExit
    0x002: MODE_SUPERVISOR,  # TaskResume       — drives the scheduler
    0x003: MODE_SUPERVISOR,  # TaskSuspend
    0x004: MODE_USER,        # TaskYield
    0x005: MODE_USER,        # TaskCurrent
    0x008: MODE_USER,        # TaskQuery
    0x007: MODE_USER,        # TaskWait
    0x009: MODE_SUPERVISOR,  # InstallProgram   — replaces task image
    0x00A: MODE_USER,        # TaskKill         — external termination by ref
    0x100: MODE_USER,        # ObjAlloc
    0x101: MODE_USER,        # ObjFree
    0x102: MODE_USER,        # ObjAllocFramebuffer (Phase 60)
    0x107: MODE_USER,        # ObjFreeDeferred — drain-window wrapper
    0x103: MODE_USER,        # ObjDerive
    0x106: MODE_USER,        # ObjAllocStore
    0x108: MODE_USER,        # ObjFetchBytes (Phase 45e)
    0x109: MODE_USER,        # ObjStoreBytes (Phase 59)
    0x110: MODE_SUPERVISOR,  # MapObject        — manipulates VA layout
    0x111: MODE_SUPERVISOR,  # Unmap            — manipulates VA layout
    0x200: MODE_SUPERVISOR,  # InstallHandler   — registers trap-like callback
    0x203: MODE_USER,        # ReceiveQueueAttach
    0x204: MODE_USER,        # ReceiveQueuePoll
    0x301: MODE_USER,        # ReadCycles
    0x320: MODE_USER,        # ConsoleWrite     — debug primitive, will move
    0x400: MODE_USER,        # TimeNow
    0x410: MODE_USER,        # ClockResolution
    0x520: MODE_SUPERVISOR,  # InstallTrapHandler — registers per-cause vector
}

def dispatch_call(cpu: CPU, prim: int, faulting_pc: int) -> None:
    min_mode = PRIMITIVE_MIN_MODE.get(prim)
    if min_mode is None:
        cpu.set_gpr(2, ERR_ENOSYS)
        cpu.set_gpr(3, 0)
        return
    if cpu.mode < min_mode:
        cpu.set_gpr(2, ERR_EPERM)
        cpu.set_gpr(3, 0)
        return

    if prim == 0x000:
        primitive_TaskCreate(cpu)
    elif prim == 0x001:
        primitive_TaskExit(cpu)
    elif prim == 0x002:
        primitive_TaskResume(cpu)
    elif prim == 0x003:
        primitive_TaskSuspend(cpu)
    elif prim == 0x004:
        primitive_TaskYield(cpu, faulting_pc)
    elif prim == 0x005:
        primitive_TaskCurrent(cpu)
    elif prim == 0x007:
        primitive_TaskWait(cpu, faulting_pc)
    elif prim == 0x008:
        primitive_TaskQuery(cpu)
    elif prim == 0x009:
        primitive_InstallProgram(cpu)
    elif prim == 0x00A:
        primitive_TaskKill(cpu)
    elif prim == 0x100:
        primitive_ObjAlloc(cpu)
    elif prim == 0x101:
        primitive_ObjFree(cpu)
    elif prim == 0x102:
        primitive_ObjAllocFramebuffer(cpu)
    elif prim == 0x107:
        primitive_ObjFreeDeferred(cpu)
    elif prim == 0x103:
        primitive_ObjDerive(cpu)
    elif prim == 0x106:
        primitive_ObjAllocStore(cpu)
    elif prim == 0x108:
        primitive_ObjFetchBytes(cpu)
    elif prim == 0x109:
        primitive_ObjStoreBytes(cpu)
    elif prim == 0x110:
        primitive_MapObject(cpu)
    elif prim == 0x111:
        primitive_Unmap(cpu)
    elif prim == 0x200:
        primitive_InstallHandler(cpu)
    elif prim == 0x203:
        primitive_ReceiveQueueAttach(cpu)
    elif prim == 0x204:
        primitive_ReceiveQueuePoll(cpu)
    elif prim == 0x301:
        primitive_ReadCycles(cpu)
    elif prim == 0x320:
        primitive_ConsoleWrite(cpu, faulting_pc)
    elif prim == 0x400:
        primitive_TimeNow(cpu)
    elif prim == 0x410:
        primitive_ClockResolution(cpu)
    elif prim == 0x520:
        primitive_InstallTrapHandler(cpu)


# ---------------------------------------------------------------------------
# Disassembly (for trace)
# ---------------------------------------------------------------------------

def fmt_instr(pc: int, word: int, cpu: CPU) -> str:
    op = (word >> 26) & 0x3F
    rs = (word >> 21) & 0x1F
    rt = (word >> 16) & 0x1F
    rd = (word >> 11) & 0x1F
    sh = (word >>  6) & 0x1F
    fn = word & 0x3F
    imm = word & 0xFFFF
    simm = sext16(imm)
    target = word & 0x03FFFFFF

    if op == 0x00:
        m = {
            0x00:"sll", 0x02:"srl", 0x03:"sra",
            0x04:"sllv",0x06:"srlv",0x07:"srav",
            0x08:"jr",  0x09:"jalr",
            0x10:"mfhi",0x12:"mflo",
            0x18:"mult",0x19:"multu",0x1A:"div",0x1B:"divu",
            0x20:"add", 0x21:"addu",0x22:"sub", 0x23:"subu",
            0x24:"and", 0x25:"or",  0x26:"xor", 0x27:"nor",
            0x2A:"slt", 0x2B:"sltu",
        }.get(fn, f"special?fn={fn:#x}")
        if fn in (0x00,0x02,0x03):       return f"{m} r{rd}, r{rt}, {sh}"
        if fn in (0x04,0x06,0x07):       return f"{m} r{rd}, r{rt}, r{rs}"
        if fn == 0x08:                   return f"{m} r{rs}"
        if fn == 0x09:                   return f"{m} r{rd}, r{rs}"
        if fn in (0x10,0x12):            return f"{m} r{rd}"
        if fn in (0x18,0x19,0x1A,0x1B):  return f"{m} r{rs}, r{rt}"
        return f"{m} r{rd}, r{rs}, r{rt}"
    if op == 0x01:
        m = {0x00:"bltz",0x01:"bgez",0x10:"bltzal",0x11:"bgezal"}.get(rt, f"regimm?{rt:#x}")
        return f"{m} r{rs}, 0x{(pc + 4 + simm*4) & 0xFFFFFFFF:08x}"
    if op == 0x02:                       return f"j 0x{(((pc+4) & 0xF0000000) | (target<<2)):08x}"
    if op == 0x03:                       return f"jal 0x{(((pc+4) & 0xF0000000) | (target<<2)):08x}"
    if op == 0x04:                       return f"beq r{rs}, r{rt}, 0x{(pc+4+simm*4)&0xFFFFFFFF:08x}"
    if op == 0x05:                       return f"bne r{rs}, r{rt}, 0x{(pc+4+simm*4)&0xFFFFFFFF:08x}"
    if op == 0x06:                       return f"blez r{rs}, 0x{(pc+4+simm*4)&0xFFFFFFFF:08x}"
    if op == 0x07:                       return f"bgtz r{rs}, 0x{(pc+4+simm*4)&0xFFFFFFFF:08x}"
    if op == 0x08:                       return f"addi r{rt}, r{rs}, {simm}"
    if op == 0x09:                       return f"addiu r{rt}, r{rs}, {simm}"
    if op == 0x0A:                       return f"slti r{rt}, r{rs}, {simm}"
    if op == 0x0B:                       return f"sltiu r{rt}, r{rs}, {simm}"
    if op == 0x0C:                       return f"andi r{rt}, r{rs}, 0x{imm:04x}"
    if op == 0x0D:                       return f"ori r{rt}, r{rs}, 0x{imm:04x}"
    if op == 0x0E:                       return f"xori r{rt}, r{rs}, 0x{imm:04x}"
    if op == 0x0F:                       return f"lui r{rt}, 0x{imm:04x}"
    if op == 0x10:
        if rs == 0x00: return f"lctrl r{rt}, ${rd}"
        if rs == 0x04: return f"sctrl ${rd}, r{rt}"
        if rs == 0x10:
            return {0x01:"tlbr", 0x02:"tlbwi", 0x06:"tlbwr",
                    0x08:"tlbp", 0x18:"eret",  0x20:"wait"
                    }.get(fn, f"system?co.fn={fn:#x}")
        return f"system?rs={rs:#x}"
    if op == 0x20:                       return f"lb r{rt}, {simm}(r{rs})"
    if op == 0x21:                       return f"lh r{rt}, {simm}(r{rs})"
    if op == 0x23:                       return f"lw r{rt}, {simm}(r{rs})"
    if op == 0x24:                       return f"lbu r{rt}, {simm}(r{rs})"
    if op == 0x25:                       return f"lhu r{rt}, {simm}(r{rs})"
    if op == 0x28:                       return f"sb r{rt}, {simm}(r{rs})"
    if op == 0x29:                       return f"sh r{rt}, {simm}(r{rs})"
    if op == 0x2B:                       return f"sw r{rt}, {simm}(r{rs})"
    if op == 0x30:
        os_  = (word >> 22) & 0xF
        ot   = (word >> 18) & 0xF
        ord_ = (word >> 13) & 0x1F
        ofn  = (word >>  4) & 0xF
        m = {0x0:"omov",0x1:"onull",0x2:"oeq",0x3:"oisn",
             0x4:"olen",0x5:"otag",0x6:"ohome",0x7:"ocap",
             0x8:"ofence"}.get(ofn, f"obj?fn={ofn:#x}")
        if ofn == 0x0: return f"omov o{os_}, o{ot}"
        if ofn == 0x1: return f"onull o{os_}"
        if ofn == 0x2: return f"oeq r{ord_}, o{os_}, o{ot}"
        if ofn == 0x8: return "ofence"
        return f"{m} r{ord_}, o{os_}"
    if op in (0x31,0x32,0x33,0x34,0x35,0x38,0x39,0x3B):
        os_ = (word >> 22) & 0xF
        rt_ = (word >> 16) & 0x3F
        off = sext16(word & 0xFFFF)
        m = {0x31:"olb",0x32:"olh",0x33:"olw",0x34:"olbu",
             0x35:"olhu",0x38:"osb",0x39:"osh",0x3B:"osw"}[op]
        return f"{m} r{rt_ & 0x1F}, {off}(o{os_})"
    if op in (0x36, 0x37):
        os_ = (word >> 22) & 0xF
        od  = (word >> 18) & 0xF
        off = sext16(word & 0xFFFF)
        m = "orefld" if op == 0x36 else "orefst"
        return f"{m} o{od}, {off}(o{os_})"
    if op == 0x3C:
        os_ = (word >> 22) & 0xF
        return f"send o{os_}"
    if op == 0x3D:
        return f"call #{target:#x}"
    return f"???op={op:#x}"


def emit_trace(cpu: CPU, pc: int, word: int,
               pre_gpr: List[int], pre_opr: List[int],
               pre_hi: int, pre_lo: int) -> None:
    if not cpu.trace_enabled:
        return
    diffs: List[str] = []
    for i in range(32):
        if cpu.gpr[i] != pre_gpr[i]:
            diffs.append(f"r{i} = 0x{cpu.gpr[i]:08x}")
    for i in range(16):
        if cpu.opr[i] != pre_opr[i]:
            diffs.append(f"o{i} = 0x{cpu.opr[i]:016x}")
    if cpu.hi != pre_hi:
        diffs.append(f"hi = 0x{cpu.hi:08x}")
    if cpu.lo != pre_lo:
        diffs.append(f"lo = 0x{cpu.lo:08x}")
    decoded = fmt_instr(pc, word, cpu)
    prefix = f"CPU{cpu.pid} " if cpu.system and cpu.system.n_cpus > 1 else ""
    line = f"{prefix}0x{pc:08x}  {decoded:<32s}"
    if diffs:
        line += "  ; " + ", ".join(diffs)
    print(line, file=sys.stderr)


# ---------------------------------------------------------------------------
# Instruction step
# ---------------------------------------------------------------------------

def step(cpu: CPU) -> None:
    pc = cpu.pc
    if pc == 0:
        raise Trap(CAUSE_BUS_ERROR_I, pc, "main returned without TaskExit")
    # Timer interrupt: fire before fetching the next instruction so EPC
    # ends up pointing at the would-be-next instruction (which is what
    # ERET will resume). compare_reg = 0 disables the timer (default).
    # Defer firing while the CPU is in a branch delay slot — Vol II §14
    # would have us record the branch's address in EPC with the BD bit
    # set; the simulator doesn't track BD yet, so we just wait one
    # instruction and fire on the branch target instead. (Sync traps
    # inside delay slots have the same architectural concern; they're
    # rare in current programs and will be fixed when BD is wired in.)
    in_delay_slot = (cpu.next_pc != to_u32(cpu.pc + 4))
    if (not in_delay_slot
            and cpu.status_ie and cpu.compare_reg != 0
            and cpu.cycles >= cpu.compare_reg):
        raise Trap(CAUSE_EXTERNAL_INTERRUPT, pc, "timer")
    word = cpu.fetch_instr(pc)
    op = (word >> 26) & 0x3F

    pre_gpr = cpu.gpr.copy()
    pre_opr = cpu.opr.copy()
    pre_hi, pre_lo = cpu.hi, cpu.lo

    branch_target: Optional[int] = None
    def take_branch(target: int) -> None:
        nonlocal branch_target
        branch_target = target & 0xFFFFFFFF

    rs = (word >> 21) & 0x1F
    rt = (word >> 16) & 0x1F
    rd = (word >> 11) & 0x1F
    sh = (word >>  6) & 0x1F
    fn = word & 0x3F
    imm = word & 0xFFFF
    simm = sext16(imm)
    target26 = word & 0x03FFFFFF

    def gpr(i): return cpu.get_gpr(i)
    def sgpr(i): return sext32(cpu.get_gpr(i))

    if op == 0x00:  # SPECIAL
        if   fn == 0x00:
            cpu.set_gpr(rd, to_u32(gpr(rt) << sh))
        elif fn == 0x02:
            cpu.set_gpr(rd, to_u32(gpr(rt) >> sh))
        elif fn == 0x03:
            cpu.set_gpr(rd, to_u32(sgpr(rt) >> sh))
        elif fn == 0x04:
            cpu.set_gpr(rd, to_u32(gpr(rt) << (gpr(rs) & 0x1F)))
        elif fn == 0x06:
            cpu.set_gpr(rd, to_u32(gpr(rt) >> (gpr(rs) & 0x1F)))
        elif fn == 0x07:
            cpu.set_gpr(rd, to_u32(sgpr(rt) >> (gpr(rs) & 0x1F)))
        elif fn == 0x08:
            take_branch(gpr(rs))
        elif fn == 0x09:
            cpu.set_gpr(rd if rd else 31, to_u32(pc + 8))
            take_branch(gpr(rs))
        elif fn == 0x10:
            cpu.set_gpr(rd, cpu.hi)
        elif fn == 0x12:
            cpu.set_gpr(rd, cpu.lo)
        elif fn == 0x18:
            prod = sgpr(rs) * sgpr(rt)
            cpu.lo = to_u32(prod); cpu.hi = to_u32(prod >> 32)
        elif fn == 0x19:
            prod = gpr(rs) * gpr(rt)
            cpu.lo = to_u32(prod); cpu.hi = to_u32(prod >> 32)
        elif fn == 0x1A:
            a, b = sgpr(rs), sgpr(rt)
            if b == 0:
                cpu.lo, cpu.hi = 0, to_u32(a)
            else:
                q = abs(a) // abs(b)
                if (a < 0) ^ (b < 0):
                    q = -q
                r = a - q * b
                cpu.lo, cpu.hi = to_u32(q), to_u32(r)
        elif fn == 0x1B:
            a, b = gpr(rs), gpr(rt)
            if b == 0:
                cpu.lo, cpu.hi = 0, a
            else:
                cpu.lo, cpu.hi = a // b, a % b
        elif fn == 0x20:
            a, b = sgpr(rs), sgpr(rt); r = a + b
            if r < -0x80000000 or r > 0x7FFFFFFF:
                raise Trap(CAUSE_ARITH_OVERFLOW, pc, "ADD overflow")
            cpu.set_gpr(rd, to_u32(r))
        elif fn == 0x21:
            cpu.set_gpr(rd, to_u32(gpr(rs) + gpr(rt)))
        elif fn == 0x22:
            a, b = sgpr(rs), sgpr(rt); r = a - b
            if r < -0x80000000 or r > 0x7FFFFFFF:
                raise Trap(CAUSE_ARITH_OVERFLOW, pc, "SUB overflow")
            cpu.set_gpr(rd, to_u32(r))
        elif fn == 0x23: cpu.set_gpr(rd, to_u32(gpr(rs) - gpr(rt)))
        elif fn == 0x24: cpu.set_gpr(rd, gpr(rs) & gpr(rt))
        elif fn == 0x25: cpu.set_gpr(rd, gpr(rs) | gpr(rt))
        elif fn == 0x26: cpu.set_gpr(rd, gpr(rs) ^ gpr(rt))
        elif fn == 0x27: cpu.set_gpr(rd, to_u32(~(gpr(rs) | gpr(rt))))
        elif fn == 0x2A: cpu.set_gpr(rd, 1 if sgpr(rs) < sgpr(rt) else 0)
        elif fn == 0x2B: cpu.set_gpr(rd, 1 if gpr(rs)  < gpr(rt)  else 0)
        else:
            raise Trap(CAUSE_RESERVED_INSTR, pc, f"SPECIAL funct {fn:#x}")
    elif op == 0x01:
        cond_target = to_u32(pc + 4 + (simm * 4))
        if   rt == 0x00: cond = sgpr(rs) <  0
        elif rt == 0x01: cond = sgpr(rs) >= 0
        elif rt == 0x10:
            cpu.set_gpr(31, to_u32(pc + 8)); cond = sgpr(rs) < 0
        elif rt == 0x11:
            cpu.set_gpr(31, to_u32(pc + 8)); cond = sgpr(rs) >= 0
        else:
            raise Trap(CAUSE_RESERVED_INSTR, pc, f"REGIMM rt {rt:#x}")
        if cond: take_branch(cond_target)
    elif op == 0x02:
        ds = pc + 4
        take_branch((ds & 0xF0000000) | (target26 << 2))
    elif op == 0x03:
        cpu.set_gpr(31, to_u32(pc + 8))
        ds = pc + 4
        take_branch((ds & 0xF0000000) | (target26 << 2))
    elif op == 0x04:
        if gpr(rs) == gpr(rt): take_branch(to_u32(pc + 4 + simm*4))
    elif op == 0x05:
        if gpr(rs) != gpr(rt): take_branch(to_u32(pc + 4 + simm*4))
    elif op == 0x06:
        if sgpr(rs) <= 0:      take_branch(to_u32(pc + 4 + simm*4))
    elif op == 0x07:
        if sgpr(rs) > 0:       take_branch(to_u32(pc + 4 + simm*4))
    elif op == 0x08:
        a = sgpr(rs); b = simm; r = a + b
        if r < -0x80000000 or r > 0x7FFFFFFF:
            raise Trap(CAUSE_ARITH_OVERFLOW, pc, "ADDI overflow")
        cpu.set_gpr(rt, to_u32(r))
    elif op == 0x10:  # SYSTEM (privileged) — Volume II Section 13
        # rs selects the sub-operation; rd carries the control-register
        # number for LCTRL / SCTRL. All sub-ops trap in user mode; the
        # TLB-management ops trap in supervisor mode too.
        if rs == 0x00:    # LCTRL Rt, ctrl(Rd)
            if cpu.mode < MODE_SUPERVISOR:
                raise Trap(CAUSE_PRIV_INSTR, pc, "LCTRL in user mode")
            if rd > CTRL_SV_MAX and cpu.mode < MODE_FIRMWARE:
                raise Trap(CAUSE_PRIV_INSTR, pc,
                           f"LCTRL ctrl{rd} requires firmware mode")
            cpu.set_gpr(rt, cpu.ctrl_read(rd))
        elif rs == 0x04:  # SCTRL ctrl(Rd), Rt
            if cpu.mode < MODE_SUPERVISOR:
                raise Trap(CAUSE_PRIV_INSTR, pc, "SCTRL in user mode")
            if rd > CTRL_SV_MAX and cpu.mode < MODE_FIRMWARE:
                raise Trap(CAUSE_PRIV_INSTR, pc,
                           f"SCTRL ctrl{rd} requires firmware mode")
            cpu.ctrl_write(rd, cpu.get_gpr(rt))
        elif rs == 0x10:  # CO — sub-decoded by funct
            if cpu.mode < MODE_SUPERVISOR:
                raise Trap(CAUSE_PRIV_INSTR, pc,
                           f"SYSTEM.CO funct {fn:#x} in user mode")
            if fn == 0x18:    # ERET — return from exception or CALL
                cur = cpu.current_task
                # Reflect any handler-side SCTRL of EPC/STATUS into the
                # outgoing task's resume image so the trapped task picks
                # up at the right post-handler location whether we
                # ERET-resume or yield-then-resume.
                if cur is not None:
                    cur.pc      = cpu.saved_pc & 0xFFFFFFFF
                    cur.next_pc = (cpu.saved_pc + 4) & 0xFFFFFFFF
                    cur.mode    = cpu.saved_mode

                if cpu.yield_pending:
                    # The handler asked for a context switch via
                    # TaskYield — honor it now, on the way out. The
                    # outgoing task struct is already a valid resume
                    # image (saved at trap delivery + reflected above);
                    # just pick the next runnable and load it without
                    # re-saving cpu state (which would clobber the
                    # outgoing task struct with the handler's mid-
                    # execution gprs).
                    cpu.yield_pending   = False
                    cpu.in_trap_handler = False
                    nxt = pick_next_runnable(cpu)
                    if nxt is not None and nxt is not cur and cur is not None:
                        cur.state = TASK_STATE_RUNNABLE
                        cpu.runnable.append(cur)
                        load_task_to_cpu(cpu, nxt)
                        nxt.state = TASK_STATE_RUNNING
                        cpu.current_task = nxt
                        cpu.cycles += 1
                        emit_trace(cpu, pc, word, pre_gpr, pre_opr, pre_hi, pre_lo)
                        return
                    # Nothing else runnable (or we're somehow without a
                    # current task): fall through to a normal ERET.

                # Normal ERET: restore the trapped task's user GPRs/
                # OPRs (so handler clobbers don't leak), then jump to
                # the post-handler EPC in the post-handler mode.
                cpu.in_trap_handler = False
                if cur is not None:
                    saved_pc_final   = cpu.saved_pc
                    saved_mode_final = cpu.saved_mode
                    load_task_to_cpu(cpu, cur)
                    cpu.pc       = saved_pc_final & 0xFFFFFFFF
                    cpu.next_pc  = (cpu.pc + 4) & 0xFFFFFFFF
                    cpu.mode     = saved_mode_final
                else:
                    cpu.mode = cpu.saved_mode
                    cpu.pc = cpu.saved_pc
                    cpu.next_pc = to_u32(cpu.pc + 4)
                cpu.cycles += 1
                emit_trace(cpu, pc, word, pre_gpr, pre_opr, pre_hi, pre_lo)
                return
            elif fn == 0x20:  # WAIT — halt until interrupt
                pass          # no interrupt model in this simulator
            elif fn in (0x01, 0x02, 0x06, 0x08):  # TLBR/TLBWI/TLBWR/TLBP
                if cpu.mode < MODE_FIRMWARE:
                    raise Trap(CAUSE_PRIV_INSTR, pc,
                               f"TLB op funct {fn:#x} requires firmware mode")
                # No real TLB in this simulator — VAs are tracked by
                # cpu.mappings, populated through MapObject. Treat as no-op
                # so firmware code that blindly issues TLBWR survives.
                pass
            else:
                raise Trap(CAUSE_RESERVED_INSTR, pc,
                           f"SYSTEM.CO funct {fn:#x}")
        else:
            raise Trap(CAUSE_RESERVED_INSTR, pc,
                       f"SYSTEM rs {rs:#x}")
    elif op == 0x09: cpu.set_gpr(rt, to_u32(gpr(rs) + simm))
    elif op == 0x0A: cpu.set_gpr(rt, 1 if sgpr(rs) < simm else 0)
    elif op == 0x0B: cpu.set_gpr(rt, 1 if gpr(rs) < (simm & 0xFFFFFFFF) else 0)
    elif op == 0x0C: cpu.set_gpr(rt, gpr(rs) & imm)
    elif op == 0x0D: cpu.set_gpr(rt, gpr(rs) | imm)
    elif op == 0x0E: cpu.set_gpr(rt, gpr(rs) ^ imm)
    elif op == 0x0F: cpu.set_gpr(rt, to_u32(imm << 16))
    elif op in (0x20,0x21,0x23,0x24,0x25):
        ea = to_u32(gpr(rs) + simm)
        if   op == 0x20: cpu.set_gpr(rt, cpu.load_gpr_mem(ea, 1, True,  pc))
        elif op == 0x21: cpu.set_gpr(rt, cpu.load_gpr_mem(ea, 2, True,  pc))
        elif op == 0x23: cpu.set_gpr(rt, cpu.load_gpr_mem(ea, 4, False, pc))
        elif op == 0x24: cpu.set_gpr(rt, cpu.load_gpr_mem(ea, 1, False, pc))
        elif op == 0x25: cpu.set_gpr(rt, cpu.load_gpr_mem(ea, 2, False, pc))
    elif op in (0x28,0x29,0x2B):
        ea = to_u32(gpr(rs) + simm)
        if   op == 0x28: cpu.store_gpr_mem(ea, 1, gpr(rt), pc)
        elif op == 0x29: cpu.store_gpr_mem(ea, 2, gpr(rt), pc)
        elif op == 0x2B: cpu.store_gpr_mem(ea, 4, gpr(rt), pc)
    elif op == 0x30:  # OBJECT R-R
        os_  = (word >> 22) & 0xF
        ot   = (word >> 18) & 0xF
        ord_ = (word >> 13) & 0x1F
        ofn  = (word >>  4) & 0xF
        if ofn == 0x0:
            cpu.set_opr(os_, cpu.get_opr(ot))
        elif ofn == 0x1:
            cpu.set_opr(os_, 0)
        elif ofn == 0x2:
            a = cpu.get_opr(os_); b = cpu.get_opr(ot)
            mask = 0xFFFFFFFFFFFF0000
            cpu.set_gpr(ord_, 1 if (a & mask) == (b & mask) else 0)
        elif ofn == 0x3:
            cpu.set_gpr(ord_, 1 if cpu.get_opr(os_) == 0 else 0)
        elif ofn in (0x4,0x5,0x6,0x7):
            desc, home = cpu.inspect_obj(os_, pc)
            if   ofn == 0x4: cpu.set_gpr(ord_, desc.length & 0xFFFFFFFF)
            elif ofn == 0x5: cpu.set_gpr(ord_, desc.type_tag & 0xFFFF)
            elif ofn == 0x6: cpu.set_gpr(ord_, home)
            elif ofn == 0x7: cpu.set_gpr(ord_, ref_caps(cpu.get_opr(os_)))
        elif ofn == 0x8:  # OFENCE — no-op in this simulator (no reordering to fence)
            pass
        else:
            raise Trap(CAUSE_RESERVED_INSTR, pc, f"OBJECT funct {ofn:#x}")
    elif op in (0x31,0x32,0x33,0x34,0x35,0x38,0x39,0x3B):
        os_ = (word >> 22) & 0xF
        rt_full = (word >> 16) & 0x3F
        if rt_full & 0x20:
            raise Trap(CAUSE_RESERVED_INSTR, pc,
                       "O-load/store rt' high bit reserved must be zero")
        rt5 = rt_full & 0x1F
        offset = sext16(word & 0xFFFF)
        # Width and signedness per opcode.
        op_meta = {
            0x31: (1, True,  False),  # OLB
            0x32: (2, True,  False),  # OLH
            0x33: (4, False, False),  # OLW
            0x34: (1, False, False),  # OLBU
            0x35: (2, False, False),  # OLHU
            0x38: (1, False, True),   # OSB
            0x39: (2, False, True),   # OSH
            0x3B: (4, False, True),   # OSW
        }
        width, signed, is_write = op_meta[op]
        ref = cpu.get_opr(os_)
        # Issuer-side fast-fail checks (no need to send a packet).
        if ref == 0:
            raise Trap(CAUSE_NULL_DEREF, pc, f"null O{os_} dereference")
        required_cap = CAP_W if is_write else CAP_R
        if (ref_caps(ref) & required_cap) != required_cap:
            raise Trap(CAUSE_CAP_VIOLATION, pc,
                       f"O{os_} caps {ref_caps(ref):#x} lacks {required_cap:#x}")
        home = ref_home(ref)
        if cpu.system is None or home == cpu.pid:
            # Local fast path: full validation, direct read/write.
            desc, off, _ = cpu.deref_obj(os_, offset, width,
                                         required_cap, pc)
            if is_write:
                val = cpu.get_gpr(rt5) & ((1 << (width*8)) - 1)
                desc.storage[off:off+width] = val.to_bytes(width, "big")
            else:
                raw = bytes(desc.storage[off:off+width])
                v = int.from_bytes(raw, "big")
                if signed and v & (1 << (width*8 - 1)):
                    v -= 1 << (width*8)
                cpu.set_gpr(rt5, to_u32(v))
        else:
            # Remote: build OBJ_READ_REQ or OBJ_WRITE_REQ, queue it on the
            # home CPU's request queue, and block at this OL/OS instruction
            # until the corresponding *_RESP arrives.
            trans_id = cpu.next_trans_id & 0xFFFF
            cpu.next_trans_id = (cpu.next_trans_id + 1) & 0xFFFF
            if is_write:
                val = cpu.get_gpr(rt5) & ((1 << (width*8)) - 1)
                data = val.to_bytes(width, "big")
                packet = build_obj_write_req(cpu.pid, home, trans_id,
                                             ref, offset, width, data)
            else:
                packet = build_obj_read_req(cpu.pid, home, trans_id,
                                            ref, offset, width)
            cpu.system.crossbar.send_packet(packet)
            raise BlockedOnResponse(trans_id, target_reg=rt5,
                                    width=width, signed=signed,
                                    is_write=is_write)
    elif op in (0x36, 0x37):  # OREFLD / OREFST
        os_  = (word >> 22) & 0xF
        od   = (word >> 18) & 0xF
        rsv  = (word >> 16) & 0x3
        if rsv != 0:
            raise Trap(CAUSE_RESERVED_INSTR, pc, "OREF rsv must be zero")
        offset = sext16(word & 0xFFFF)
        if op == 0x36:  # OREFLD Od, offset(Os)
            desc, off, _ = cpu.deref_obj(os_, offset, 8, CAP_R, pc,
                                         expect_objstore=True)
            ref_value = struct.unpack(">Q", bytes(desc.storage[off:off+8]))[0]
            cpu.set_opr(od, ref_value)
        else:           # OREFST Od, offset(Os)
            ref_value = cpu.get_opr(od)
            desc, off, _ = cpu.deref_obj(os_, offset, 8, CAP_W, pc,
                                         expect_objstore=True)
            desc.storage[off:off+8] = struct.pack(">Q", ref_value)
    elif op == 0x3C:  # SEND
        os_ = (word >> 22) & 0xF
        ref = cpu.get_opr(os_)
        if ref == 0:
            raise Trap(CAUSE_NULL_DEREF, pc, f"SEND on null O{os_}")
        if (ref_caps(ref) & CAP_S) == 0:
            raise Trap(CAUSE_CAP_VIOLATION, pc, f"SEND lacks S on O{os_}")
        # Validate against the home CPU's descriptor table only when that
        # CPU is reachable from this process (in-process multi-CPU mode).
        # In socket-mode the home lives behind the crossbar; the home
        # validates on receipt and silently drops on mismatch. Note that
        # `system.cpus` is positionally indexed, not pid-indexed: in
        # socket mode it has a single entry whose pid may be any value,
        # so we must search by pid rather than index by it.
        home = ref_home(ref)
        target_descriptors = None
        if cpu.system is not None:
            if home == cpu.pid:
                target_descriptors = cpu.descriptors
            else:
                for c in cpu.system.cpus:
                    if c.pid == home:
                        target_descriptors = c.descriptors
                        break
        if target_descriptors is not None:
            idx = ref_index(ref)
            if idx >= len(target_descriptors) or target_descriptors[idx] is None:
                raise Trap(CAUSE_STALE_REF, pc, f"SEND stale O{os_}")
            desc = target_descriptors[idx]
            if not desc.live or desc.generation != ref_generation(ref):
                raise Trap(CAUSE_STALE_REF, pc, f"SEND stale O{os_}")
        # Build payload: int = R4..R7, OR = O1..O4 (per Vol II Section 10).
        msg = PendingSend(
            recipient_ref=ref,
            int_payload=[cpu.get_gpr(4 + i) for i in range(4)],
            or_payload =[cpu.get_opr(1 + i) for i in range(4)],
            src_pid=cpu.pid,
            trans_id=cpu.next_trans_id & 0xFFFF,
        )
        cpu.next_trans_id = (cpu.next_trans_id + 1) & 0xFFFF
        if cpu.system is not None:
            cpu.system.queue_send(msg)
    elif op == 0x3D:  # CALL — no delay slot.
        prim = target26
        cpu._call_redirected_pc = False
        try:
            dispatch_call(cpu, prim, pc)
        except BlockedSignal as b:
            # Hold the CPU at this CALL; on resume the scheduler will
            # populate registers, advance PC by 4, and clear blocked_on.
            cpu.blocked_on = b
            cpu.cycles += 1
            emit_trace(cpu, pc, word, pre_gpr, pre_opr, pre_hi, pre_lo)
            return
        if not cpu._call_redirected_pc:
            cpu.pc = to_u32(pc + 4)
            cpu.next_pc = to_u32(cpu.pc + 4)
        # Else: primitive_InstallProgram already set PC to the new
        # entry point — don't advance past it.
        cpu.cycles += 1
        emit_trace(cpu, pc, word, pre_gpr, pre_opr, pre_hi, pre_lo)
        return
    else:
        raise Trap(CAUSE_RESERVED_INSTR, pc, f"opcode {op:#x}")

    if branch_target is None:
        cpu.pc = cpu.next_pc
        cpu.next_pc = to_u32(cpu.pc + 4)
    else:
        cpu.pc = cpu.next_pc
        cpu.next_pc = branch_target

    cpu.cycles += 1
    emit_trace(cpu, pc, word, pre_gpr, pre_opr, pre_hi, pre_lo)


# ---------------------------------------------------------------------------
# Trap reporter
# ---------------------------------------------------------------------------

def deliver_trap(cpu: CPU, t: Trap) -> bool:
    """Vector-driven trap delivery (Volume II Section 14 + Appendix B).

    Populates EPC/CAUSE/BADVADDR, saves the current mode, and either:

    1. Jumps to a supervisor-installed handler for this cause (mode
       switches to supervisor — installed via Volume VI primitive
       #0x520 InstallTrapHandler). Per-CPU map; the handler runs in
       the trapping task's address space.
    2. Falls back to `VECBASE + offset[cause]` (mode switches to
       firmware) when no per-cause handler is registered.

    Returns True when delivered; False when neither path applies, in
    which case the caller should fall back to the fatal-trap report.

    External-interrupt delivery (cause 0x01) auto-clears `STATUS.IE`
    so the handler runs without immediately re-firing on the same
    instruction; the handler re-enables IE on ERET (typically by
    SCTRL-ing STATUS or letting the saved-IE bit ride back via ERET
    — the latter not yet wired, today the handler must explicitly
    re-set IE).

    The handler returns by `ERET`, which restores `saved_mode` from
    STATUS and resumes at `EPC`. To skip the trapping instruction, the
    handler must add 4 to EPC before issuing ERET — re-execute is the
    default since most causes (TLB miss, future page faults) want it."""
    handler_va = cpu.trap_handlers.get(t.cause)
    if handler_va is None and cpu.vecbase == 0:
        return False
    if handler_va is None:
        offset = CAUSE_VECTOR_OFFSET.get(t.cause)
        if offset is None:
            return False
        target_pc   = (cpu.vecbase + offset) & 0xFFFFFFFF
        target_mode = MODE_FIRMWARE
    else:
        target_pc   = handler_va & 0xFFFFFFFF
        target_mode = MODE_SUPERVISOR

    # Checkpoint the user task's full state into its Task struct
    # BEFORE we overwrite cpu.pc / cpu.mode for the handler. This is
    # what makes TaskYield-from-handler safe — when the handler
    # eventually sets yield_pending and ERETs, the outgoing task
    # struct already holds a valid resume image of the trapped task.
    # Without this, we'd save the handler's mid-execution state
    # instead and resume into junk on the next schedule. The ERET
    # path also uses this to restore user GPRs the handler may have
    # clobbered. (Phase 35.)
    if cpu.current_task is not None:
        save_cpu_to_task(cpu, cpu.current_task)

    cpu.saved_mode    = cpu.mode
    cpu.saved_pc      = t.faulting_pc & 0xFFFFFFFF
    cpu.cause_reg     = t.cause & 0xFFFFFFFF
    cpu.badvaddr_reg  = t.bad_vaddr & 0xFFFFFFFF
    cpu.mode          = target_mode
    cpu.pc            = target_pc
    cpu.next_pc       = (cpu.pc + 4) & 0xFFFFFFFF
    cpu.in_trap_handler = True
    # If we're delivering to an installed supervisor handler, swap in
    # the mappings the supervisor had at install time. The handler VA
    # may not be reachable in the trapping task's address space, but
    # save_cpu_to_task above already captured the trapping task's
    # mappings; ERET via load_task_to_cpu restores them.
    if handler_va is not None and t.cause in cpu.trap_handler_mappings:
        cpu.mappings = list(cpu.trap_handler_mappings[t.cause])
    if t.cause == CAUSE_EXTERNAL_INTERRUPT:
        cpu.status_ie = False
    # If we trapped while parked at a CALL waiting on a primitive (or at
    # a remote OL/OS waiting on a response), the handler is taking over.
    # Drop the wait state — ERET will return us to the trapping
    # instruction, which can re-issue the CALL/load if it needs to.
    cpu.blocked_on    = None
    return True


def report_trap(cpu: CPU, t: Trap) -> None:
    prefix = f"CPU{cpu.pid} " if (cpu.system and cpu.system.n_cpus > 1) else ""
    print(f"simorisc: {prefix}trap {CAUSE_NAMES.get(t.cause, hex(t.cause))} "
          f"(cause 0x{t.cause:02x}) at PC=0x{t.faulting_pc:08x}: {t.detail}",
          file=sys.stderr)
    print(f"  PC=0x{cpu.pc:08x}  next_PC=0x{cpu.next_pc:08x}  "
          f"cycles={cpu.cycles}", file=sys.stderr)
    for i in range(0, 32, 4):
        row = "  " + "  ".join(f"r{j:>2}=0x{cpu.gpr[j]:08x}"
                               for j in range(i, i+4))
        print(row, file=sys.stderr)
    for i in range(0, 16, 2):
        print(f"  o{i:>2}=0x{cpu.opr[i]:016x}  "
              f"o{i+1:>2}=0x{cpu.opr[i+1]:016x}", file=sys.stderr)


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

SERVICE_SPEC_RE = re.compile(
    r'^(?P<pid>\d+)=(?P<idx>\d+)@(?P<caps>0[xX][0-9a-fA-F]+|\d+)$')


def install_external_services(cpu: CPU, specs: List[str]) -> None:
    """Synthesize references to remote services and install them in
    O5..O5+len(specs)-1. Each spec is `PID=INDEX@CAPS` (caps may be
    decimal or 0x-hex). Generation is fixed at 1 by convention; the
    remote endpoint is responsible for using the same generation."""
    slot = 5
    for spec in specs:
        m = SERVICE_SPEC_RE.match(spec)
        if not m:
            sys.exit(f"simorisc: bad --service spec: {spec!r}; "
                     f"expected PID=INDEX@CAPS")
        pid_v = int(m.group("pid"))
        idx_v = int(m.group("idx"))
        caps_v = int(m.group("caps"), 0)
        if pid_v < 0 or pid_v > 255 or idx_v < 0 or idx_v >= (1 << 24) \
                or caps_v < 0 or caps_v > 0xFF:
            sys.exit(f"simorisc: --service spec out of range: {spec!r}")
        if slot > 15:
            sys.exit("simorisc: too many --service specs (O5..O15 limit)")
        # "0=0@0" is the conventional pad/skip placeholder. Emit a
        # literal-zero ref rather than make_ref(gen=1, ...)'s
        # 0x0001000000000000 sentinel — a literal zero is what
        # OISN considers null and what callers expect when checking
        # "is this slot empty." (Pre-Phase-45a code that just used
        # the slot as scratch isn't affected — both encodings have
        # caps=0 and would trap on inspect either way.)
        if pid_v == 0 and idx_v == 0 and caps_v == 0:
            cpu.set_opr(slot, 0)
        else:
            ref = make_ref(generation=1, home=pid_v, index=idx_v, caps=caps_v)
            cpu.set_opr(slot, ref)
        slot += 1


def populate_self_service(cpu: CPU) -> None:
    """In socket-mode single-CPU configurations, allocate a service
    object on the local CPU and install its full-cap reference in O4
    (mirrors the role of populate_service_objects in multi-CPU)."""
    ref = cpu.alloc_object(SERVICE_OBJ_SIZE, type_tag=TAG_SERVICE,
                           max_caps=CAP_R | CAP_W | CAP_S | CAP_V | CAP_C)
    cpu.set_opr(4, ref)


def main(argv: List[str]) -> int:
    ap = argparse.ArgumentParser(prog="simorisc",
        description="Object RISC instruction-set simulator")
    ap.add_argument("orx", help="path to .orx binary")
    ap.add_argument("--processors", type=int, default=1,
                    help="number of Object RISC processors (in-process; "
                         "default 1). Mutually exclusive with --connect.")
    ap.add_argument("--connect", default=None, metavar="SOCKET",
                    help="connect to an external oriscbar at this UNIX "
                         "socket path; runs as a single-CPU process")
    ap.add_argument("--pid", type=int, default=0,
                    help="processor identifier this CPU presents to the "
                         "external crossbar (default 0; ignored without "
                         "--connect)")
    ap.add_argument("--service", action="append", default=[],
                    metavar="PID=INDEX@CAPS",
                    help="install a synthesized remote service reference "
                         "in O5..O15. Repeatable; ignored without "
                         "--connect.")
    ap.add_argument("--serve", action="store_true",
                    help="in --connect mode: don't exit when the local "
                         "task goes idle; keep polling the crossbar for "
                         "incoming SENDs and handler dispatches until "
                         "the socket closes or a signal arrives. Use this "
                         "for server-style CPUs.")
    ap.add_argument("--reset-on-exit", action="store_true",
                    help="in --connect mode: when the running task hits "
                         "TaskExit, don't terminate the process — wipe all "
                         "state and re-run init from the loaded .orx. "
                         "Used for MVP program-spawning: pre-spawned spare "
                         "CPUs run the chunkboot loader, run a guest "
                         "program, exit, reset, re-announce — making the "
                         "CPU a reusable boot target.")
    ap.add_argument("--trace", action="store_true",
                    help="print each retired instruction with register effects")
    ap.add_argument("--max-cycles", type=int, default=None,
                    help="cycle bound. Default 10_000_000 in standalone "
                         "mode (a CI-friendly safety net for runaway "
                         "tests); 0 / unset in --connect (socket) mode "
                         "means unlimited — interactive sessions are "
                         "owned by the crossbar lifecycle, not by an "
                         "instruction count. Pass an explicit value to "
                         "override either default.")
    ap.add_argument("--display", choices=["none", "tk"], default="none",
                    help="Phase 60 — host display backend for "
                         "TAG_FRAMEBUFFER objects (allocated via "
                         "ObjAllocFramebuffer). 'tk' opens a Tk "
                         "window per framebuffer this CPU allocates "
                         "and mirrors stores into it; 'none' (default) "
                         "leaves framebuffers as plain bytearrays — "
                         "the firmware path still works, just nothing "
                         "appears on screen.  Headless CI keeps the "
                         "default; interactive boots pass --display tk.")
    ap.add_argument("--init-r4", type=int, default=0,
                    help="initial R4 value for the loaded program. "
                         "Read by libc task_init via crt0's "
                         "_orisc_init_r4 stash; programs use it to "
                         "carry a small int from boot args (e.g., "
                         "oriscwm uses it as its terminal index). "
                         "Defaults to 0 (== task_my_terminal_idx() "
                         "of -1 'no info' for libc-aware programs).")
    ap.add_argument("--mode", choices=["user", "supervisor", "firmware"],
                    default="supervisor",
                    help="initial privilege mode of the loaded task "
                         "(Volume II §13). Default 'supervisor' so all "
                         "existing programs keep working; pass 'user' to "
                         "verify a guest stays out of LCTRL/SCTRL/MapObject/"
                         "InstallProgram, or 'firmware' to allow TLB ops.")
    args = ap.parse_args(argv)
    initial_mode = {
        "user": MODE_USER,
        "supervisor": MODE_SUPERVISOR,
        "firmware": MODE_FIRMWARE,
    }[args.mode]

    if args.connect is not None and args.processors != 1:
        sys.exit("simorisc: --connect implies single-CPU; --processors "
                 "must be 1 (its default)")
    if args.processors < 1 or args.processors > 16:
        sys.exit("simorisc: --processors must be in [1, 16]")

    text_bytes, data_bytes, entry, stack_size = load_orx_file(args.orx)

    system = System(args.processors)
    system.trace_enabled = args.trace

    if args.connect is not None:
        # Replace the default in-process crossbar with a socket one
        # bound to the user-specified pid.
        cpu = system.cpus[0]
        cpu.pid = args.pid
        socket_xbar = SocketCrossbar(args.connect, args.pid,
                                     trace_enabled=args.trace)
        system.crossbar = socket_xbar
        system.serve_mode = args.serve
        socket_xbar.attach_port(args.pid, cpu)
        cpu.trace_enabled = args.trace
        # Stash the boot inputs so reset_cpu can re-init verbatim on
        # TaskExit. --reset-on-exit only meaningful in --connect mode
        # (otherwise there's no socket to keep alive).
        cpu.reset_args = {
            "text":       text_bytes,
            "data":       data_bytes,
            "entry":      entry,
            "stack_size": stack_size,
            "services":   args.service,
            "init_r4":    args.init_r4,
        }
        cpu.reset_on_exit = args.reset_on_exit
        cpu.initial_mode  = initial_mode
        init_cpu(cpu, text_bytes, data_bytes, entry, stack_size)
        if args.init_r4:
            cpu.set_gpr(4, args.init_r4 & 0xFFFFFFFF)
        populate_self_service(cpu)
        install_external_services(cpu, args.service)
        snapshot_boot_state(cpu)
        cpu.mode = initial_mode
        if args.display == "tk":
            cpu.display_worker = TkDisplayWorker()
    else:
        system.crossbar.trace_enabled = args.trace
        for cpu in system.cpus:
            cpu.trace_enabled = args.trace
            cpu.initial_mode  = initial_mode
            init_cpu(cpu, text_bytes, data_bytes, entry, stack_size)
            if args.init_r4:
                cpu.set_gpr(4, args.init_r4 & 0xFFFFFFFF)
            cpu.mode = initial_mode
            if args.display == "tk":
                cpu.display_worker = TkDisplayWorker()
        populate_service_objects(system)
        for cpu in system.cpus:
            snapshot_boot_state(cpu)

    # Resolve the cycle bound. Default is 10M for standalone (a CI
    # safety net for runaway tests); 0 / unset in --connect mode means
    # unlimited because interactive sessions are owned by the
    # crossbar lifecycle, not by an instruction count.
    if args.max_cycles is None:
        max_cycles = 0 if args.connect is not None else 10_000_000
    else:
        max_cycles = args.max_cycles

    try:
        return system.run(max_cycles)
    finally:
        system.crossbar.close()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
