def parse_pid_list(s: str) -> List[int]:
    out = []
    for part in s.split(","):
        part = part.strip()
        if not part:
            continue
        try:
            v = int(part, 0)
        except ValueError:
            raise SystemExit(f"linkbootd: bad pid in list: {part!r}")
        if v < 0 or v > 255:
            raise SystemExit(f"linkbootd: pid out of range: {v}")
        out.append(v)
    return out


def main(argv) -> int:
    ap = argparse.ArgumentParser(prog="linkbootd",
        description="Object RISC link-boot server (Python-side, "
                    "non-CPU crossbar participant)")
    ap.add_argument("--socket", required=True,
                    help="path to oriscbar's UNIX domain socket")
    ap.add_argument("--pid", type=int, required=True,
                    help="processor identifier this server presents to "
                         "the crossbar")
    ap.add_argument("--shell-pids", default="",
                    help="comma-separated list of PIDs that may issue "
                         "spawn requests (typically just '0')")
    ap.add_argument("--loader-pids", default="",
                    help="comma-separated list of PIDs in the chunkboot "
                         "loader pool")
    ap.add_argument("--image", type=Path, default=None,
                    help="optional preload image. If given, queued at "
                         "startup as if a shell had spawned it (with no "
                         "completion notification). Used by the legacy "
                         "run_python_master.sh demo.")
    ap.add_argument("--root", type=Path, default=None,
                    help="resolve relative paths from spawn requests "
                         "under this root, and reject paths that try "
                         "to escape it via '..'. Mirrors hostfsd's "
                         "--root: typically point both at the same dir "
                         "so 'run foo.orx' from the shell finds the "
                         "same file 'cat foo.orx' would.")
    ap.add_argument("--entry", type=int, default=None,
                    help="entry offset for --image (overrides .orx header)")
    ap.add_argument("-v", "--verbose", action="store_true")
    args = ap.parse_args(argv)

    shell_pids  = parse_pid_list(args.shell_pids)
    loader_pids = parse_pid_list(args.loader_pids)

    preload = None
    if args.image is not None:
        try:
            text, data, entry = load_image(args.image)
        except (FileNotFoundError, ValueError, OSError) as e:
            sys.exit(f"linkbootd: --image {args.image}: {e}")
        if not text:
            sys.exit(f"linkbootd: --image {args.image}: empty text section")
        if args.entry is not None:
            entry = args.entry
        if entry < 0 or entry >= len(text):
            sys.exit(f"linkbootd: --entry {entry} out of range "
                     f"[0, {len(text)})")
        if len(text) % 4 != 0:
            text = text + bytes((-len(text)) % 4)
        if len(data) % 4 != 0:
            data = data + bytes((-len(data)) % 4)
        preload = (text, data, entry)

    server = LinkBootD(args.socket, args.pid,
                       shell_pids=shell_pids, loader_pids=loader_pids,
                       root=args.root, preload=preload,
                       verbose=args.verbose)

    def _signal(_signo, _frame):
        server.shutdown_requested = True
    signal.signal(signal.SIGINT,  _signal)
    signal.signal(signal.SIGTERM, _signal)

    server.run()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
