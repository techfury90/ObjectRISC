#!/usr/bin/env python3
"""oriscterm — graphics terminal device for the Object RISC crossbar.

A tkinter window that connects to an oriscbar process like any other
participant on the wire. It exposes a single "console" object at a
known (pid, index, generation, caps) tuple. When a CPU SENDs to this
object, the terminal:

    1. Parses the SEND_DELIVER packet from the crossbar.
    2. Reads the SEND payload's first OR slot as a *source buffer*
       reference, the first int slot as an *offset*, and the second
       as a *length*.
    3. Issues an OBJ_READ_REQ packet to the source's home pid for
       `length` bytes starting at `offset` within the source object.
    4. When the OBJ_READ_RESP arrives, decodes the data words back
       into bytes and appends them to the on-screen text widget.

The protocol is the same wire format as everything else on the
crossbar; the terminal is just another Port participating in the
Volume IV §3 packet exchange. No special simulator support needed.

Usage:
    tools/devices/oriscterm --socket /tmp/oriscbar.sock --pid 16

The console object's index (1) and generation (1) are fixed by
convention; CPUs synthesize a `pid=16, index=1, caps=R|S` reference
to reach it (typically via simorisc's `--service 16=1@9`).
"""

import argparse
import struct
import sys
import time
import tkinter as tk
import tkinter.font as tkfont
from typing import Dict, Optional, Tuple

# Wire-format constants must agree with simorisc/oriscbar.
HELLO_MAGIC  = 0xC0FFEEAA
HELLO_OK     = 0x00000000

PKT_OBJ_READ_REQ   = 0x10
PKT_OBJ_READ_RESP  = 0x11
PKT_OBJ_WRITE_REQ  = 0x12
PKT_OBJ_WRITE_RESP = 0x13
PKT_SEND_DELIVER   = 0x20

# OBJ-RESP fault codes (Vol IV §4.1, low six bits of the response
# `flags` byte).  Mirrored from simorisc's RESP_*.
RESP_OK         = 0x00
RESP_STALE      = 0x01
RESP_BOUNDS     = 0x02
RESP_CAP        = 0x03

# Service objects exposed by oriscterm. Each is a separate capability:
# CPUs hold an OR per service they want to use, and the dispatch goes
# by the recipient ref's index field (Vol III §2.1).
CONSOLE_INDEX     = 1    # text console — append bytes to the text pane
KEYBOARD_INDEX    = 2    # keyboard subscription — receive key events back
GRID_INDEX        = 3    # grid text — write at (col, row) on the canvas
VECTOR_INDEX      = 4    # vector graphics — line / rect / oval / clear
RASTER_INDEX      = 5    # raster blit (protocol pinned, impl deferred)
POINTER_INDEX     = 6    # pointer / mouse — subscribe to receive events
FRAMEBUFFER_INDEX = 7    # 8-bit indexed pixel surface — exposed as a
                         # TAG_DATA-shaped bytes object the canvas
                         # renders behind everything else.  Clients
                         # walk /sys/term/<n>/framebuffer to get a
                         # R|W|V cap and OBJ_READ/WRITE_REQ pixel
                         # bytes at byte offset (1 byte per pixel,
                         # row-major; offset = y * fb_w + x).

# Generation is fixed at 1 by simorisc convention (--service spec).
SERVICE_GENERATION = 1

# Caps the terminal grants when it synthesizes refs to its own service
# objects.
SERVICE_MAX_CAPS = 0x5B   # R|W|S|V|C

# Individual cap bits (Vol III §2.1) — used by the Phase 47
# self-registration packing.
CAP_R = 0x01
CAP_W = 0x02
CAP_S = 0x08
CAP_V = 0x10

# Phase 47: oriscdir's pid + service index, plus the inline-register op
# code. The terminal synthesizes a SEND_DELIVER carrying its own
# service ref(s) packed alongside the path so it can publish them at
# /sys/term/<instance>/{console,keyboard,grid} without needing a CPU
# to ObjAlloc a TAG_DATA bytes object on its behalf.
DIR_SERVICE_INDEX = 1
OP_REG_INLINE     = 5

# ---- vector service command codes (R4 in the SEND payload) -----------------
VEC_LINE         = 0x00
VEC_RECT_FILL    = 0x01
VEC_RECT_OUTLINE = 0x02
VEC_OVAL_FILL    = 0x03
VEC_OVAL_OUTLINE = 0x04
VEC_CLEAR        = 0x05
VEC_SET_COLOR    = 0x06

# Tiny palette — picked for an "early-1980s graphics terminal" feel.
# Index 0 is the background, 1 is the default stroke colour.
# ---- pointer service event types (R4 in the SEND payload) ------------------
PTR_MOTION  = 0x00
PTR_DOWN    = 0x01
PTR_UP      = 0x02

# ---- pointer button codes (R6 in down/up events; bits in R7 state mask) ---
PTR_BTN_LEFT   = 1
PTR_BTN_MIDDLE = 2
PTR_BTN_RIGHT  = 3


VEC_PALETTE = {
    0:  "#0a0a14",   # background (matches the text widget's bg)
    1:  "#d8d8d8",   # default foreground
    2:  "#ff5555",   # red
    3:  "#55ff55",   # green
    4:  "#5599ff",   # blue
    5:  "#ffd866",   # yellow
    6:  "#66ddff",   # cyan
    7:  "#ff66ff",   # magenta
    8:  "#ffffff",   # bright white
}

# Special-key codepoints — used in keyboard SEND payloads (R4) for
# keys that don't map to a printable ASCII byte. Anything ≥ 0x100 is
# a special key; anything < 0x80 is plain ASCII (bytes 0x00..0x7F).
KEY_BACKSPACE = 0x108
KEY_TAB       = 0x109
KEY_RETURN    = 0x10D
KEY_ESCAPE    = 0x11B
KEY_DELETE    = 0x17F
KEY_UP        = 0x180
KEY_DOWN      = 0x181
KEY_LEFT      = 0x182
KEY_RIGHT     = 0x183
KEY_HOME      = 0x184
KEY_END       = 0x185
KEY_PAGE_UP   = 0x186
KEY_PAGE_DOWN = 0x187
KEY_F1        = 0x190    # F2..F12 are 0x191..0x19B

# Synthetic event the terminal emits to a subscriber when F1 cycles
# focus to it. Programs that draw something to the screen (the
# editor, a future window manager, anything painting the grid)
# observe this as a "you have the keyboard now — repaint if you
# care" signal: most main-loop architectures already redraw before
# blocking on the next key, so falling through with no explicit
# handler is enough to get a fresh paint. mods is always 0.
KEY_FOCUS_IN  = 0x10E    # adjacent to KEY_RETURN (0x10D)

# Modifier mask (R5 in keyboard event SENDs). One bit per modifier.
MOD_SHIFT = 0x01
MOD_CTRL  = 0x02
MOD_ALT   = 0x04        # Option on macOS
MOD_META  = 0x08        # Command on macOS

POLL_INTERVAL_MS = 30        # how often the UI checks the socket


def pack_packet(src_pid: int, dst_pid: int, msg_type: int, flags: int,
                trans_id: int, payload_words) -> bytes:
    length_words = len(payload_words)
    header = struct.pack(">BBBBHH",
                         src_pid & 0xFF, dst_pid & 0xFF,
                         msg_type & 0xFF, flags & 0xFF,
                         trans_id & 0xFFFF, length_words & 0xFFFF)
    payload = b''.join(struct.pack(">I", w & 0xFFFFFFFF)
                       for w in payload_words)
    h0, h1 = struct.unpack(">II", header)
    chk = h0 ^ h1
    for w in payload_words:
        chk ^= w & 0xFFFFFFFF
    return header + payload + struct.pack(">I", chk & 0xFFFFFFFF)


def unpack_packet(data: bytes) -> Dict:
    if len(data) < 12:
        raise ValueError("packet too short")
    src, dst, mtype, flags, trans_id, length_words = \
        struct.unpack(">BBBBHH", data[:8])
    expected = 8 + length_words * 4 + 4
    if len(data) != expected:
        raise ValueError(f"length mismatch ({len(data)} != {expected})")
    payload_bytes = data[8:8 + length_words * 4]
    words = list(struct.unpack(f">{length_words}I", payload_bytes)) \
        if length_words else []
    h0, h1 = struct.unpack(">II", data[:8])
    chk = h0 ^ h1
    for w in words:
        chk ^= w
    expected_chk = struct.unpack(">I", data[-4:])[0]
    if chk != expected_chk:
        raise ValueError("checksum mismatch")
    return {"src_pid": src, "dst_pid": dst, "type": mtype,
            "flags": flags, "trans_id": trans_id, "payload": words}


def ref_home(ref: int)  -> int: return (ref >> 40) & 0xFF
def ref_index(ref: int) -> int: return (ref >> 16) & 0xFFFFFF

def make_ref(generation: int, home: int, index: int, caps: int) -> int:
    """Pack a 64-bit OR — Vol III §2.1 layout. Phase 47 uses this to
    synthesize sub-caps of our own service objects before sending
    them to oriscdir for publishing."""
    return ((generation & 0xFFFF) << 48) | \
           ((home       & 0xFF)   << 40) | \
           ((index      & 0xFFFFFF) << 16) | \
           ((caps       & 0xFF)   << 8)


def build_obj_read_req(src_pid: int, dst_pid: int, trans_id: int,
                       ref: int, offset: int, width: int) -> bytes:
    payload = [ref & 0xFFFFFFFF, (ref >> 32) & 0xFFFFFFFF,
               offset & 0xFFFFFFFF, width & 0xFFFFFFFF]
    return pack_packet(src_pid, dst_pid, PKT_OBJ_READ_REQ, 0, trans_id, payload)


def build_obj_read_resp(src_pid: int, dst_pid: int, trans_id: int,
                        flags: int, data: bytes) -> bytes:
    """Pad data to a 4-byte word boundary; pack as response payload.
    flags carries RESP_OK / RESP_BOUNDS / etc. in low six bits."""
    if flags == RESP_OK:
        pad = (-len(data)) % 4
        padded = data + bytes(pad)
        words = list(struct.unpack(f">{len(padded)//4}I", padded)) \
            if padded else []
    else:
        words = []
    return pack_packet(src_pid, dst_pid, PKT_OBJ_READ_RESP, flags,
                       trans_id, words)


def build_obj_write_resp(src_pid: int, dst_pid: int, trans_id: int,
                         flags: int) -> bytes:
    """OBJ_WRITE_RESP carries no data — flags is the entire reply."""
    return pack_packet(src_pid, dst_pid, PKT_OBJ_WRITE_RESP, flags,
                       trans_id, [])


def parse_send_deliver(pkt: Dict):
    p = pkt["payload"]
    if len(p) != 14:
        raise ValueError("SEND_DELIVER payload must be 14 words")
    recipient_ref = p[0] | (p[1] << 32)
    int_payload = list(p[2:6])
    or_payload = []
    for i in range(4):
        ref = p[6 + 2*i] | (p[7 + 2*i] << 32)
        or_payload.append(ref)
    return recipient_ref, int_payload, or_payload


def build_send_deliver(src_pid: int, dst_pid: int, trans_id: int,
                       recipient_ref: int,
                       int_payload, or_payload) -> bytes:
    """Pack a SEND_DELIVER per Vol IV §4.2 — 14 payload words: 2 for
    the recipient ref, 4 for R4..R7, 8 for the four OR slots."""
    payload = [recipient_ref & 0xFFFFFFFF, (recipient_ref >> 32) & 0xFFFFFFFF]
    for i in range(4):
        payload.append(int_payload[i] & 0xFFFFFFFF if i < len(int_payload) else 0)
    for i in range(4):
        ref = or_payload[i] if i < len(or_payload) else 0
        payload.append(ref & 0xFFFFFFFF)
        payload.append((ref >> 32) & 0xFFFFFFFF)
    return pack_packet(src_pid, dst_pid, PKT_SEND_DELIVER, 0, trans_id, payload)


# ---------------------------------------------------------------------------
# Terminal
# ---------------------------------------------------------------------------

class Terminal:
    def __init__(self, sock_path: str, my_pid: int, verbose: bool = False,
                 dir_pid: Optional[int] = None, instance: int = 0):
        import socket
        self.my_pid = my_pid
        self.verbose = verbose
        self.dir_pid = dir_pid          # Phase 47: oriscdir's pid; None disables self-register
        self.instance = instance        # Phase 47: /sys/term/<instance>/...
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.recv_buf = bytearray()
        self.connected = True
        self.next_trans_id = 0
        # Map our outbound OBJ_READ_REQ trans_ids to a pending action,
        # so we know what to do with the corresponding RESP.
        self.pending_reads: Dict[int, str] = {}
        # Active keyboard subscribers — recipient refs the terminal
        # SENDs key events to. Updated by SENDs to KEYBOARD_INDEX
        # (a non-null O3 payload subscribes that ref; a null O3
        # unsubscribes the sender's last subscription).
        # When more than one CPU subscribes, only the focused one
        # receives keys; F1 cycles focus between them. The shell's
        # subscribe lands first → starts focused.
        self.kbd_subscribers: list = []
        self.kbd_focus_idx: int = 0
        # Active pointer subscribers — same pattern as keyboard.
        # Bitmask of currently-pressed buttons (bit N == button N down).
        self.ptr_subscribers: list = []
        self.ptr_button_state: int = 0

        # Connect + handshake (with a brief retry while the launcher
        # brings the crossbar up).
        deadline = time.time() + 5.0
        while True:
            try:
                self.sock.connect(sock_path)
                break
            except (FileNotFoundError, ConnectionRefusedError) as e:
                if time.time() >= deadline:
                    raise SystemExit(f"oriscterm: connect failed: {e}")
                time.sleep(0.05)
        self.sock.sendall(struct.pack(">II", HELLO_MAGIC, my_pid))
        reply = self._recv_exact(8)
        magic, status = struct.unpack(">II", reply)
        if magic != HELLO_MAGIC or status != HELLO_OK:
            raise SystemExit(f"oriscterm: handshake failed "
                             f"(magic={magic:#x}, status={status:#x})")
        self.sock.setblocking(False)

        # Build the UI. Two panes: the existing scrolling text pane on
        # top (for stream-style console output and human-readable
        # status), and a graphics Canvas below (for grid-positioned
        # text and vector drawing — services 3 and 4).
        self.root = tk.Tk()
        self.root.title(f"Object RISC Terminal · pid={my_pid}")
        # Bring the window to the front on launch — when oriscterm is
        # spawned by oriscrun the parent app keeps focus, leaving the
        # tk window buried.
        self.root.lift()
        self.root.attributes('-topmost', True)
        self.root.after(150, lambda: self.root.attributes('-topmost', False))

        font = tkfont.Font(family="Menlo", size=14)
        # Text pane is sized for an interactive shell session — 24
        # rows is the legacy terminal default. Below it the graphics
        # canvas gets its own 80×24 strip for grid / vector / raster /
        # pointer; programs that don't touch graphics (the shell,
        # kbd_echo, host-cat) just see a tall text area with an empty
        # canvas band underneath. Sizing the canvas to the same 80×24
        # as the text pane lets a full-screen grid app (Phase 38's
        # `view`, the eventual editor) feel proportionate.
        self.text = tk.Text(self.root, width=80, height=24,
                            bg="#0a0a14", fg="#d8d8d8",
                            insertbackground="#d8d8d8",
                            font=font, padx=12, pady=12,
                            wrap="word", borderwidth=0,
                            highlightthickness=0)
        self.text.pack(side="top", fill="both", expand=True)
        self.text.insert("end",
            f"oriscterm online · pid={my_pid}\n"
            f"  console  idx={CONSOLE_INDEX}    keyboard    idx={KEYBOARD_INDEX}\n"
            f"  grid     idx={GRID_INDEX}    vector      idx={VECTOR_INDEX}\n"
            f"  pointer  idx={POINTER_INDEX}    framebuffer idx={FRAMEBUFFER_INDEX}\n")
        self.text.see("end")
        self.text.configure(state="disabled")

        # The graphics Canvas. Character-cell metrics come from the
        # same monospace font as the text pane, so the grid service can
        # land bytes at integer (col, row) positions that visually
        # match what the text pane shows.
        self.cell_w = font.measure("M")
        self.cell_h = font.metrics("linespace")
        self.canvas_cols = 80
        self.canvas_rows = 24
        self.canvas_w = self.cell_w * self.canvas_cols
        self.canvas_h = self.cell_h * self.canvas_rows
        # Phase 59 / WM γ.6 — window 1 is text-pane only.  The
        # graphics canvas still exists (grid / vector / raster /
        # pointer items are created on it) but isn't packed — it's
        # an unmapped widget that holds item state without taking
        # screen real estate.  The next migration step routes these
        # items to a canvas in window 2 alongside the framebuffer.
        # Until then, grid/vector demos won't be visually
        # observable in `make boot` (only test paths, which use
        # fake_terminal's separate grid storage).
        self.canvas = tk.Canvas(self.root,
                                width=self.canvas_w, height=self.canvas_h,
                                bg=VEC_PALETTE[0],
                                borderwidth=0, highlightthickness=0)
        # NOTE: canvas intentionally not packed.
        self.canvas_font = font
        self.vec_color = VEC_PALETTE[1]   # current stroke / fill color

        # Per-cell text-item tracking. Without this, a second grid SEND
        # at (col, row) would draw on top of the first — visually
        # stacking glyphs. The editor (Phase 39) repaints constantly
        # and needs proper cell-replace semantics. Maps (col, row) to
        # a Canvas item id; on re-paint we delete the old id first.
        # Cleared by VEC_CLEAR and the grid clear sentinel (col=-1).
        self.grid_items: Dict[Tuple[int, int], int] = {}

        # Phase 57 — framebuffer (FRAMEBUFFER_INDEX = 7).  An 8-bit
        # indexed pixel surface exposed as a TAG_DATA-shaped bytes
        # object that clients OBJ_READ_REQ / OBJ_WRITE_REQ pixel
        # bytes against.  Sized to match the existing canvas (so
        # vector/grid/pointer coordinates and framebuffer pixel
        # coordinates agree), one byte per pixel, row-major.  Index
        # space is the same VEC_PALETTE the vector service uses, so
        # writes pick from the same 9-color "early-1980s graphics
        # terminal" palette.
        #
        # The Tk Canvas hosts the framebuffer as a PhotoImage at
        # z-bottom; grid / vector / raster items continue to draw on
        # top.  Repainting is dirty-tracked: the poll loop only
        # rebuilds the PhotoImage when an OBJ_WRITE_REQ has actually
        # mutated pixels since the last paint.  No work spent on
        # static frames.
        # Native framebuffer size: 1280×768 (matches the WM's
        # FB_W/FB_H and oriscterm's window-2 canvas 1:1 — no
        # display-side scaling).  Was tied to the (Menlo-14)
        # canvas_w/canvas_h in earlier milestones when the FB
        # rode under the grid/vector overlays; now that the FB
        # lives in its own Toplevel, the resolution is its own
        # property and decouples from font measurements.
        self.fb_w = 1280
        self.fb_h = 768
        self.framebuffer = bytearray(self.fb_w * self.fb_h)
        self.framebuffer_dirty = False
        # Precompute palette as 768-byte flat RGB lookup; entries
        # outside VEC_PALETTE fall through to bg color (index 0).
        self.fb_palette_rgb = bytearray(256 * 3)
        bg_hex = VEC_PALETTE[0]
        bg_rgb = (int(bg_hex[1:3], 16),
                  int(bg_hex[3:5], 16),
                  int(bg_hex[5:7], 16))
        for i in range(256):
            color_hex = VEC_PALETTE.get(i)
            if color_hex is None:
                r, g, b = bg_rgb
            else:
                r = int(color_hex[1:3], 16)
                g = int(color_hex[3:5], 16)
                b = int(color_hex[5:7], 16)
            self.fb_palette_rgb[i*3]     = r
            self.fb_palette_rgb[i*3 + 1] = g
            self.fb_palette_rgb[i*3 + 2] = b
        # PhotoImage on the canvas at (0, 0), pushed below all other
        # canvas items so grid / vector / pointer overlays sit on
        # top.  configure(data=…) with PPM-P6 bytes is the cheapest
        # full-frame update Tk's stdlib bindings expose.
        # Phase 59 / WM γ.5 — framebuffer lives in its own Toplevel
        # ("Window 2") at native 1280×768.  The WM renders glyphs at
        # this resolution directly (16×32 cells = 80 cols × 24 rows,
        # 2× upscale of the embedded 8×16 font).  No display-side
        # zoom: oriscterm renders the framebuffer 1:1 to a PhotoImage
        # of the same size.
        #
        # Originally the FB rode at z-bottom of the main canvas under
        # the grid/vector/pointer overlays — but that put it
        # underneath the Tk text widget showing the same console
        # output via the wire-forward path, and the two were
        # pixel-identical.  The dedicated Toplevel lifts the FB out
        # so the WM's bitmap rendering is visibly distinct from the
        # console pane in the main window.  Grid / vector / pointer
        # overlays will migrate to window 2 in a follow-up.
        self.fb_window       = tk.Toplevel(self.root)
        self.fb_window.title(f"Object RISC Framebuffer · pid={my_pid}")
        self.fb_window_image = tk.PhotoImage(width=self.fb_w,
                                             height=self.fb_h)
        self.fb_window_canvas = tk.Canvas(self.fb_window,
                                          width=self.fb_w,
                                          height=self.fb_h,
                                          bg=VEC_PALETTE[0],
                                          borderwidth=0,
                                          highlightthickness=0)
        self.fb_window_canvas.pack(fill="both", expand=True)
        self.fb_window_canvas.create_image(
            0, 0, image=self.fb_window_image, anchor="nw")
        # Closing the FB window just hides it — keeps the main
        # oriscterm window alive (which is what controls the process
        # lifetime).
        self.fb_window.protocol(
            "WM_DELETE_WINDOW", self.fb_window.withdraw)

        # Capture every keystroke at the toplevel so we get them whether
        # focus is on the (disabled) text widget or the root.
        self.root.bind("<Key>", self._on_key_press)
        # The text widget steals focus via mouse-click; redirect back to
        # the root after a focus-in so key bindings keep firing.
        self.text.bind("<FocusIn>", lambda _e: self.root.focus_set())
        self.root.focus_set()

        # Pointer events bind to the canvas — coords arrive in canvas
        # pixel space directly, no widget-translation math needed.
        for btn in (1, 2, 3):
            self.canvas.bind(f"<ButtonPress-{btn}>",
                             lambda e, b=btn: self._on_mouse_button(e, b, True))
            self.canvas.bind(f"<ButtonRelease-{btn}>",
                             lambda e, b=btn: self._on_mouse_button(e, b, False))
        self.canvas.bind("<Motion>", self._on_mouse_motion)

        self.root.protocol("WM_DELETE_WINDOW", self._on_close)
        self.root.after(POLL_INTERVAL_MS, self._poll)

    # ---- network -----------------------------------------------------------

    def _recv_exact(self, n: int) -> bytes:
        out = bytearray()
        while len(out) < n:
            chunk = self.sock.recv(n - len(out))
            if not chunk:
                raise SystemExit("oriscterm: crossbar closed during handshake")
            out.extend(chunk)
        return bytes(out)

    def send_packet(self, packet: bytes) -> None:
        # Manual sendall + select-based wait. The socket is non-blocking
        # so a raw sendall would raise BlockingIOError as soon as the
        # kernel send buffer fills up — which is what happens when a
        # CPU pours rapid 1-byte SENDs at us (cmd_cat of a moderate
        # file generates one console SEND per byte, each of which
        # makes us issue an OBJ_READ_REQ). When the buffer fills we
        # block on the socket becoming writable again, then continue.
        import select
        data = struct.pack(">I", len(packet)) + packet
        sent = 0
        while sent < len(data):
            try:
                n = self.sock.send(data[sent:])
                if n == 0:
                    self._log("send returned 0; peer closed")
                    self.connected = False
                    return
                sent += n
            except BlockingIOError:
                # Wait up to 5s for the socket to become writable.
                _, w, _ = select.select([], [self.sock], [], 5.0)
                if not w:
                    self._log("send blocked >5s; giving up")
                    self.connected = False
                    return
            except OSError as e:
                self._log(f"send failed: {e}")
                self.connected = False
                return

    # ---- Phase 47: directory self-registration ---------------------------

    def _send_inline_register(self, path: str, my_index: int,
                               caps: int = CAP_R | CAP_S) -> None:
        """Send a DIR_OP_REG_INLINE packet publishing a sub-cap of one
        of our service objects (CONSOLE_INDEX / KEYBOARD_INDEX /
        GRID_INDEX / FRAMEBUFFER_INDEX) at `path` in oriscdir.
        Fire-and-forget; failures only surface in oriscdir's log.
        See tools/devices/oriscdir's wire-protocol docstring for the
        packing layout.

        Service objects (idx 1..6) are SEND targets — published with
        R|S.  The framebuffer (idx 7) is a bytes object — published
        with R|W|V so clients can OBJ_READ/WRITE_REQ against it. """
        if self.dir_pid is None:
            return
        path_bytes = path.encode("utf-8")
        if not 0 < len(path_bytes) <= 32:
            self._log(f"register-self: path {path!r} length "
                      f"{len(path_bytes)} not in 1..32")
            return

        my_ref = make_ref(generation=SERVICE_GENERATION, home=self.my_pid,
                          index=my_index, caps=caps)
        dir_ref = make_ref(generation=SERVICE_GENERATION, home=self.dir_pid,
                           index=DIR_SERVICE_INDEX, caps=CAP_R | CAP_S)

        padded = path_bytes + b'\x00' * (32 - len(path_bytes))
        (b0_3,)   = struct.unpack("<I", padded[0:4])
        (b4_7,)   = struct.unpack("<I", padded[4:8])
        (b8_15,)  = struct.unpack("<Q", padded[8:16])
        (b16_23,) = struct.unpack("<Q", padded[16:24])
        (b24_31,) = struct.unpack("<Q", padded[24:32])

        int_payload = [OP_REG_INLINE, len(path_bytes), b0_3, b4_7]
        or_payload  = [my_ref, b8_15, b16_23, b24_31]

        trans = self.next_trans_id & 0xFFFF
        self.next_trans_id = (self.next_trans_id + 1) & 0xFFFF
        pkt = build_send_deliver(self.my_pid, self.dir_pid, trans,
                                 dir_ref, int_payload, or_payload)
        self.send_packet(pkt)
        self._log(f"register-self: {path!r} → my idx={my_index}")

    def _self_register_all(self) -> None:
        """Publish console / keyboard / grid / framebuffer sub-caps
        under /sys/term/<instance>/.  Called once at startup right
        after the Tk window comes up but before we enter the main
        loop."""
        if self.dir_pid is None:
            return
        base = f"/sys/term/{self.instance}"
        self._send_inline_register(f"{base}/console",     CONSOLE_INDEX)
        self._send_inline_register(f"{base}/keyboard",    KEYBOARD_INDEX)
        self._send_inline_register(f"{base}/grid",        GRID_INDEX)
        self._send_inline_register(f"{base}/framebuffer", FRAMEBUFFER_INDEX,
                                    caps=CAP_R | CAP_W | CAP_V)

    def _poll(self) -> None:
        # Drain bytes from socket.
        got_bytes = 0
        try:
            while True:
                chunk = self.sock.recv(65536)
                if not chunk:
                    self.connected = False
                    break
                self.recv_buf.extend(chunk)
                got_bytes += len(chunk)
        except (BlockingIOError, InterruptedError):
            pass
        except OSError:
            self.connected = False
        if got_bytes and self.verbose:
            self._log(f"poll: drained {got_bytes} bytes "
                      f"(buf now {len(self.recv_buf)})")

        # Frame and dispatch packets.
        while len(self.recv_buf) >= 4:
            (length,) = struct.unpack(">I", bytes(self.recv_buf[:4]))
            if len(self.recv_buf) < 4 + length:
                break
            packet = bytes(self.recv_buf[4:4 + length])
            del self.recv_buf[:4 + length]
            self._handle_packet(packet)

        # Phase 57: rebuild the framebuffer image once per poll if any
        # OBJ_WRITE_REQ has landed since the last paint.  Cheap when
        # idle (the dirty flag stays False); ~tens-of-ms of pure-Python
        # palette translation when an actual frame change happens.
        self._repaint_framebuffer()

        if self.connected:
            self.root.after(POLL_INTERVAL_MS, self._poll)
        else:
            self._append("\n[crossbar closed]\n")
            # Leave the window open briefly so the user can read the
            # final state, then quit.
            self.root.after(1500, self.root.destroy)

    def _handle_packet(self, packet: bytes) -> None:
        try:
            pkt = unpack_packet(packet)
        except ValueError as e:
            self._log(f"malformed packet: {e}")
            return
        t = pkt["type"]
        if t == PKT_SEND_DELIVER:
            self._handle_send_deliver(pkt)
        elif t == PKT_OBJ_READ_RESP:
            self._handle_read_resp(pkt)
        elif t == PKT_OBJ_READ_REQ:
            self._handle_obj_read_req(pkt)
        elif t == PKT_OBJ_WRITE_REQ:
            self._handle_obj_write_req(pkt)
        else:
            self._log(f"unhandled packet type 0x{t:02x}")

    # ---- framebuffer (idx 7) — OBJ_READ_REQ / OBJ_WRITE_REQ servicing -----

    def _handle_obj_read_req(self, pkt: Dict) -> None:
        """Service an incoming OBJ_READ_REQ targeting our framebuffer.
        Payload layout (Vol IV §4.1):
            words 0..1 = recipient ref (low-half-first 64-bit)
            word  2    = byte offset
            word  3    = byte width
        Reply with OBJ_READ_RESP carrying width bytes from the
        framebuffer at [offset, offset+width), or RESP_BOUNDS if the
        range is out of bounds.

        Reads on non-framebuffer indices are dropped with a log —
        nothing else oriscterm exposes is OBJ_READ-able today."""
        p = pkt["payload"]
        if len(p) < 4:
            self._log("OBJ_READ_REQ payload too short")
            return
        ref = p[0] | (p[1] << 32)
        offset = p[2]
        width = p[3]
        idx = ref_index(ref)
        if idx != FRAMEBUFFER_INDEX:
            self._log(f"OBJ_READ_REQ for non-framebuffer obj idx={idx} "
                      f"(only idx={FRAMEBUFFER_INDEX} supports OBJ_READ "
                      f"on oriscterm)")
            return
        fb_size = self.fb_w * self.fb_h
        if offset > fb_size or width > fb_size or offset + width > fb_size:
            resp = build_obj_read_resp(self.my_pid, pkt["src_pid"],
                                        pkt["trans_id"], RESP_BOUNDS, b'')
            self.send_packet(resp)
            return
        data = bytes(self.framebuffer[offset:offset + width])
        resp = build_obj_read_resp(self.my_pid, pkt["src_pid"],
                                    pkt["trans_id"], RESP_OK, data)
        self.send_packet(resp)

    def _handle_obj_write_req(self, pkt: Dict) -> None:
        """Service an incoming OBJ_WRITE_REQ targeting our framebuffer.
        Same payload-header layout as OBJ_READ_REQ, with the data
        bytes appended (padded to a 4-byte word boundary).  Reply
        with OBJ_WRITE_RESP carrying RESP_OK / RESP_BOUNDS.

        Marks the framebuffer dirty so the Tk poll's next pulse
        rebuilds the PhotoImage. """
        p = pkt["payload"]
        if len(p) < 4:
            self._log("OBJ_WRITE_REQ payload too short")
            return
        ref = p[0] | (p[1] << 32)
        offset = p[2]
        width = p[3]
        idx = ref_index(ref)
        if idx != FRAMEBUFFER_INDEX:
            self._log(f"OBJ_WRITE_REQ for non-framebuffer obj idx={idx}")
            return
        fb_size = self.fb_w * self.fb_h
        if offset > fb_size or width > fb_size or offset + width > fb_size:
            resp = build_obj_write_resp(self.my_pid, pkt["src_pid"],
                                         pkt["trans_id"], RESP_BOUNDS)
            self.send_packet(resp)
            return
        # Decode the data words (after the 4-word header) into bytes,
        # truncate to `width` (the trailing padding is harmless).
        data_words = p[4:]
        data = b''.join(struct.pack(">I", w & 0xFFFFFFFF) for w in data_words)
        data = data[:width]
        self.framebuffer[offset:offset + width] = data
        self.framebuffer_dirty = True
        resp = build_obj_write_resp(self.my_pid, pkt["src_pid"],
                                     pkt["trans_id"], RESP_OK)
        self.send_packet(resp)

    def _repaint_framebuffer(self) -> None:
        """Rebuild the FB-window PhotoImage from self.framebuffer if
        dirty.  Translate 1-byte indexed pixels through the palette
        to RGB and emit a 1:1 PPM-P6 byte stream — the framebuffer
        is the on-the-wire resolution and the FB Toplevel canvas is
        the same size, so no scaling is needed here.

        Pure-Python loop; at 1280×768 that's ~983K iterations on
        every dirty repaint.  Fine for the kind of low-frequency
        updates the WM's glyph renderer produces.  PIL/numpy is the
        follow-up if anyone animates against the framebuffer."""
        if not self.framebuffer_dirty:
            return
        W, H = self.fb_w, self.fb_h
        pal = self.fb_palette_rgb
        fb  = self.framebuffer
        rgb = bytearray(W * H * 3)
        for i in range(W * H):
            base = fb[i] * 3
            j = i * 3
            rgb[j]     = pal[base]
            rgb[j + 1] = pal[base + 1]
            rgb[j + 2] = pal[base + 2]
        ppm = (b"P6\n" + str(W).encode() + b" "
               + str(H).encode() + b"\n255\n" + bytes(rgb))
        try:
            self.fb_window_image.configure(data=ppm)
        except tk.TclError as e:
            self._log(f"framebuffer repaint failed: {e}")
        self.framebuffer_dirty = False

    def _handle_send_deliver(self, pkt: Dict) -> None:
        try:
            recipient_ref, int_payload, or_payload = parse_send_deliver(pkt)
        except ValueError as e:
            self._log(f"bad SEND_DELIVER: {e}")
            return
        target = ref_index(recipient_ref)
        if target == CONSOLE_INDEX:
            self._handle_console_send(int_payload, or_payload)
        elif target == KEYBOARD_INDEX:
            self._handle_keyboard_send(int_payload, or_payload)
        elif target == GRID_INDEX:
            self._handle_grid_send(int_payload, or_payload)
        elif target == VECTOR_INDEX:
            self._handle_vector_send(int_payload, or_payload)
        elif target == POINTER_INDEX:
            self._handle_pointer_send(int_payload, or_payload)
        elif target == RASTER_INDEX:
            self._log(f"SEND to raster service (idx {RASTER_INDEX}) — "
                      f"protocol pinned but implementation not yet landed")
        else:
            self._log(f"SEND to unknown obj idx={target}")

    # ---- console (idx 1) — text output -------------------------------------

    def _handle_console_send(self, int_payload, or_payload) -> None:
        # Wire OR slot 0 is the sender's O1, which is by SEND convention
        # the recipient itself (= our console, irrelevant here). The
        # actual data ref is at slot 1 (sender's O2), and an optional
        # reply capability at slot 2 (sender's O3).
        source_ref = or_payload[1]
        reply_cap  = or_payload[2]
        offset = int_payload[0]
        length = int_payload[1]
        if source_ref == 0 or length == 0:
            return
        src_pid = ref_home(source_ref)
        trans = self.next_trans_id & 0xFFFF
        self.next_trans_id = (self.next_trans_id + 1) & 0xFFFF
        self.pending_reads[trans] = {"action": "console", "len": length,
                                     "reply_cap": reply_cap}
        req = build_obj_read_req(self.my_pid, src_pid, trans,
                                 source_ref, offset, length)
        self.send_packet(req)

    # ---- grid (idx 3) — positioned text on the canvas ---------------------

    def _handle_grid_send(self, int_payload, or_payload) -> None:
        """SEND payload convention for the grid service:
            O2 = byte source (any byte-typed object the terminal can OL)
            R4 = byte offset into the source
            R5 = byte length
            R6 = grid column (cell x)
            R7 = grid row    (cell y)
        The terminal pulls the bytes via OBJ_READ_REQ (same dance as
        the console service) and renders them on the Canvas at the
        given character-cell position.

        Special case: a SEND with col == 0xFFFFFFFF and row ==
        0xFFFFFFFF (i.e. signed -1, -1) clears the entire canvas.
        Lets a single grid-service slot do both jobs without the
        caller having to hold a separate vector-service ref. The
        sender's O2 / offset / length are ignored on a clear.
        """
        source_ref = or_payload[1]
        offset = int_payload[0]
        length = int_payload[1]
        col    = int_payload[2]
        row    = int_payload[3]
        if col == 0xFFFFFFFF and row == 0xFFFFFFFF:
            self.canvas.delete("all")
            self.grid_items.clear()
            return
        if source_ref == 0 or length == 0:
            return
        src_pid = ref_home(source_ref)
        trans = self.next_trans_id & 0xFFFF
        self.next_trans_id = (self.next_trans_id + 1) & 0xFFFF
        # Stash the (col, row) so the read-resp handler knows where to
        # drop the rendered text.
        self.pending_reads[trans] = {"action": "grid", "len": length,
                                     "col": col, "row": row}
        req = build_obj_read_req(self.my_pid, src_pid, trans,
                                 source_ref, offset, length)
        self.send_packet(req)

    # ---- vector (idx 4) — immediate drawing primitives --------------------

    def _handle_vector_send(self, int_payload, or_payload) -> None:
        """SEND payload convention for the vector service:
            R4 = command code (VEC_*)
            R5..R7 = command-specific arguments (see below)

        Two-coordinate ops pack (x, y) into a single 32-bit word as
        (x << 16) | y; sizes pack the same way as (w << 16) | h.

            VEC_LINE          R5=(x1<<16)|y1, R6=(x2<<16)|y2
            VEC_RECT_FILL     R5=(x<<16)|y,   R6=(w<<16)|h
            VEC_RECT_OUTLINE  R5=(x<<16)|y,   R6=(w<<16)|h
            VEC_OVAL_FILL     R5=(x<<16)|y,   R6=(w<<16)|h
            VEC_OVAL_OUTLINE  R5=(x<<16)|y,   R6=(w<<16)|h
            VEC_CLEAR         (no args)
            VEC_SET_COLOR     R5 = palette index (0..8)
        """
        cmd = int_payload[0]
        a   = int_payload[1]
        b   = int_payload[2]
        # int_payload[3] (R7) currently unused; reserved.

        def unpack_pair(w):
            # 16-bit signed halves so negative coords work too.
            hi = (w >> 16) & 0xFFFF
            lo = w & 0xFFFF
            if hi >= 0x8000: hi -= 0x10000
            if lo >= 0x8000: lo -= 0x10000
            return hi, lo

        if cmd == VEC_CLEAR:
            self.canvas.delete("all")
            self.grid_items.clear()
            return

        if cmd == VEC_SET_COLOR:
            idx = a & 0xFF
            self.vec_color = VEC_PALETTE.get(idx, VEC_PALETTE[1])
            return

        if cmd == VEC_LINE:
            x1, y1 = unpack_pair(a)
            x2, y2 = unpack_pair(b)
            self.canvas.create_line(x1, y1, x2, y2,
                                    fill=self.vec_color, width=1)
            return

        if cmd in (VEC_RECT_FILL, VEC_RECT_OUTLINE,
                   VEC_OVAL_FILL, VEC_OVAL_OUTLINE):
            x, y = unpack_pair(a)
            w, h = unpack_pair(b)
            x2, y2 = x + w, y + h
            fill = self.vec_color if cmd in (VEC_RECT_FILL, VEC_OVAL_FILL) else ""
            outline = self.vec_color
            if cmd in (VEC_RECT_FILL, VEC_RECT_OUTLINE):
                self.canvas.create_rectangle(x, y, x2, y2,
                                             fill=fill, outline=outline)
            else:
                self.canvas.create_oval(x, y, x2, y2,
                                        fill=fill, outline=outline)
            return

        self._log(f"vector: unknown command 0x{cmd:02x}")

    # ---- pointer (idx 6) — subscribe / unsubscribe ------------------------

    def _handle_pointer_send(self, int_payload, or_payload) -> None:
        """SEND payload convention for the pointer service:
            O2 = subscriber's reply ref (terminal SENDs each pointer
                 event to this ref). Null O2 unsubscribes everyone
                 (same coarse v1 behaviour as keyboard).
        """
        sub_ref = or_payload[1]
        if sub_ref == 0:
            n = len(self.ptr_subscribers)
            self.ptr_subscribers.clear()
            self._log(f"pointer: unsubscribed {n} subscriber(s)")
            return
        if sub_ref in self.ptr_subscribers:
            self._log(f"pointer: subscriber 0x{sub_ref:016x} already known")
            return
        self.ptr_subscribers.append(sub_ref)
        self._log(f"pointer: subscribed 0x{sub_ref:016x} "
                  f"(now {len(self.ptr_subscribers)} subscriber(s))")

    # ---- keyboard (idx 2) — subscribe / unsubscribe ------------------------

    def _handle_keyboard_send(self, int_payload, or_payload) -> None:
        """SEND payload convention for the keyboard service:
            R4 = 0  → subscribe (default)
                 1  → unsubscribe by sub-ref (matches O2 against the
                      list, removes the one matching entry; quietly
                      ignored if no match — supports programs that
                      double-call term_shutdown).
            O2 = subscriber's reply ref:
                 - On subscribe: the ref the terminal will SEND key
                   events to.
                 - On unsubscribe (R4=1): the same sub-cap that was
                   originally registered. The libc derives both via
                   ObjDerive(O9, R|S), and the sim's ObjDerive is
                   deterministic over (gen, home, idx, caps), so the
                   two refs are bit-identical.
                 - On subscribe with O2=null: legacy "unsubscribe-all"
                   path (a coarse v1 convenience; targeted unsubs
                   below are the cleaner option). Kept so existing
                   callers don't break.
        """
        cmd = int_payload[0] & 0xFFFFFFFF
        sub_ref = or_payload[1]   # sender's O2 → wire slot 1 → handler O3
        if cmd == 1 and sub_ref:
            # Targeted unsubscribe.
            try:
                idx_in_list = self.kbd_subscribers.index(sub_ref)
            except ValueError:
                self._log(f"keyboard: unsubscribe for unknown "
                          f"0x{sub_ref:016x} (no-op)")
                return
            self.kbd_subscribers.pop(idx_in_list)
            # If the focus pointer was on this entry or past it, fix
            # it up so the next F1 cycle still lands somewhere sane.
            if self.kbd_focus_idx >= len(self.kbd_subscribers):
                self.kbd_focus_idx = 0
            self._update_title()
            self._log(f"keyboard: unsubscribed 0x{sub_ref:016x} "
                      f"(now {len(self.kbd_subscribers)} subscriber(s))")
            return
        if sub_ref == 0:
            # Legacy unsubscribe-all. Single null SEND clears everyone.
            n = len(self.kbd_subscribers)
            self.kbd_subscribers.clear()
            self.kbd_focus_idx = 0
            self._update_title()
            self._log(f"keyboard: unsubscribed {n} subscriber(s) (all)")
            return
        if sub_ref in self.kbd_subscribers:
            self._log(f"keyboard: subscriber 0x{sub_ref:016x} already known")
            return
        self.kbd_subscribers.append(sub_ref)
        self._update_title()
        self._log(f"keyboard: subscribed 0x{sub_ref:016x} "
                  f"(now {len(self.kbd_subscribers)} subscriber(s))")

    def _handle_read_resp(self, pkt: Dict) -> None:
        trans = pkt["trans_id"]
        info = self.pending_reads.pop(trans, None)
        if info is None:
            self._log(f"unexpected OBJ_READ_RESP trans={trans}")
            return
        flags = pkt["flags"] & 0x3F
        text = ""
        if flags != 0:
            self._append(f"[read failed: flags=0x{flags:02x}]")
        else:
            words = pkt["payload"]
            raw = b''.join(struct.pack(">I", w & 0xFFFFFFFF) for w in words)
            text = raw[:info["len"]].decode("utf-8", errors="replace")

        if info["action"] == "console" and flags == 0:
            self._append(text)
        elif info["action"] == "grid" and flags == 0:
            base_col = info["col"]
            row      = info["row"]
            # One Canvas item per character cell. Anchor "nw" puts the
            # top-left of the glyph at (col*cw, row*ch). For each cell
            # we touch, delete any existing item at that (col, row)
            # first so we get clean replace semantics — the editor
            # repaints constantly and would otherwise stack glyphs.
            for i, ch in enumerate(text):
                col = base_col + i
                key = (col, row)
                old = self.grid_items.pop(key, None)
                if old is not None:
                    self.canvas.delete(old)
                if ch == ' ':
                    # Painting a space is "clear this cell" — the old
                    # item is already gone, no need to add a no-op.
                    continue
                x = col * self.cell_w
                y = row * self.cell_h
                item = self.canvas.create_text(x, y, text=ch, anchor="nw",
                                               fill=self.vec_color,
                                               font=self.canvas_font)
                self.grid_items[key] = item

        # If the console request carried a reply capability, send a
        # header-only ack SEND_DELIVER through it so the sender can
        # unblock from a poll on its reply queue and exit cleanly.
        reply_cap = info.get("reply_cap", 0)
        if reply_cap != 0:
            ack_trans = self.next_trans_id & 0xFFFF
            self.next_trans_id = (self.next_trans_id + 1) & 0xFFFF
            ack = self._build_ack(reply_cap, ack_trans)
            self.send_packet(ack)

    def _build_ack(self, recipient_ref: int, trans_id: int) -> bytes:
        """Build a SEND_DELIVER packet with empty payload aimed at
        `recipient_ref`. Reuses the same wire builder simorisc uses on
        the SEND instruction."""
        payload = []
        payload.append(recipient_ref & 0xFFFFFFFF)
        payload.append((recipient_ref >> 32) & 0xFFFFFFFF)
        payload.extend([0, 0, 0, 0])      # int payload
        for _ in range(4):                 # OR payload (all null)
            payload.append(0); payload.append(0)
        dst = ref_home(recipient_ref)
        return pack_packet(self.my_pid, dst, PKT_SEND_DELIVER, 0,
                           trans_id, payload)

    # ---- keyboard event dispatch ------------------------------------------

    # Tk keysym → our portable keycode (≥ 0x100 means "special key";
    # printable characters use their plain byte value via event.char).
    _KEYSYM_TO_CODE = {
        "BackSpace": KEY_BACKSPACE,
        "Tab":       KEY_TAB,
        "Return":    KEY_RETURN,
        "Escape":    KEY_ESCAPE,
        "Delete":    KEY_DELETE,
        "Up":        KEY_UP,
        "Down":      KEY_DOWN,
        "Left":      KEY_LEFT,
        "Right":     KEY_RIGHT,
        "Home":      KEY_HOME,
        "End":       KEY_END,
        "Prior":     KEY_PAGE_UP,    # Tk's name for Page Up
        "Next":      KEY_PAGE_DOWN,  # Tk's name for Page Down
        **{f"F{i}": KEY_F1 + (i - 1) for i in range(1, 13)},
    }

    def _send_key_to(self, sub_ref: int, code: int, mods: int) -> None:
        """SEND a single key event to the named subscriber. Factored
        out of _on_key_press so F1's focus-cycle path can also fire a
        synthetic KEY_FOCUS_IN to the newly-focused subscriber."""
        trans = self.next_trans_id & 0xFFFF
        self.next_trans_id = (self.next_trans_id + 1) & 0xFFFF
        evt_pkt = build_send_deliver(
            src_pid=self.my_pid,
            dst_pid=ref_home(sub_ref),
            trans_id=trans,
            recipient_ref=sub_ref,
            int_payload=[code, mods, 0, 0],
            or_payload=[sub_ref, 0, 0, 0],
        )
        self.send_packet(evt_pkt)

    def _on_key_press(self, event) -> None:
        # F1 is the focus-cycle hotkey: never delivered, always
        # consumed by the terminal. Cycles which subscriber receives
        # subsequent keys. After cycling we send a synthetic
        # KEY_FOCUS_IN to the newly-focused subscriber so it can
        # repaint immediately (most programs render at the top of
        # their main loop, blocking in term_getkey while unfocused
        # — without the synthetic event they'd hold their last frame
        # until the user typed something real).
        if event.keysym == "F1":
            n = len(self.kbd_subscribers)
            if n > 1:
                self.kbd_focus_idx = (self.kbd_focus_idx + 1) % n
                self._update_title()
                self._send_key_to(self.kbd_subscribers[self.kbd_focus_idx],
                                  KEY_FOCUS_IN, 0)
            return
        if not self.kbd_subscribers:
            return  # nobody listening; drop
        code = self._codepoint_from_event(event)
        if code is None:
            return  # uninteresting key (modifier-only, etc.)
        mods = self._modifiers_from_event(event)
        # Route to the focused subscriber only. With one subscriber
        # (the common case), kbd_focus_idx == 0 and behaviour is
        # identical to the pre-multi-sub world.
        idx = self.kbd_focus_idx
        if idx >= len(self.kbd_subscribers):
            idx = 0
        self._send_key_to(self.kbd_subscribers[idx], code, mods)

    def _update_title(self) -> None:
        """Reflect the current focus + subscriber count in the window
        title. Helps a user notice the F1 toggle landed."""
        n = len(self.kbd_subscribers)
        if n <= 1:
            self.root.title(f"Object RISC Terminal · pid={self.my_pid}")
        else:
            self.root.title(
                f"Object RISC Terminal · pid={self.my_pid} · "
                f"kbd focus {self.kbd_focus_idx + 1}/{n} (F1 to cycle)")

    def _codepoint_from_event(self, event) -> Optional[int]:
        # Tk fills `keysym` for every key and `char` for printable ones.
        # If keysym names a special key we know about, prefer that; else
        # fall back to the printable char's first byte.
        sym = event.keysym
        if sym in self._KEYSYM_TO_CODE:
            return self._KEYSYM_TO_CODE[sym]
        ch = event.char
        # Synthesize C0 control chars for Ctrl+letter on platforms where
        # Tk leaves event.char empty (notably macOS/Aqua). Without this
        # the editor never sees ^S / ^X / etc. — the keystroke gets
        # dropped right here. We map the alphabetic keysym + the Ctrl
        # modifier bit into the 0x01..0x1A range the editor expects.
        if (event.state & 0x4) and len(sym) == 1 and sym.isalpha():
            return ord(sym.lower()) & 0x1F
        if ch and len(ch) >= 1:
            b = ch.encode('utf-8', errors='ignore')
            if not b:
                return None
            # Single ASCII byte gets passed through as-is; multibyte
            # characters use the Unicode codepoint above 0x80 (still
            # below 0x100, where our special-key range starts).
            return b[0] if len(b) == 1 else ord(ch)
        return None  # bare modifier press, etc.

    def _modifiers_from_event(self, event) -> int:
        # Tk's event.state is platform-dependent; the documented bits
        # below are stable on the platforms we care about. This is a
        # best-effort decoder — clients that want wire-perfect modifier
        # info should rely on the codepoint primarily.
        s = event.state
        mods = 0
        if s & 0x1:        mods |= MOD_SHIFT
        if s & 0x4:        mods |= MOD_CTRL
        # Alt: bit 0x8 (X11) or 0x10 (mac Option/Alt depending on Tk version)
        if s & 0x8 or s & 0x10:
            mods |= MOD_ALT
        # Meta/Command on macOS shows up as 0x40000 (Tk 8.6) or 0x8 in
        # some builds; we accept the common one.
        if s & 0x40000:    mods |= MOD_META
        return mods

    # ---- pointer event dispatch -------------------------------------------

    def _on_mouse_motion(self, event) -> None:
        if not self.ptr_subscribers:
            return
        self._dispatch_pointer_event(PTR_MOTION, event.x, event.y, 0)

    def _on_mouse_button(self, event, button: int, down: bool) -> None:
        # Update internal button-state mask first so the event we send
        # reflects the post-event state (consistent with keyboard
        # modifier reporting).
        bit = 1 << button
        if down:
            self.ptr_button_state |= bit
            evt_type = PTR_DOWN
        else:
            self.ptr_button_state &= ~bit
            evt_type = PTR_UP
        if not self.ptr_subscribers:
            return
        self._dispatch_pointer_event(evt_type, event.x, event.y, button)

    def _dispatch_pointer_event(self, evt_type: int, x: int, y: int,
                                 button: int) -> None:
        # Clamp to canvas bounds and a 16-bit unsigned range so the
        # packed (x<<16)|y word stays well-formed even if Tk reports
        # an event outside the canvas (which it occasionally does
        # during a drag that escapes the widget).
        if x < 0: x = 0
        if y < 0: y = 0
        if x > 0xFFFF: x = 0xFFFF
        if y > 0xFFFF: y = 0xFFFF
        packed_xy = ((x & 0xFFFF) << 16) | (y & 0xFFFF)
        for sub_ref in list(self.ptr_subscribers):
            trans = self.next_trans_id & 0xFFFF
            self.next_trans_id = (self.next_trans_id + 1) & 0xFFFF
            evt_pkt = build_send_deliver(
                src_pid=self.my_pid,
                dst_pid=ref_home(sub_ref),
                trans_id=trans,
                recipient_ref=sub_ref,
                int_payload=[evt_type, packed_xy, button,
                             self.ptr_button_state],
                or_payload=[sub_ref, 0, 0, 0],
            )
            self.send_packet(evt_pkt)

    # ---- UI helpers --------------------------------------------------------

    def _append(self, s: str) -> None:
        """Insert s at end of the text widget, with terminal-style
        processing of two control bytes:
          - `\\b` (0x08) deletes the character immediately before it;
            the shell's read_line uses this for backspace-to-erase.
          - `\\f` (0x0C, form feed, Phase 48) clears the entire text
            pane. login.orx fires one before each welcome banner so
            the new session starts on a blank canvas. (Mirrors the
            grid pane's existing VEC_CLEAR / col=row=-1 semantics.)
        Other bytes are inserted verbatim."""
        self.text.configure(state="normal")
        i = 0
        while i < len(s):
            if s[i] == '\b':
                # "end-1c" is the trailing implicit newline; "end-2c"
                # is the last visible character. Delete that char if
                # any character precedes the implicit newline.
                if self.text.index("end-2c") != self.text.index("1.0"):
                    self.text.delete("end-2c", "end-1c")
                i += 1
            elif s[i] == '\f':
                # Form feed → clear the text pane entirely.
                self.text.delete("1.0", "end")
                i += 1
            else:
                seg_start = i
                while i < len(s) and s[i] != '\b' and s[i] != '\f':
                    i += 1
                self.text.insert("end", s[seg_start:i])
        self.text.see("end")
        self.text.configure(state="disabled")
        # Also surface rendered text on stderr so the launcher / tests
        # can verify the demo without screen-capture access — but only
        # when verbose is on, since the shell drives many of these per
        # second and the launcher's combined log gets noisy fast.
        if self.verbose:
            sys.stderr.write(f"RENDER: {s!r}\n")
            sys.stderr.flush()

    def _log(self, msg: str) -> None:
        if self.verbose:
            print(f"oriscterm: {msg}", file=sys.stderr)

    def _on_close(self) -> None:
        try:
            self.sock.close()
        except OSError:
            pass
        self.root.destroy()


def main(argv) -> int:
    ap = argparse.ArgumentParser(prog="oriscterm",
        description="Object RISC graphics terminal device")
    ap.add_argument("--socket", required=True,
                    help="path to oriscbar's UNIX domain socket")
    ap.add_argument("--pid", type=int, required=True,
                    help="processor identifier this terminal presents to "
                         "the crossbar (typically 16+ to avoid clashing "
                         "with CPU pids)")
    ap.add_argument("--directory-pid", type=int, default=None,
                    help="oriscdir's pid; if set, this terminal will "
                         "self-register its console/keyboard/grid "
                         "service objects at "
                         "/sys/term/<instance>/{console,keyboard,grid} "
                         "via the inline-register wire op (Phase 47)")
    ap.add_argument("--instance", type=int, default=0,
                    help="terminal instance number for the directory "
                         "path; defaults to 0. Two terminals on the "
                         "same crossbar should use distinct instance "
                         "numbers so their /sys/term/N/ subtrees don't "
                         "collide. Only consulted when "
                         "--directory-pid is set.")
    ap.add_argument("-v", "--verbose", action="store_true")
    args = ap.parse_args(argv)

    term = Terminal(args.socket, args.pid, verbose=args.verbose,
                    dir_pid=args.directory_pid, instance=args.instance)
    print(f"oriscterm READY pid={args.pid}", flush=True)
    # Phase 47: announce ourselves to the directory before entering
    # the Tk mainloop. The mainloop replaces the script's main thread
    # so anything beyond this point is event-driven, but the inline
    # register op is fire-and-forget so we don't need a response.
    term._self_register_all()
    term.root.mainloop()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
