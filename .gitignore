# macOS Finder metadata
.DS_Store

# Python bytecode
__pycache__/
*.pyc

# Local Claude Code session state
.claude/

# Combined markdown is regenerated by docs/build_pdf.py from the volume sources
docs/OBJECT_RISC.md

# Preview's auto-created copy when opening a PDF
docs/ObjectRISC copy.pdf

# LaTeX build by-products (under docs/)
docs/*.aux
docs/*.log
docs/*.toc
docs/*.out

# Top-level build tree (created by `make`); also catches the validation
# suite's --build-dir scratch when someone overrides its default.
build/

# Symlink scripts/boot.sh creates so the hostfsd jail can resolve
# /programs to build/programs. Reused across boots; cleaned up
# automatically when the layout changes (boot.sh re-creates it).
/programs

# autoconf cache (regenerated on `autoconf`)
tools/cc/autom4te.cache/

# Stale build artifacts in the old layout — pre-reorg local checkouts
# may still have these; they're now produced under build/programs/.
examples/cc/programs/*.orx
ouroboros/programs/*.orx
tools/cc/lib/*.oro
tools/cc/lib/*.ora
