# macOS Finder metadata
.DS_Store

# Python bytecode
__pycache__/
*.pyc

# Local Claude Code session state
.claude/

# Combined markdown is regenerated by build_pdf.py from the volume sources
OBJECT_RISC.md

# Preview's auto-created copy when opening a PDF
ObjectRISC copy.pdf

# LaTeX build by-products
*.aux
*.log
*.toc
*.out

# Validation suite scratch builds (default --build-dir lives in /tmp anyway,
# but if someone overrides it they probably don't want it tracked)
build/

# autoconf cache (regenerated on `autoconf`)
tools/cc/autom4te.cache/

# Sample-program builds (run_shell.sh rebuilds on demand)
examples/cc/programs/*.orx
